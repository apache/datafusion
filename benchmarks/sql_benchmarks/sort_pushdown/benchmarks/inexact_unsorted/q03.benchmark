template sql_benchmarks/sort_pushdown/sort_pushdown.benchmark.template
QPAD=03
VARIANT=inexact_unsorted
DATASET=sort_pushdown_inexact
SETTINGS=inexact
ORDERING=unordered

run
-- Unsupported path: wide projection + ASC LIMIT.
-- Shows row-level filter benefit when RG reorder tightens TopK threshold.
SELECT *
FROM lineitem
ORDER BY l_orderkey
LIMIT 100
