name Q11
group asof_join

expect_plan AsOfJoinExec

run
-- Left: 1M rows; right: 20M rows; 10K balanced equality groups; integer payloads.
-- Both sides cover the same time range and the right input is unfiltered, so the
-- whole right input is collected and scanned by every left partition.
-- Inputs are not ordered by (key, ts), so required ordering is included.
WITH left_input AS (
    SELECT value % 10000 AS key,
           (value / 10000) * 20 + 1 AS ts,
           value AS payload
    FROM range(1000000)
),
right_input AS (
    SELECT value % 10000 AS key,
           value / 10000 AS ts,
           value AS payload
    FROM range(20000000)
)
SELECT l.key, l.ts, l.payload, r.payload AS right_payload
FROM left_input l
ASOF JOIN right_input r MATCH_CONDITION (l.ts >= r.ts)
ON l.key = r.key;
