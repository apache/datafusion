name Q12
group null_aware_join

load sql_benchmarks/null_aware_join/init/load.sql

# Correctness canary: the NOT IN result must match a reference count that does
# not use NOT IN. It holds for every NAJ_ROWS. The subquery holds no NULL, so a
# subquery row makes an outer tuple UNKNOWN or TRUE exactly when `z` matches and
# the outer `id_n1` is NULL or equal; the row is kept only when no such
# subquery row exists.
assert I
SELECT count(*) = (
  SELECT count(*)
  FROM small_outer o
  WHERE NOT EXISTS (
    SELECT 1 FROM small_inner i
    WHERE i.z = o.z AND (o.id_n1 IS NULL OR i.id_n0 = o.id_n1)
  )
)
FROM small_outer o
WHERE (o.id_n1, o.z) NOT IN (SELECT i.id_n0, i.z FROM small_inner i);
----
true

expect_plan HashJoinExec

run
-- Q12: uncorrelated multi-column NOT IN with 1% NULL in one outer element,
-- the mirror of Q11. The outer side is the build side, so each NULL-valued
-- build row is paired with every subquery row and kept as UNKNOWN only when
-- the other element matches: the cost grows with (NULL-valued outer rows) x
-- (subquery rows). Compare with Q10 and Q11.
SELECT count(*)
FROM small_outer o
WHERE (o.id_n1, o.z) NOT IN (SELECT i.id_n0, i.z FROM small_inner i);

cleanup sql_benchmarks/null_aware_join/init/cleanup.sql
