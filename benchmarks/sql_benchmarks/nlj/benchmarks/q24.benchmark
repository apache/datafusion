name Q24
group nlj

expect_plan NestedLoopJoinExec
expect_plan join_type=LeftSemi

run
-- Q24: LEFT SEMI 4K x 4K | no matches; every left row probes all right rows.
-- The maximum sum is 4096 * 4096 - 1, so matched-row skipping cannot help.
SELECT l.value
FROM range(4096) AS l
LEFT SEMI JOIN range(4096) AS r
ON l.value * 4096 + r.value >= 4096 * 4096;
