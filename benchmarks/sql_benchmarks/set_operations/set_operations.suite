description = "INTERSECT ALL and EXCEPT ALL across distinct, duplicate-heavy, and single-key inputs, with DISTINCT controls"

[[options]]
name = "rows"
env = "SET_ROWS"
default = "1000000"
help = "Left input row count (positive integer); duplicate and skew cases use half as many right rows."

[[examples]]
command = "cargo run --release --bin benchmark_runner -- set_operations --criterion --partitions 4"
description = "Run all set-operation cases with Criterion."

[[examples]]
command = "cargo run --release --bin benchmark_runner -- set_operations --subgroup skew --rows 10000000 --criterion --memory-limit 2G"
description = "Stress large per-key expansion and record memory-pool peaks."
