# 1,000 keys; right multiplicities do not exceed left multiplicities.
subgroup duplicates

template sql_benchmarks/set_operations/set_operations.benchmark.template
QPAD=03
OP=INTERSECT ALL
LEFT_KEY=value % 1000
RIGHT_KEY=value % 1000
RIGHT_ROWS=(${SET_ROWS:-1000000} / 2)
EXPECTED_ROWS=(${SET_ROWS:-1000000} / 2)

