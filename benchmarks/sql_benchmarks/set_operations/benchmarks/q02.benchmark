# Equal input sizes; unique keys, half overlap.
subgroup distinct

template sql_benchmarks/set_operations/set_operations.benchmark.template
QPAD=02
OP=EXCEPT ALL
LEFT_KEY=value
RIGHT_KEY=value + (${SET_ROWS:-1000000} / 2)
RIGHT_ROWS=${SET_ROWS:-1000000}
EXPECTED_ROWS=(${SET_ROWS:-1000000} / 2)

