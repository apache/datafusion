# Input generation and the independent cardinality check are outside timing.
# Keep the full set operation beneath count(*), exercising expansion without
# retaining a large result in the benchmark driver.
name Q${QPAD}
group set_operations

load sql_benchmarks/set_operations/init/load.sql

assert I
SELECT ${SET_ROWS:-1000000} > 0;
----
true

assert I
SELECT count(*) = (${EXPECTED_ROWS})
FROM (SELECT key, payload FROM set_left ${OP} SELECT key, payload FROM set_right) t;
----
true

run
SELECT count(*)
FROM (SELECT key, payload FROM set_left ${OP} SELECT key, payload FROM set_right) t;

cleanup sql_benchmarks/set_operations/init/cleanup.sql

