# Shared template for the parquet_row_filter_skip suite. Each qNN.benchmark sets
# its `subgroup` directive and includes this template with parameters:
#   SUBGROUP  subgroup name, also the query sub-directory   (e.g. skip)
#   QPAD      zero-padded query id / query file stem        (e.g. 01)
#   DATASET   load script stem under load/                  (e.g. clustered)
#   NAME      criterion display name
# Optional (consumed by the load script via ${...:-default}):
#   PRED_ROWS  synthetic row count       (default 10_000_000)
#   RG_SIZE    parquet max row-group size (default 1_000_000)
#
# The load script enables `pushdown_filters` and COPYs a clustered Parquet file
# so the fully-matched RowFilter-skip path is exercised. The table is always
# named `t`, so the assert and cleanup are uniform.

load sql_benchmarks/parquet_row_filter_skip/load/${DATASET}.sql

name ${NAME}
group parquet_row_filter_skip

assert I
SELECT count(*) > 0 FROM t;
----
true

run sql_benchmarks/parquet_row_filter_skip/queries/${SUBGROUP}/q${QPAD}.sql

cleanup sql_benchmarks/parquet_row_filter_skip/init/cleanup.sql
