name Q10
group grouped_count_distinct

load sql_benchmarks/grouped_count_distinct/init/load.sql

assert I
WITH actual AS (
  SELECT many_g AS g, count(DISTINCT dup_x) AS n FROM grouped_distinct GROUP BY many_g
), expected AS (
  SELECT g, count(x) AS n
  FROM (SELECT DISTINCT many_g AS g, dup_x AS x FROM grouped_distinct)
  GROUP BY g
)
SELECT NOT EXISTS (SELECT * FROM actual EXCEPT SELECT * FROM expected)
   AND NOT EXISTS (SELECT * FROM expected EXCEPT SELECT * FROM actual);
----
true

expect_plan AggregateExec

run
-- Int64, 1M groups with four identical values per group at the default 4M rows.
-- Repeated singleton values exercise the native accumulator's inline first value.
SELECT many_g, count(DISTINCT dup_x) FROM grouped_distinct GROUP BY many_g;

cleanup sql_benchmarks/grouped_count_distinct/init/cleanup.sql
