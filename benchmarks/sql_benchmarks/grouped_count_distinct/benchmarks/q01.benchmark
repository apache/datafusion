name Q01
group grouped_count_distinct

load sql_benchmarks/grouped_count_distinct/init/load.sql

assert I
WITH actual AS (
  SELECT g AS g, count(DISTINCT x) AS n FROM grouped_distinct GROUP BY g
), expected AS (
  SELECT g, count(x) AS n
  FROM (SELECT DISTINCT g AS g, x AS x FROM grouped_distinct)
  GROUP BY g
)
SELECT NOT EXISTS (SELECT * FROM actual EXCEPT SELECT * FROM expected)
   AND NOT EXISTS (SELECT * FROM expected EXCEPT SELECT * FROM actual);
----
true

expect_plan AggregateExec

run
-- Int64, 2,000 groups, high distinct cardinality (issue #25936).
SELECT g, count(DISTINCT x) FROM grouped_distinct GROUP BY g;

cleanup sql_benchmarks/grouped_count_distinct/init/cleanup.sql
