name Q12
group grouped_count_distinct

load sql_benchmarks/grouped_count_distinct/init/load.sql

assert I
WITH actual AS (
  SELECT many_g AS g, count(DISTINCT CASE WHEN many_g % 20 < 19 THEN NULL ELSE dup_x END) AS n
  FROM grouped_distinct GROUP BY many_g
), expected AS (
  SELECT g, count(x) AS n
  FROM (SELECT DISTINCT many_g AS g, CASE WHEN many_g % 20 < 19 THEN NULL ELSE dup_x END AS x FROM grouped_distinct)
  GROUP BY g
)
SELECT NOT EXISTS (SELECT * FROM actual EXCEPT SELECT * FROM expected)
   AND NOT EXISTS (SELECT * FROM expected EXCEPT SELECT * FROM actual);
----
true

expect_plan AggregateExec

run
-- Int64, 1M groups; 95% of groups contain only NULL arguments at 4M rows.
SELECT many_g, count(DISTINCT CASE WHEN many_g % 20 < 19 THEN NULL ELSE dup_x END)
FROM grouped_distinct GROUP BY many_g;

cleanup sql_benchmarks/grouped_count_distinct/init/cleanup.sql
