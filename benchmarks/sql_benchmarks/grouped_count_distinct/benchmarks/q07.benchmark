name Q07
group grouped_count_distinct

load sql_benchmarks/grouped_count_distinct/init/load.sql

assert I
WITH actual AS (
  SELECT skew_g AS g, count(DISTINCT x) AS n FROM grouped_distinct GROUP BY skew_g
), expected AS (
  SELECT g, count(x) AS n
  FROM (SELECT DISTINCT skew_g AS g, x AS x FROM grouped_distinct)
  GROUP BY g
)
SELECT NOT EXISTS (SELECT * FROM actual EXCEPT SELECT * FROM expected)
   AND NOT EXISTS (SELECT * FROM expected EXCEPT SELECT * FROM actual);
----
true

expect_plan AggregateExec

run
-- Int64 argument, eight integer groups; at least 90% of rows in one hot group.
SELECT skew_g, count(DISTINCT x) FROM grouped_distinct GROUP BY skew_g;

cleanup sql_benchmarks/grouped_count_distinct/init/cleanup.sql
