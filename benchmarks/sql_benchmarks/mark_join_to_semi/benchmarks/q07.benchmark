name Q07
group mark_join_to_semi

load sql_benchmarks/mark_join_to_semi/init/load.sql

# Count must match the already-converted top-level predicate at every size.
assert I
SELECT count(*) = (SELECT count(*) FROM mjs_outer_small o WHERE EXISTS (SELECT 1 FROM mjs_inner_small i WHERE i.z < o.z))
FROM (SELECT o.id, EXISTS (SELECT 1 FROM mjs_inner_small i WHERE i.z < o.z) AS e
      FROM mjs_outer_small o) t
WHERE e;
----
true

expect_plan NestedLoopJoinExec

run
-- Q7: inequality correlation, nested-loop join, small inputs.
SELECT count(*)
FROM (SELECT o.id, EXISTS (SELECT 1 FROM mjs_inner_small i WHERE i.z < o.z) AS e
      FROM mjs_outer_small o) t
WHERE e;

cleanup sql_benchmarks/mark_join_to_semi/init/cleanup.sql
