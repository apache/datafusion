name Q06
group first_last_orderings

load sql_benchmarks/first_last_orderings/init/load.sql

expect_plan AggregateExec

run
-- last_value ordered by a string and an integer: variable-width ordering values
-- on the general accumulator.
SELECT count(*), sum(a)
FROM (SELECT k, last_value(v ORDER BY s, o) AS a FROM first_last_orderings GROUP BY k);

cleanup sql_benchmarks/first_last_orderings/init/cleanup.sql
