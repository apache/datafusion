name Q05
group first_last_orderings

load sql_benchmarks/first_last_orderings/init/load.sql

expect_plan AggregateExec

run
-- first_value ordered by two integer columns: fixed-width ordering values on
-- the general accumulator (no time zone involved).
SELECT count(*), sum(a)
FROM (SELECT k, first_value(v ORDER BY o, v) AS a FROM first_last_orderings GROUP BY k);

cleanup sql_benchmarks/first_last_orderings/init/cleanup.sql
