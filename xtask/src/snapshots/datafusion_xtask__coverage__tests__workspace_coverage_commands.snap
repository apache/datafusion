---
source: xtask/src/coverage.rs
expression: rendered
---
cd /workspace && \
RUST_BACKTRACE=1 \
cargo llvm-cov clean \
--workspace

cd /workspace && \
RUST_BACKTRACE=1 \
cargo llvm-cov \
--profile ci \
--workspace \
--exclude datafusion-examples \
--features enabled \
--no-report \
--test sqllogictests

cd /workspace && \
RUST_BACKTRACE=1 \
cargo llvm-cov report \
--profile ci \
--codecov \
--package coverage-core \
--output-path target/codecov-slt.json

cd /workspace && \
RUST_BACKTRACE=1 \
cargo llvm-cov \
--profile ci \
--workspace \
--exclude datafusion-examples \
--features enabled \
--no-report \
--lib \
--bins \
--test enabled

cd /workspace && \
RUST_BACKTRACE=1 \
cargo llvm-cov report \
--profile ci \
--codecov \
--package coverage-core \
--output-path target/codecov.json
