source_up_if_exists

if has nix; then
  if nix --extra-experimental-features "nix-command flakes" flake --help >/dev/null 2>&1; then
    use flake
  else
    nix_description=$(
      nix --version 2>/dev/null || printf "Nix with an unknown version"
    )
    log_status "WARNING: Detected $nix_description, which does not support flakes; skipping the flake-based development environment"
  fi
fi

source_env_if_exists .envrc.local
