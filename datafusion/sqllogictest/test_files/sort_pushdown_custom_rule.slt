# Tests for sort pushdown that require a custom physical optimizer rule.
#
# NOTE: for this file only, the test harness adds `CustomLimitRule` to the
# physical optimizer just before `EnsureRequirements` (see `test_context.rs`
# and `test_context/custom_sort_pushdown.rs`). The rule replaces a redundant
# `SortExec` with a fetch on `custom_ordered_input` with a custom limit node
# (`CustomLocalLimitExec` in the plans below), which SQL cannot otherwise plan.

statement ok
SET datafusion.execution.target_partitions = 1;

statement ok
SET datafusion.explain.physical_plan_only = true;

# The inner ORDER BY determines which rows LIMIT selects. The outer sort
# must keep those rows, even when LIMIT is implemented by a custom node.
query II
SELECT a, b
FROM (SELECT a, b FROM custom_ordered_input ORDER BY a LIMIT 2) s
ORDER BY b;
----
2 20
1 30

query TT
EXPLAIN SELECT a, b
FROM (SELECT a, b FROM custom_ordered_input ORDER BY a LIMIT 2) s
ORDER BY b;
----
physical_plan
01)SortExec: expr=[b@1 ASC NULLS LAST], preserve_partitioning=[false]
02)--CustomLocalLimitExec: fetch=2
03)----CooperativeExec
04)------CustomDataSourceExec: partitions=1, partition_sizes=[1], output_ordering=a@0 ASC NULLS LAST

statement ok
SET datafusion.execution.target_partitions = 4;

statement ok
RESET datafusion.explain.physical_plan_only;
