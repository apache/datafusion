# With the opt-in enabled and one target partition, grouped all-DISTINCT aggregates
# with fixed-width, non-float arguments stay native. Multiple target partitions retain
# distributed deduplication.
# String and floating-point DISTINCT arguments still use the two-phase rewrite.

statement ok
SET datafusion.execution.target_partitions = 1;

statement ok
CREATE TABLE numeric_counts(g INT, x INT, s VARCHAR, f DOUBLE);

statement ok
INSERT INTO numeric_counts VALUES
  (1, 1, '1', 1.0),
  (1, 1, '1', 1.0),
  (1, 2, '2', 2.0),
  (1, NULL, NULL, NULL),
  (2, NULL, NULL, NULL),
  (3, 3, '3', 3.0);

statement ok
SET datafusion.explain.logical_plan_only = true;

# The default preserves the rewrite, even with one target partition.
query TT
EXPLAIN SELECT g, count(DISTINCT x) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Projection: numeric_counts.g, count(alias1) AS count(DISTINCT numeric_counts.x)
02)--Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(alias1)]]
03)----Aggregate: groupBy=[[numeric_counts.g, numeric_counts.x AS alias1]], aggr=[[]]
04)------TableScan: numeric_counts projection=[g, x]

query II rowsort
SELECT g, count(DISTINCT x) FROM numeric_counts GROUP BY g;
----
1 2
2 0
3 1

statement ok
SET datafusion.optimizer.single_distinct_prefer_native = true;

query TT
EXPLAIN SELECT g, count(DISTINCT x) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(DISTINCT numeric_counts.x)]]
02)--TableScan: numeric_counts projection=[g, x]

query TT
EXPLAIN SELECT g, count(DISTINCT s) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Projection: numeric_counts.g, count(alias1) AS count(DISTINCT numeric_counts.s)
02)--Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(alias1)]]
03)----Aggregate: groupBy=[[numeric_counts.g, numeric_counts.s AS alias1]], aggr=[[]]
04)------TableScan: numeric_counts projection=[g, s]

query TT
EXPLAIN SELECT g, count(DISTINCT f) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Projection: numeric_counts.g, count(alias1) AS count(DISTINCT numeric_counts.f)
02)--Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(alias1)]]
03)----Aggregate: groupBy=[[numeric_counts.g, numeric_counts.f AS alias1]], aggr=[[]]
04)------TableScan: numeric_counts projection=[g, f]

# A non-DISTINCT aggregate alongside keeps the rewrite.
query TT
EXPLAIN SELECT g, count(DISTINCT x), sum(x) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Projection: numeric_counts.g, count(alias1) AS count(DISTINCT numeric_counts.x), sum(alias2) AS sum(numeric_counts.x)
02)--Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(alias1), sum(alias2)]]
03)----Aggregate: groupBy=[[numeric_counts.g, numeric_counts.x AS alias1]], aggr=[[sum(CAST(numeric_counts.x AS Int64)) AS alias2]]
04)------TableScan: numeric_counts projection=[g, x]

# `sum` with integer DISTINCT argument stays native.
query TT
EXPLAIN SELECT g, sum(DISTINCT x) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Aggregate: groupBy=[[numeric_counts.g]], aggr=[[sum(DISTINCT CAST(numeric_counts.x AS Int64))]]
02)--TableScan: numeric_counts projection=[g, x]

query II rowsort
SELECT g, sum(DISTINCT x) FROM numeric_counts GROUP BY g;
----
1 3
2 NULL
3 3

# The global aggregate does not use a GroupsAccumulator.
query TT
EXPLAIN SELECT count(DISTINCT x) FROM numeric_counts;
----
logical_plan
01)Projection: count(alias1) AS count(DISTINCT numeric_counts.x)
02)--Aggregate: groupBy=[[]], aggr=[[count(alias1)]]
03)----Aggregate: groupBy=[[numeric_counts.x AS alias1]], aggr=[[]]
04)------TableScan: numeric_counts projection=[x]

statement ok
SET datafusion.explain.logical_plan_only = false;

# Specialized accumulator for Int8; duplicate and all-NULL groups.
query II rowsort
SELECT g, count(DISTINCT arrow_cast(x, 'Int8')) FROM numeric_counts GROUP BY g;
----
1 2
2 0
3 1

