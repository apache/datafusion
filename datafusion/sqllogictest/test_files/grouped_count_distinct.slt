query III rowsort
SELECT g, count(DISTINCT x), count(DISTINCT x) AS again FROM numeric_counts GROUP BY g;
----
1 2 2
2 0 0
3 1 1

query II rowsort
SELECT g + 1, count(DISTINCT x) FROM numeric_counts GROUP BY g + 1;
----
2 2
3 0
4 1

query IIII rowsort
SELECT g, count(DISTINCT x), sum(x), count(*) FROM numeric_counts GROUP BY g;
----
1 2 4 4
2 0 NULL 1
3 1 3 1

query III rowsort
SELECT g, count(DISTINCT s), count(DISTINCT f) FROM numeric_counts GROUP BY g;
----
1 2 2
2 0 0
3 1 1

query I
SELECT count(DISTINCT x) FROM numeric_counts WHERE g = 42;
----
0

query II
SELECT g, count(DISTINCT x) FROM numeric_counts WHERE g = 42 GROUP BY g;
----

statement ok
DROP TABLE numeric_counts;
