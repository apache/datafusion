query III rowsort
SELECT g, count(DISTINCT x), count(DISTINCT x) AS again FROM numeric_counts GROUP BY g;
----
1 2 2
2 0 0
3 1 1

query II rowsort
SELECT g + 1, count(DISTINCT x) FROM numeric_counts GROUP BY g + 1;
----
2 2
3 0
4 1

query IIII rowsort
SELECT g, count(DISTINCT x), sum(x), count(*) FROM numeric_counts GROUP BY g;
----
1 2 4 4
2 0 NULL 1
3 1 3 1

query III rowsort
SELECT g, count(DISTINCT s), count(DISTINCT f) FROM numeric_counts GROUP BY g;
----
1 2 2
2 0 0
3 1 1

query I
SELECT count(DISTINCT x) FROM numeric_counts WHERE g = 42;
----
0

query II
SELECT g, count(DISTINCT x) FROM numeric_counts WHERE g = 42 GROUP BY g;
----

# One target partition can still merge native states from several input partitions.
query II rowsort
SELECT g, count(DISTINCT x)
FROM (SELECT g, x FROM numeric_counts UNION ALL SELECT g, x FROM numeric_counts)
GROUP BY g;
----
1 2
2 0
3 1

statement ok
SET datafusion.explain.physical_plan_only = true;

query TT
EXPLAIN SELECT g, count(DISTINCT x)
FROM (SELECT g, x FROM numeric_counts UNION ALL SELECT g, x FROM numeric_counts)
GROUP BY g;
----
physical_plan
01)AggregateExec: mode=Final, gby=[g@0 as g], aggr=[count(DISTINCT x)]
02)--CoalescePartitionsExec
03)----AggregateExec: mode=Partial, gby=[g@0 as g], aggr=[count(DISTINCT x)]
04)------UnionExec
05)--------DataSourceExec: partitions=1, partition_sizes=[1]
06)--------DataSourceExec: partitions=1, partition_sizes=[1]

statement ok
SET datafusion.explain.physical_plan_only = false;

# Turning the opt-in off in the same session restores the rewrite.
statement ok
SET datafusion.optimizer.single_distinct_prefer_native = false;

statement ok
SET datafusion.explain.logical_plan_only = true;

query TT
EXPLAIN SELECT g, count(DISTINCT x) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Projection: numeric_counts.g, count(alias1) AS count(DISTINCT numeric_counts.x)
02)--Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(alias1)]]
03)----Aggregate: groupBy=[[numeric_counts.g, numeric_counts.x AS alias1]], aggr=[[]]
04)------TableScan: numeric_counts projection=[g, x]

statement ok
SET datafusion.optimizer.single_distinct_prefer_native = true;

# Even with the opt-in enabled, increasing target partitions restores the rewrite.
statement ok
SET datafusion.execution.target_partitions = 4;

statement ok
SET datafusion.explain.logical_plan_only = true;

query TT
EXPLAIN SELECT g, count(DISTINCT x) FROM numeric_counts GROUP BY g;
----
logical_plan
01)Projection: numeric_counts.g, count(alias1) AS count(DISTINCT numeric_counts.x)
02)--Aggregate: groupBy=[[numeric_counts.g]], aggr=[[count(alias1)]]
03)----Aggregate: groupBy=[[numeric_counts.g, numeric_counts.x AS alias1]], aggr=[[]]
04)------TableScan: numeric_counts projection=[g, x]

statement ok
SET datafusion.explain.logical_plan_only = false;

# Duplicates span source batches and partitions; one hot string group, a NULL
# grouping key and an all-NULL DISTINCT group exercise the fallback's results.
statement ok
CREATE TABLE parallel_counts AS
SELECT CASE WHEN value % 10 < 8 THEN 'hot'
            WHEN value % 10 = 8 THEN 'null_values' END AS g,
       CASE WHEN value % 10 = 8 THEN NULL ELSE value % 100 END AS x
FROM range(100000);

query TI rowsort
SELECT g, count(DISTINCT x) FROM parallel_counts GROUP BY g;
----
NULL 10
hot 80
null_values 0

query TII rowsort
SELECT g, count(DISTINCT x), count(DISTINCT x) AS again
FROM parallel_counts GROUP BY g;
----
NULL 10 10
hot 80 80
null_values 0 0

# Composite grouping with the integer DISTINCT argument, as in ClickBench Q11.
query ITI rowsort
SELECT length(g), g, count(DISTINCT x) FROM parallel_counts GROUP BY length(g), g;
----
11 null_values 0
3 hot 80
NULL NULL 10

query TI
SELECT g, count(DISTINCT x) FROM parallel_counts WHERE x = 101 GROUP BY g;
----

# This table retains its four input partitions when the target is reduced to one.
statement ok
SET datafusion.execution.target_partitions = 1;

query TI rowsort
SELECT g, count(DISTINCT x) FROM parallel_counts GROUP BY g;
----
NULL 10
hot 80
null_values 0

statement ok
SET datafusion.explain.physical_plan_only = true;

query TT
EXPLAIN SELECT g, count(DISTINCT x) FROM parallel_counts GROUP BY g;
----
physical_plan
01)AggregateExec: mode=Final, gby=[g@0 as g], aggr=[count(DISTINCT parallel_counts.x)]
02)--CoalescePartitionsExec
03)----AggregateExec: mode=Partial, gby=[g@0 as g], aggr=[count(DISTINCT parallel_counts.x)]
04)------DataSourceExec: partitions=4, partition_sizes=[4, 3, 3, 3]

statement ok
SET datafusion.explain.physical_plan_only = false;

statement ok
DROP TABLE parallel_counts;

statement ok
DROP TABLE numeric_counts;

statement ok
SET datafusion.optimizer.single_distinct_prefer_native = false;

statement ok
SET datafusion.execution.target_partitions = 4;
