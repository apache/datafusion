# Sliding SUM and AVG recover once Infinity or NaN leaves the frame.
# https://github.com/apache/datafusion/issues/26222

query IRRR
SELECT id, v,
  sum(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW),
  avg(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM (VALUES
  (1, 1.0::double),
  (2, 'Infinity'::double),
  (3, 2.0::double),
  (4, 3.0::double),
  (5, 'NaN'::double),
  (6, 4.0::double),
  (7, 5.0::double)
) AS t(id, v)
ORDER BY id;
----
1 1 1 1
2 Infinity Infinity Infinity
3 2 Infinity Infinity
4 3 5 2.5
5 NaN NaN NaN
6 4 NaN NaN
7 5 9 4.5

# Finite cancellation is unchanged: 1e16 + 1 - 1e16 drops the 1, so the
# third frame is 2 rather than 3.

query IR
SELECT id,
  sum(v) OVER (ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM (VALUES
  (1, 1e16::double),
  (2, 1.0::double),
  (3, 2.0::double)
) AS t(id, v)
ORDER BY id;
----
1 10000000000000000
2 10000000000000000
3 2
