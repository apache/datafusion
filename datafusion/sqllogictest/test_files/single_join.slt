#############
## Single Join Tests
## A correlated scalar subquery that is not aggregated is planned as a single
## join, which fails when an outer row finds two or more matches
#############

statement ok
CREATE TABLE orders(id INT, customer INT) AS VALUES
(1, 10),
(2, 20),
(3, 30),
(4, NULL);

statement ok
CREATE TABLE items(order_id INT, price INT) AS VALUES
(1, 100),
(2, 200),
(2, 250),
(4, 400);

#############
## Right single join: the subquery is the build side
#############

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join: __scalar_sq_1.order_id = o.id single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: items projection=[order_id, price]
07)----SubqueryAlias: o
08)------TableScan: orders projection=[id]
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Right, on=[(order_id@1, id@0)], projection=[id@2, price@0], single
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query II rowsort
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id AND i.price < 250) FROM orders o;
----
1 100
2 200
3 NULL
4 NULL

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o;

# The join filter removes the second match of order 2
query II rowsort
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id AND i.price > o.customer * 10 + 5) FROM orders o;
----
1 NULL
2 250
3 NULL
4 NULL

# A filter on the outer side removes order 2 before the join
query II rowsort
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o WHERE o.id <> 2;
----
1 100
3 NULL
4 400

# The sort and limit stay above the join, so order 2 still fails
query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o ORDER BY o.id LIMIT 1;
----
logical_plan
01)Sort: o.id ASC NULLS LAST, fetch=1
02)--Projection: o.id, __scalar_sq_1.price AS price
03)----Right Join: __scalar_sq_1.order_id = o.id single
04)------SubqueryAlias: __scalar_sq_1
05)--------Projection: i.price, i.order_id
06)----------SubqueryAlias: i
07)------------TableScan: items projection=[order_id, price]
08)------SubqueryAlias: o
09)--------TableScan: orders projection=[id]
physical_plan
01)SortExec: TopK(fetch=1), expr=[id@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--HashJoinExec: mode=CollectLeft, join_type=Right, on=[(order_id@1, id@0)], projection=[id@2, price@0], single
03)----DataSourceExec: partitions=1, partition_sizes=[1]
04)----DataSourceExec: partitions=1, partition_sizes=[1]

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o ORDER BY o.id LIMIT 1;

# A subquery in a filter
query I rowsort
SELECT o.id FROM orders o WHERE o.customer * 10 = (SELECT i.price FROM items i WHERE i.order_id = o.id AND i.price < 250);
----
1
2

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id FROM orders o WHERE o.customer * 10 = (SELECT i.price FROM items i WHERE i.order_id = o.id);

#############
## Nested loop single join: the correlation has no equality
#############

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id > o.id) FROM orders o WHERE o.id >= 3;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join:  Filter: __scalar_sq_1.order_id > o.id single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: items projection=[order_id, price]
07)----SubqueryAlias: o
08)------Filter: orders.id >= Int32(3)
09)--------TableScan: orders projection=[id]
physical_plan
01)NestedLoopJoinExec: join_type=Right, filter=order_id@0 > id@1, projection=[id@2, price@0], single
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
04)----FilterExec: id@0 >= 3
05)------DataSourceExec: partitions=1, partition_sizes=[1]

query II rowsort
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id > o.id) FROM orders o WHERE o.id >= 3;
----
3 400
4 NULL

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id > o.id) FROM orders o;

# A piecewise merge join cannot check matches, so the nested loop join is kept
statement ok
set datafusion.optimizer.enable_piecewise_merge_join = true;

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id > o.id) FROM orders o WHERE o.id >= 3;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join:  Filter: __scalar_sq_1.order_id > o.id single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: items projection=[order_id, price]
07)----SubqueryAlias: o
08)------Filter: orders.id >= Int32(3)
09)--------TableScan: orders projection=[id]
physical_plan
01)NestedLoopJoinExec: join_type=Right, filter=order_id@0 > id@1, projection=[id@2, price@0], single
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
04)----FilterExec: id@0 >= 3
05)------DataSourceExec: partitions=1, partition_sizes=[1]

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id > o.id) FROM orders o;

statement ok
set datafusion.optimizer.enable_piecewise_merge_join = false;

#############
## Sort merge join is never used for a single join
#############

statement ok
set datafusion.optimizer.prefer_hash_join = false;

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join: __scalar_sq_1.order_id = o.id single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: items projection=[order_id, price]
07)----SubqueryAlias: o
08)------TableScan: orders projection=[id]
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Right, on=[(order_id@1, id@0)], projection=[id@2, price@0], single
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o;

statement ok
set datafusion.optimizer.prefer_hash_join = true;

#############
## Left single join: the subquery side is larger, so the outer side is the
## build side
#############

statement ok
CREATE TABLE many_items AS
SELECT CAST(value AS INT) AS order_id, CAST(value * 10 AS INT) AS price FROM generate_series(1, 1000)
UNION ALL
SELECT 2, 999;

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM many_items i WHERE i.order_id = o.id) FROM orders o;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join: __scalar_sq_1.order_id = CAST(o.id AS Int64) single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: many_items projection=[order_id, price]
07)----SubqueryAlias: o
08)------TableScan: orders projection=[id]
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Left, on=[(CAST(o.id AS Int64)@1, order_id@1)], projection=[id@0, price@2], single
02)--ProjectionExec: expr=[id@0 as id, CAST(id@0 AS Int64) as CAST(o.id AS Int64)]
03)----DataSourceExec: partitions=1, partition_sizes=[1]
04)--DataSourceExec: partitions=5, partition_sizes=[1, 0, 0, 0, 1]

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM many_items i WHERE i.order_id = o.id) FROM orders o;

query II rowsort
SELECT o.id, (SELECT i.price FROM many_items i WHERE i.order_id = o.id AND i.price < 999) FROM orders o;
----
1 10
2 20
3 30
4 40

#############
## Partitioned mode, in both orientations
#############

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold = 0;

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold_rows = 0;

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join: __scalar_sq_1.order_id = o.id single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: items projection=[order_id, price]
07)----SubqueryAlias: o
08)------TableScan: orders projection=[id]
physical_plan
01)HashJoinExec: mode=Partitioned, join_type=Right, on=[(order_id@1, id@0)], projection=[id@2, price@0], single
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id) FROM orders o;

query II rowsort
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id AND i.price < 250) FROM orders o;
----
1 100
2 200
3 NULL
4 NULL

query TT
EXPLAIN SELECT o.id, (SELECT i.price FROM many_items i WHERE i.order_id = o.id) FROM orders o;
----
logical_plan
01)Projection: o.id, __scalar_sq_1.price AS price
02)--Right Join: __scalar_sq_1.order_id = CAST(o.id AS Int64) single
03)----SubqueryAlias: __scalar_sq_1
04)------Projection: i.price, i.order_id
05)--------SubqueryAlias: i
06)----------TableScan: many_items projection=[order_id, price]
