#############
## An uncorrelated subquery planned as a join
#############

statement ok
set datafusion.optimizer.enable_physical_uncorrelated_scalar_subquery = false;

query error DataFusion error: Execution error: Scalar subquery returned more than one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = 2) FROM orders o;

query II rowsort
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = 1) FROM orders o;
----
1 100
2 100
3 100
4 100

statement ok
reset datafusion.optimizer.enable_physical_uncorrelated_scalar_subquery;

#############
## A subquery that cannot be decorrelated
#############

statement error DataFusion error: Optimizer rule 'scalar_subquery_to_join' failed\ncaused by\nError during planning: Correlated scalar subquery must be aggregated to return at most one row
SELECT o.id, (SELECT i.price FROM items i WHERE i.order_id = o.id LIMIT 2) FROM orders o;

statement ok
DROP TABLE orders;

statement ok
DROP TABLE items;

statement ok
DROP TABLE many_items;
