# PushDownFilter converts a whole conjunct on a MARK column to SEMI/ANTI.
# !null_aware proves the mark is two-valued; the nullable schema field alone
# cannot prove it. False-selecting predicates must keep null-aware marks.
# A compensating projection restores the selected marker as a constant. This
# preserves positional aliases and ancestor consumers, including the shape
# DuckDB's no_mark_to_semi_if_mark_index_is_projected.test refuses to convert.
# Null-safe equalities are narrowed only on converted joins and only when a
# child schema proves an operand non-nullable.

statement ok
set datafusion.execution.target_partitions = 1;

statement ok
set datafusion.optimizer.filter_null_join_keys = false;

statement ok
set datafusion.explain.logical_plan_only = true;

statement ok
CREATE TABLE pdm_outer(id INT, k INT) AS VALUES (1, 1), (2, 2), (3, 3), (4, NULL), (5, 2);

statement ok
CREATE TABLE pdm_inner(k INT) AS VALUES (2), (2), (NULL);

statement ok
CREATE TABLE pdm_inner_nn(k INT) AS VALUES (2), (2);

statement ok
CREATE TABLE pdm_empty(k INT);

statement ok
CREATE TABLE pdm_base(my_key INT, parent_key INT) AS VALUES (1, 2), (2, NULL), (3, 2);

statement ok
CREATE TABLE pdm_a(x BIGINT, g BIGINT) AS VALUES (1, 0), (NULL, 0);

statement ok
CREATE TABLE pdm_b(y BIGINT, g BIGINT) AS VALUES (1, 0), (NULL, 0);

statement ok
COPY (SELECT 1 AS y, 0 AS g) TO 'test_files/scratch/push_down_filter_mark_join/b.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE pdm_b_nn(y BIGINT NOT NULL, g BIGINT NOT NULL)
STORED AS PARQUET LOCATION 'test_files/scratch/push_down_filter_mark_join/b.parquet';

statement ok
COPY (SELECT 1 AS x, 0 AS g) TO 'test_files/scratch/push_down_filter_mark_join/a.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE pdm_a_nn(x BIGINT NOT NULL, g BIGINT NOT NULL)
STORED AS PARQUET LOCATION 'test_files/scratch/push_down_filter_mark_join/a.parquet';

# A: conversions through derived tables, CTEs, and views.

query TT
EXPLAIN SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS e FROM pdm_outer o) t WHERE e;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftSemi Join: o.k = __correlated_sq_1.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]

query I rowsort
SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS e FROM pdm_outer o) t WHERE e;
----
2
5

query I rowsort
WITH t AS (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS e FROM pdm_outer o) SELECT id FROM t WHERE e;
----
2
5

statement ok
CREATE VIEW pdm_view AS SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS e FROM pdm_outer o;

query I rowsort
SELECT id FROM pdm_view WHERE e;
