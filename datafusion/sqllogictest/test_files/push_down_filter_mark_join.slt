# The LEFT JOIN below MARK must retain its null-extension semantics.
query TT
EXPLAIN SELECT my_key, e FROM (
  SELECT b.my_key, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = p.my_key) AS e
  FROM pdm_base b LEFT JOIN pdm_base p ON b.parent_key = p.my_key
) t WHERE e;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: b.my_key, Boolean(true) AS e
03)----LeftSemi Join: p.my_key = __correlated_sq_1.k
04)------Projection: b.my_key, p.my_key
05)--------Left Join: b.parent_key = p.my_key
06)----------SubqueryAlias: b
07)------------TableScan: pdm_base projection=[my_key, parent_key]
08)----------SubqueryAlias: p
09)------------TableScan: pdm_base projection=[my_key]
10)------SubqueryAlias: __correlated_sq_1
11)--------SubqueryAlias: i
12)----------TableScan: pdm_inner projection=[k]

query IB rowsort
SELECT my_key, e FROM (
  SELECT b.my_key, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = p.my_key) AS e
  FROM pdm_base b LEFT JOIN pdm_base p ON b.parent_key = p.my_key
) t WHERE e;
----
1 true
3 true

