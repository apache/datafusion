# NULL on the inner side makes every unmatched NOT IN result UNKNOWN.
query TT
EXPLAIN SELECT id FROM pdm_outer WHERE (k NOT IN (SELECT k FROM pdm_inner)) IS TRUE;
----
logical_plan
01)Projection: pdm_outer.id
02)--Filter: NOT __correlated_sq_1.mark IS TRUE
03)----Projection: pdm_outer.id, __correlated_sq_1.mark
04)------LeftMark Join: pdm_outer.k = __correlated_sq_1.k null_aware
05)--------TableScan: pdm_outer projection=[id, k]
06)--------SubqueryAlias: __correlated_sq_1
07)----------TableScan: pdm_inner projection=[k]

query I rowsort
SELECT id FROM pdm_outer WHERE (k NOT IN (SELECT k FROM pdm_inner)) IS TRUE;
----


# NULL outer keys are UNKNOWN even when the inner side has no NULL values.
query TT
EXPLAIN SELECT id FROM pdm_outer WHERE (k NOT IN (SELECT k FROM pdm_inner_nn)) IS TRUE;
----
logical_plan
01)Projection: pdm_outer.id
02)--Filter: NOT __correlated_sq_1.mark IS TRUE
03)----Projection: pdm_outer.id, __correlated_sq_1.mark
04)------LeftMark Join: pdm_outer.k = __correlated_sq_1.k null_aware
05)--------TableScan: pdm_outer projection=[id, k]
06)--------SubqueryAlias: __correlated_sq_1
07)----------TableScan: pdm_inner_nn projection=[k]

query I rowsort
SELECT id FROM pdm_outer WHERE (k NOT IN (SELECT k FROM pdm_inner_nn)) IS TRUE;
----
1
3

# C: null-safe equality. HashJoinExec alone prints NullsEqual.

statement ok
set datafusion.explain.logical_plan_only = false;

# Control: an existing SEMI join keeps its null-safe equality.
query TT
EXPLAIN SELECT count(*) FROM pdm_a a WHERE EXISTS (SELECT 1 FROM pdm_b b WHERE a.x IS NOT DISTINCT FROM b.y);
----
logical_plan
01)Projection: count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
03)----Projection:
04)------LeftSemi Join: a.x = __correlated_sq_1.y
05)--------SubqueryAlias: a
06)----------TableScan: pdm_a projection=[x]
07)--------SubqueryAlias: __correlated_sq_1
08)----------SubqueryAlias: b
09)------------TableScan: pdm_b projection=[y]
physical_plan
01)ProjectionExec: expr=[count(Int64(1))@0 as count(*)]
02)--AggregateExec: mode=Single, gby=[], aggr=[count(Int64(1))]
03)----HashJoinExec: mode=CollectLeft, join_type=LeftSemi, on=[(x@0, y@0)], projection=[], NullsEqual: true
04)------DataSourceExec: partitions=1, partition_sizes=[1]
05)------DataSourceExec: partitions=1, partition_sizes=[1]

