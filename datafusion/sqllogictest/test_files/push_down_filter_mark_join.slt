# An equality key leaves the null-safe comparison as a residual join filter.
query TT
EXPLAIN SELECT count(*) FROM (SELECT EXISTS (SELECT 1 FROM pdm_b b WHERE a.g = b.g AND a.x IS NOT DISTINCT FROM b.y) AS e FROM pdm_a a) t WHERE e;
----
logical_plan
01)Projection: count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
03)----SubqueryAlias: t
04)------Projection:
05)--------LeftSemi Join: a.g = __correlated_sq_1.g Filter: a.x IS NOT DISTINCT FROM __correlated_sq_1.y
06)----------SubqueryAlias: a
07)------------TableScan: pdm_a projection=[x, g]
08)----------SubqueryAlias: __correlated_sq_1
09)------------Projection: b.g, b.y
10)--------------SubqueryAlias: b
11)----------------TableScan: pdm_b projection=[y, g]
physical_plan
01)ProjectionExec: expr=[count(Int64(1))@0 as count(*)]
02)--AggregateExec: mode=Single, gby=[], aggr=[count(Int64(1))]
03)----HashJoinExec: mode=CollectLeft, join_type=RightSemi, on=[(g@0, g@1)], filter=x@0 IS NOT DISTINCT FROM y@1, projection=[]
04)------DataSourceExec: partitions=1, partition_sizes=[1]
05)------DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT count(*) FROM (SELECT EXISTS (SELECT 1 FROM pdm_b b WHERE a.g = b.g AND a.x IS NOT DISTINCT FROM b.y) AS e FROM pdm_a a) t WHERE e;
----
2

# D: inequality correlations.

query TT
EXPLAIN SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS e FROM pdm_outer o) t WHERE e;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftSemi Join:  Filter: __correlated_sq_1.k < o.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]
physical_plan
01)NestedLoopJoinExec: join_type=RightSemi, filter=k@1 < k@0, projection=[id@0]
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS e FROM pdm_outer o) t WHERE e;
----
3

# Unlike DuckDB's condition-based guard, !null_aware permits inequality ANTI too.
query TT
EXPLAIN SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS e FROM pdm_outer o) t WHERE NOT e;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftAnti Join:  Filter: __correlated_sq_1.k < o.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]
physical_plan
01)NestedLoopJoinExec: join_type=RightAnti, filter=k@1 < k@0, projection=[id@0]
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS e FROM pdm_outer o) t WHERE NOT e;
----
1
2
4
5

statement ok
set datafusion.optimizer.enable_piecewise_merge_join = true;

# The converted SEMI is now eligible for PiecewiseMergeJoin.
query TT
EXPLAIN SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS e FROM pdm_outer o) t WHERE e;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----LeftSemi Join:  Filter: __correlated_sq_1.k < o.k
04)------SubqueryAlias: o
05)--------TableScan: pdm_outer projection=[id, k]
06)------SubqueryAlias: __correlated_sq_1
07)--------SubqueryAlias: i
08)----------TableScan: pdm_inner projection=[k]
physical_plan
01)ProjectionExec: expr=[id@0 as id]
02)--PiecewiseMergeJoin: operator=Gt, join_type=LeftSemi, on=(k > k)
03)----SortExec: expr=[k@1 ASC], preserve_partitioning=[false]
04)------DataSourceExec: partitions=1, partition_sizes=[1]
05)----DataSourceExec: partitions=1, partition_sizes=[1]

query I rowsort
SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k < o.k) AS e FROM pdm_outer o) t WHERE e;
----
3

statement ok
set datafusion.optimizer.enable_piecewise_merge_join = false;

# E: projected IN currently uses three mark joins plus CASE (#24972).
# The single null-aware mark from #25338 must preserve these same results.
# No plan snapshots: both representations are valid.

query I rowsort
SELECT id FROM (SELECT o.id, o.k IN (SELECT k FROM pdm_inner) AS m FROM pdm_outer o) t WHERE m;
