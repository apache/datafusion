# B: non-conversions. OR/IS NULL do not constrain a marker to one value.

query TT
EXPLAIN SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS e FROM pdm_outer o) t WHERE e OR id = 1;
----
logical_plan
01)SubqueryAlias: t
02)--Projection: o.id
03)----Filter: __correlated_sq_1.mark OR o.id = Int32(1)
04)------Projection: o.id, __correlated_sq_1.mark
05)--------LeftMark Join: o.k = __correlated_sq_1.k
06)----------SubqueryAlias: o
07)------------TableScan: pdm_outer projection=[id, k]
08)----------SubqueryAlias: __correlated_sq_1
09)------------SubqueryAlias: i
10)--------------TableScan: pdm_inner projection=[k]

query I rowsort
SELECT id FROM (SELECT o.id, EXISTS (SELECT 1 FROM pdm_inner i WHERE i.k = o.k) AS e FROM pdm_outer o) t WHERE e OR id = 1;
----
