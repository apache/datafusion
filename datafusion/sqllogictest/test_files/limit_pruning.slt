statement ok
set datafusion.execution.parquet.pushdown_filters = true;


statement ok
CREATE TABLE tracking_data AS VALUES
-- ***** Row Group 0 *****
  ('Anow Vole', 7),
  ('Brown Bear', 133),
  ('Gray Wolf', 82),
-- ***** Row Group 1 *****
  ('Lynx', 71),
  ('Red Fox', 40),
  ('Alpine Bat', 6),
-- ***** Row Group 2 *****
  ('Nlpine Ibex', 101),
  ('Nlpine Goat', 76),
  ('Nlpine Sheep', 83),
-- ***** Row Group 3 *****
  ('Europ. Mole', 4),
  ('Polecat', 16),
  ('Alpine Ibex', 97);

statement ok
COPY (SELECT column1 as species, column2 as s FROM tracking_data)
TO 'test_files/scratch/limit_pruning/data.parquet'
STORED AS PARQUET
OPTIONS (
  'format.max_row_group_size' '3'
);

statement ok
drop table tracking_data;

statement ok
CREATE EXTERNAL TABLE tracking_data
STORED AS PARQUET
LOCATION 'test_files/scratch/limit_pruning/data.parquet';


statement ok
set datafusion.explain.analyze_level = summary;

# row_groups_pruned_statistics=4 total → 3 matched -> 1 fully matched
# limit_pruned_row_groups=2 total → 0 matched
query TT
explain analyze select * from tracking_data where species > 'M' AND s >= 50 limit 3;
----
Plan with Metrics DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/data.parquet]]}, projection=[species, s], limit=3, file_type=parquet, predicate=species@0 > M AND s@1 >= 50, pruning_predicate=species_null_count@1 != row_count@2 AND species_max@0 > M AND s_null_count@4 != row_count@2 AND s_max@3 >= 50, required_guarantees=[], metrics=[output_rows=3, elapsed_compute=<slt:ignore>, output_bytes=<slt:ignore>, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=4 total → 3 matched -> 1 fully matched, page_index_pages_pruned=0 total → 0 matched, page_index_pages_skipped_by_fully_matched=1, limit_pruned_row_groups=2 total → 0 matched, bytes_processed=<slt:ignore>, bytes_scanned=<slt:ignore>, metadata_load_time=<slt:ignore>, scan_efficiency_ratio=<slt:ignore> (159/2.23 K)]

statement ok
CREATE TABLE fully_matched_limit_source AS VALUES
  (1),
  (2),
  (3),
  (4),
  (5),
  (6),
  (7),
  (1),
  (2);

query I
COPY (SELECT column1 as a FROM fully_matched_limit_source)
TO 'test_files/scratch/limit_pruning/fully_matched_limit.parquet'
STORED AS PARQUET
OPTIONS (
  'format.max_row_group_size' '3'
);
----
9

statement ok
drop table fully_matched_limit_source;

statement ok
CREATE EXTERNAL TABLE fully_matched_limit
STORED AS PARQUET
LOCATION 'test_files/scratch/limit_pruning/fully_matched_limit.parquet';

# One fully matched row group sits between two filtered row groups.
# LIMIT must apply across the entire scan, not once per decoder run.
query TT
explain analyze select a from fully_matched_limit where a >= 3 limit 4;
----
Plan with Metrics DataSourceExec: <slt:ignore>metrics=[output_rows=4, <slt:ignore>row_groups_pruned_statistics=3 total → 3 matched -> 1 fully matched<slt:ignore>]

query I
select a from fully_matched_limit where a >= 3 order by a limit 4;
----
3
4
5
6

statement ok
drop table fully_matched_limit;

# limit_pruned_row_groups=0 total → 0 matched
# because of order by, scan needs to preserve sort, so limit pruning is disabled
query TT
explain analyze select * from tracking_data where species > 'M' AND s >= 50 order by species limit 3;
----
Plan with Metrics
01)SortExec: TopK(fetch=3), expr=[species@0 ASC NULLS LAST], preserve_partitioning=[false], filter=[species@0 < Nlpine Sheep], metrics=[output_rows=3, elapsed_compute=<slt:ignore>, output_bytes=<slt:ignore>]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/data.parquet]]}, projection=[species, s], file_type=parquet, predicate=species@0 > M AND s@1 >= 50 AND DynamicFilter [ species@0 < Nlpine Sheep ], sort_order_for_reorder=[species@0 ASC NULLS LAST], dynamic_rg_pruning=eligible, pruning_predicate=species_null_count@1 != row_count@2 AND species_max@0 > M AND s_null_count@4 != row_count@2 AND s_max@3 >= 50 AND species_null_count@1 != row_count@2 AND species_min@5 < Nlpine Sheep, required_guarantees=[], metrics=[output_rows=3, elapsed_compute=<slt:ignore>, output_bytes=<slt:ignore>, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=4 total → 3 matched -> 1 fully matched, page_index_pages_pruned=2 total → 2 matched, page_index_pages_skipped_by_fully_matched=1, limit_pruned_row_groups=0 total → 0 matched, bytes_processed=<slt:ignore>, bytes_scanned=<slt:ignore>, row_groups_pruned_dynamic_filter=0, metadata_load_time=<slt:ignore>, scan_efficiency_ratio=<slt:ignore> (<slt:ignore>/<slt:ignore>)]

statement ok
drop table tracking_data;

statement ok
reset datafusion.explain.analyze_level;

# A scan that advertises an ordering must keep it when the fetch of a
# SortPreservingMergeExec is pushed into it: no limit pruning, no work stealing.
statement ok
set datafusion.execution.target_partitions = 2;

statement ok
set datafusion.explain.physical_plan_only = true;

# Row group 0 of a.parquet partially matches `passes = 1` (id 1 fails), row
# group 1 fully matches. Limit pruning would skip row group 0 and return 4, 5, 6.
query I
COPY (SELECT value AS id, CASE WHEN value = 1 THEN 0 ELSE 1 END AS passes FROM generate_series(1, 6))
TO 'test_files/scratch/limit_pruning/ordered_prune/a.parquet'
STORED AS PARQUET OPTIONS ('format.max_row_group_size' '3');
----
6

query I
COPY (SELECT value AS id, 1 AS passes FROM generate_series(101, 103))
TO 'test_files/scratch/limit_pruning/ordered_prune/b.parquet'
STORED AS PARQUET OPTIONS ('format.max_row_group_size' '3');
----
3

statement ok
CREATE EXTERNAL TABLE ordered_prune STORED AS PARQUET
LOCATION 'test_files/scratch/limit_pruning/ordered_prune/'
WITH ORDER (id ASC);

query TT
explain select id from ordered_prune where passes = 1 order by id limit 3;
----
physical_plan
01)SortPreservingMergeExec: [id@0 ASC NULLS LAST], fetch=3
02)--DataSourceExec: <slt:ignore>limit=3, output_ordering=[id@0 ASC NULLS LAST], file_type=parquet<slt:ignore>

query I
select id from ordered_prune where passes = 1 order by id limit 3;
----
2
3
4

statement ok
drop table ordered_prune;

# File groups are [a, b] and [c], each sorted, so the scan advertises `a ASC`.
# c.parquet holds the smallest values. If the two partitions shared one file
# queue (a, b, c), no partition would start with c and the limit would return 0..4.
query I
COPY (SELECT value AS a FROM generate_series(0, 9))
TO 'test_files/scratch/limit_pruning/ordered_steal/a.parquet';
----
10

query I
COPY (SELECT value AS a FROM generate_series(10, 19))
TO 'test_files/scratch/limit_pruning/ordered_steal/b.parquet';
----
10

query I
COPY (SELECT value AS a FROM generate_series(-10, -1))
TO 'test_files/scratch/limit_pruning/ordered_steal/c.parquet';
----
10

statement ok
CREATE EXTERNAL TABLE ordered_steal STORED AS PARQUET
LOCATION 'test_files/scratch/limit_pruning/ordered_steal/'
WITH ORDER (a ASC);

query TT
explain select a from ordered_steal order by a limit 5;
----
physical_plan
01)SortPreservingMergeExec: [a@0 ASC NULLS LAST], fetch=5
02)--DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/ordered_steal/a.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/ordered_steal/b.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/ordered_steal/c.parquet]]}, projection=[a], limit=5, output_ordering=[a@0 ASC NULLS LAST], file_type=parquet

query I
select a from ordered_steal order by a limit 5;
----
-10
-9
-8
-7
-6

# With an OFFSET, the scan gets a fetch of skip + fetch = 5 and must still
# start with c.parquet.
query TT
explain select a from ordered_steal order by a limit 3 offset 2;
----
physical_plan
01)GlobalLimitExec: skip=2, fetch=3
02)--SortPreservingMergeExec: [a@0 ASC NULLS LAST], fetch=5
03)----DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/ordered_steal/a.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/ordered_steal/b.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/limit_pruning/ordered_steal/c.parquet]]}, projection=[a], limit=5, output_ordering=[a@0 ASC NULLS LAST], file_type=parquet

query I
select a from ordered_steal order by a limit 3 offset 2;
----
-8
-7
-6

statement ok
drop table ordered_steal;

statement ok
set datafusion.execution.target_partitions = 4;

statement ok
reset datafusion.explain.physical_plan_only;

# Config reset
statement ok
RESET datafusion.execution.parquet.pushdown_filters;
