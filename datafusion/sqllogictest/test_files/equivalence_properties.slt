# Planner decisions that depend on what each plan node knows about its
# output: its orderings, the columns that are constant, and the columns that
# are equal. Each case says which decision it pins.

statement ok
set datafusion.explain.physical_plan_only = true;

statement ok
set datafusion.execution.target_partitions = 4;

# window_2.csv is sorted by (a, b) and, separately, by c.
statement ok
CREATE EXTERNAL TABLE t (
  a0 INTEGER,
  a INTEGER,
  b INTEGER,
  c INTEGER,
  d INTEGER
)
STORED AS CSV
WITH ORDER (a ASC, b ASC)
WITH ORDER (c ASC)
LOCATION '../core/tests/data/window_2.csv'
OPTIONS ('format.has_header' 'true');

statement ok
CREATE TABLE small(x INT) AS VALUES (1), (2);

###
### Unions
###

# Each side of the union is sorted by a and also by a cast of a, but the cast
# is in column x on the left side and in column y on the right side. The
# union must still report that its output is sorted by a, so ORDER BY a needs
# only a merge.
query TT
EXPLAIN SELECT a, CAST(a AS BIGINT) x, CAST(d AS BIGINT) y FROM t
UNION ALL
SELECT a, CAST(d AS BIGINT) x, CAST(a AS BIGINT) y FROM t
ORDER BY a;
----
physical_plan
01)SortPreservingMergeExec: [a@0 ASC NULLS LAST]
02)--UnionExec
03)----ProjectionExec: expr=[a@0 as a, CAST(a@0 AS Int64) as x, CAST(d@1 AS Int64) as y]
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, d], output_ordering=[a@0 ASC NULLS LAST], file_type=csv, has_header=true
06)----ProjectionExec: expr=[a@0 as a, CAST(d@1 AS Int64) as x, CAST(a@0 AS Int64) as y]
07)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
08)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, d], output_ordering=[a@0 ASC NULLS LAST], file_type=csv, has_header=true

###
### GROUP BY keys in a different order than the input's orderings
###

# The GROUP BY lists its keys as d, c, b, a, which matches neither input
# ordering. The aggregates still find that c, a and b are sorted (c from the
# ordering on c, then a and b from the ordering on (a, b)), so they run in
# partially sorted mode. The clustering mode lists those keys by their
# position in the GROUP BY, in the order they were found: [1, 3, 2].
query TT
EXPLAIN SELECT d, c, b, a, count(*) FROM t GROUP BY d, c, b, a;
----
physical_plan
01)ProjectionExec: expr=[d@0 as d, c@1 as c, b@2 as b, a@3 as a, count(Int64(1))@4 as count(*)]
02)--AggregateExec: mode=FinalPartitioned, gby=[d@0 as d, c@1 as c, b@2 as b, a@3 as a], aggr=[count(Int64(1))], group_clustering_mode=Partial([1, 3, 2])
03)----RepartitionExec: partitioning=Hash([d@0, c@1, b@2, a@3], 4), input_partitions=4, preserve_order=true, sort_exprs=c@1 ASC NULLS LAST, a@3 ASC NULLS LAST, b@2 ASC NULLS LAST
04)------AggregateExec: mode=Partial, gby=[d@3 as d, c@2 as c, b@1 as b, a@0 as a], aggr=[count(Int64(1))], group_clustering_mode=Partial([1, 3, 2])
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b, c, d], output_orderings=[[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], [c@2 ASC NULLS LAST]], file_type=csv, has_header=true

###
### Constants
###

# The filter makes b constant, and the inner ORDER BY c LIMIT 5 (planned as a
# merge with a fetch) keeps that fact. So the outer ORDER BY b, c is already
# satisfied by the order on c and the plan has no second sort.
query TT
EXPLAIN SELECT * FROM (SELECT b, c FROM t WHERE b = 1 ORDER BY c LIMIT 5) ORDER BY b, c;
----
physical_plan
01)SortPreservingMergeExec: [c@1 ASC NULLS LAST], fetch=5
02)--FilterExec: b@0 = 1, fetch=5
03)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[b, c], output_ordering=[c@1 ASC NULLS LAST], file_type=csv, has_header=true

query II
SELECT * FROM (SELECT b, c FROM t WHERE b = 1 ORDER BY c LIMIT 5) ORDER BY b, c;
----
1 25
1 26
1 27
1 28
1 29

# A cross join keeps the constants of its left input: b = 1 still holds after
# the join, so ORDER BY l.b, l.c sorts on c only.
query TT
EXPLAIN SELECT l.b, l.c, s.x FROM (SELECT b, c FROM t WHERE b = 1) l CROSS JOIN small s ORDER BY l.b, l.c;
----
physical_plan
01)SortExec: expr=[c@1 ASC NULLS LAST], preserve_partitioning=[false]
02)--CrossJoinExec
03)----CoalescePartitionsExec
04)------FilterExec: b@0 = 1
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[b, c], output_ordering=[c@1 ASC NULLS LAST], file_type=csv, has_header=true
07)----DataSourceExec: partitions=1, partition_sizes=[1]

# A cross join also keeps a right-side constant set by an equality filter:
# x = 1 still holds after the join, so ORDER BY l.c, s.x sorts on c only.
query TT
EXPLAIN SELECT l.c, s.x FROM (SELECT c FROM t) l CROSS JOIN (SELECT x FROM small WHERE x = 1) s ORDER BY l.c, s.x;
----
physical_plan
01)SortPreservingMergeExec: [c@0 ASC NULLS LAST, x@1 ASC NULLS LAST]
02)--SortExec: expr=[c@0 ASC NULLS LAST], preserve_partitioning=[true]
03)----CrossJoinExec
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[c], output_ordering=[c@0 ASC NULLS LAST], file_type=csv, has_header=true
05)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)--------FilterExec: x@0 = 1
07)----------DataSourceExec: partitions=1, partition_sizes=[1]

query II
SELECT l.c, s.x FROM (SELECT c FROM t) l CROSS JOIN (SELECT x FROM small WHERE x = 1) s ORDER BY l.c, s.x LIMIT 3;
----
0 1
1 1
2 1

###
### Equal expressions need not be injective
###

# c = abs(a) transfers ordering to abs(a), but equal c values do not pin
# down a. The sort on b must remain for the two rows with c = 1.
statement ok
set datafusion.execution.target_partitions = 1;

query I
COPY (VALUES (-1, 2, 1), (1, 1, 1))
TO 'test_files/scratch/equivalence_properties/abs.csv'
OPTIONS ('format.has_header' 'true');
----
2

statement ok
CREATE EXTERNAL TABLE abs_equivalence (a INT, b INT, c INT)
STORED AS CSV
WITH ORDER (a, b)
WITH ORDER (c)
LOCATION 'test_files/scratch/equivalence_properties/abs.csv'
OPTIONS ('format.has_header' 'true');

query III
SELECT a, b, c FROM abs_equivalence WHERE c = abs(a) ORDER BY c, b;
----
1 1 1
-1 2 1

statement ok
DROP TABLE abs_equivalence;

###
### Projection equalities and TopK
###

# Independent volatile calls must keep the outer sort above the inner TopK.
statement ok
set datafusion.execution.target_partitions = 1;

query TT
EXPLAIN SELECT r, x FROM (
  SELECT random() AS r, CAST(random() AS FLOAT) AS x
  FROM generate_series(1, 2000) ORDER BY r LIMIT 1000
) ORDER BY x;
----
physical_plan
01)SortExec: expr=[x@1 ASC NULLS LAST], preserve_partitioning=[false]
02)--SortExec: TopK(fetch=1000), expr=[r@0 ASC NULLS LAST], preserve_partitioning=[false]
03)----ProjectionExec: expr=[random() as r, CAST(random() AS Float32) as x]
04)------LazyMemoryExec: partitions=1, batch_generators=[generate_series: start=1, end=2000, batch_size=8192]

# A deterministic cast is a valid equality, but can introduce ties. The
# inner TopK must still select by r, even though its output is ordered by x.
statement ok
CREATE TABLE lossy_topk AS VALUES (16777217), (16777216);

query IR
SELECT r, x FROM (
  SELECT column1 AS r, CAST(column1 AS FLOAT) AS x FROM lossy_topk
  ORDER BY r LIMIT 1
) ORDER BY x;
----
16777216 16777216

statement ok
DROP TABLE lossy_topk;

statement ok
set datafusion.execution.target_partitions = 4;

###
### Outer join NULL padding invalidates computed equalities
###

statement ok
set datafusion.execution.target_partitions = 1;

statement ok
CREATE TABLE padded_l(k INT) AS VALUES (1), (2), (3);

statement ok
CREATE TABLE padded_r(k INT, a INT) AS VALUES (1, 1), (2, 2);

# On the unmatched row, rr.x is NULL but the CASE expression is 0.
# Their input equality must not remove the outer sort.
query I
SELECT y FROM (
  SELECT CASE WHEN a IS NULL THEN 0 ELSE a END AS y FROM (
    SELECT rr.x, rr.a
    FROM (SELECT k, a, CASE WHEN a IS NULL THEN 0 ELSE a END AS x FROM padded_r) rr
    RIGHT JOIN padded_l ON padded_l.k = rr.k
    ORDER BY rr.x LIMIT 100
  )
) ORDER BY y;
----
0
1
2

# The filter-derived equality from #26036 is also invalid on padded rows.
statement ok
CREATE TABLE padded_filter(a INT, b INT) AS VALUES (2, 2), (3, 3), (5, 5), (6, 6), (7, 7), (8, 8);

query III
SELECT padded_l.k, rr.a, rr.b FROM padded_l
LEFT JOIN (SELECT a, b FROM padded_filter WHERE b = coalesce(a, 0)) rr
ON padded_l.k = rr.b
ORDER BY coalesce(rr.a, 0), padded_l.k;
----
1 NULL NULL
2 2 2
3 3 3

statement ok
DROP TABLE padded_filter;

statement ok
DROP TABLE padded_l;

statement ok
DROP TABLE padded_r;

statement ok
set datafusion.execution.target_partitions = 4;

###
### Functional dependencies through an inner join
###

# items.i_id is the primary key, so after the join on s_item = i_id each
# s_item has one i_name: s_item determines i_name. The join keeps the order of
# sales, its probe side, which is [s_item, s_day].
statement ok
set datafusion.execution.target_partitions = 1;

query I
COPY (SELECT * FROM (VALUES (1, 'apple', 'fruit'), (2, 'bread', 'bakery'), (3, 'cheese', 'dairy')) AS t(i_id, i_name, i_cat))
TO 'test_files/scratch/equivalence_properties/items.csv'
STORED AS CSV
OPTIONS ('format.has_header' 'true');
----
3

query I
COPY (SELECT * FROM (VALUES (1, 1, 5), (1, 2, 3), (2, 1, 7), (2, 3, 1), (3, 2, 4)) AS t(s_item, s_day, s_qty))
TO 'test_files/scratch/equivalence_properties/sales.csv'
STORED AS CSV
OPTIONS ('format.has_header' 'true');
----
5

statement ok
CREATE EXTERNAL TABLE items (i_id INT, i_name VARCHAR, i_cat VARCHAR, PRIMARY KEY (i_id))
STORED AS CSV
WITH ORDER (i_id ASC)
LOCATION 'test_files/scratch/equivalence_properties/items.csv'
OPTIONS ('format.has_header' 'true');

statement ok
CREATE EXTERNAL TABLE items_no_key (i_id INT, i_name VARCHAR, i_cat VARCHAR)
STORED AS CSV
WITH ORDER (i_id ASC)
LOCATION 'test_files/scratch/equivalence_properties/items.csv'
OPTIONS ('format.has_header' 'true');

statement ok
CREATE EXTERNAL TABLE sales (s_item INT, s_day INT, s_qty INT)
STORED AS CSV
WITH ORDER (s_item ASC, s_day ASC)
LOCATION 'test_files/scratch/equivalence_properties/sales.csv'
OPTIONS ('format.has_header' 'true');

# ORDER BY needs no sort: the input is sorted by [s_item, s_day], and i_name
# has one value for each s_item.
query TT
EXPLAIN SELECT s_item, i_name, s_day FROM items JOIN sales ON s_item = i_id
ORDER BY s_item, i_name, s_day;
----
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(i_id@0, s_item@0)], projection=[s_item@2, i_name@1, s_day@3]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/items.csv]]}, projection=[i_id, i_name], output_ordering=[i_id@0 ASC NULLS LAST], constraints=[PrimaryKey([0])], file_type=csv, has_header=true
03)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/sales.csv]]}, projection=[s_item, s_day], output_ordering=[s_item@0 ASC NULLS LAST, s_day@1 ASC NULLS LAST], file_type=csv, has_header=true

query ITI
SELECT s_item, i_name, s_day FROM items JOIN sales ON s_item = i_id
ORDER BY s_item, i_name, s_day;
----
1 apple 1
1 apple 2
2 bread 1
2 bread 3
3 cheese 2

# Without the primary key, i_name is not determined by s_item, and the sort stays.
query TT
EXPLAIN SELECT s_item, i_name, s_day FROM items_no_key JOIN sales ON s_item = i_id
ORDER BY s_item, i_name, s_day;
----
physical_plan
01)SortExec: expr=[s_item@0 ASC NULLS LAST, i_name@1 ASC NULLS LAST, s_day@2 ASC NULLS LAST], preserve_partitioning=[false]
02)--HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(i_id@0, s_item@0)], projection=[s_item@2, i_name@1, s_day@3]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/items.csv]]}, projection=[i_id, i_name], output_ordering=[i_id@0 ASC NULLS LAST], file_type=csv, has_header=true
04)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/sales.csv]]}, projection=[s_item, s_day], output_ordering=[s_item@0 ASC NULLS LAST, s_day@1 ASC NULLS LAST], file_type=csv, has_header=true

# A GROUP BY on s_item and i_name still sees its input clustered on s_item.
query TT
EXPLAIN SELECT s_item, i_name, sum(s_qty) FROM items JOIN sales ON s_item = i_id
GROUP BY s_item, i_name;
----
physical_plan
01)AggregateExec: mode=Single, gby=[s_item@1 as s_item, i_name@0 as i_name], aggr=[sum(sales.s_qty)], group_clustering_mode=Full
02)--HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(i_id@0, s_item@0)], projection=[i_name@1, s_item@2, s_qty@3]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/items.csv]]}, projection=[i_id, i_name], output_ordering=[i_id@0 ASC NULLS LAST], constraints=[PrimaryKey([0])], file_type=csv, has_header=true
04)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/sales.csv]]}, projection=[s_item, s_qty], output_ordering=[s_item@0 ASC NULLS LAST], file_type=csv, has_header=true

query ITI
SELECT s_item, i_name, sum(s_qty) FROM items JOIN sales ON s_item = i_id
GROUP BY s_item, i_name ORDER BY s_item;
----
1 apple 8
2 bread 8
3 cheese 4

# PARTITION BY s_item, i_name needs no sort.
query TT
EXPLAIN SELECT s_item, i_name, s_day, sum(s_qty) OVER (PARTITION BY s_item, i_name ORDER BY s_day)
FROM items JOIN sales ON s_item = i_id;
----
physical_plan
01)ProjectionExec: expr=[s_item@1 as s_item, i_name@0 as i_name, s_day@2 as s_day, sum(sales.s_qty) PARTITION BY [sales.s_item, items.i_name] ORDER BY [sales.s_day ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@4 as sum(sales.s_qty) PARTITION BY [sales.s_item, items.i_name] ORDER BY [sales.s_day ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]
02)--BoundedWindowAggExec: wdw=[sum(sales.s_qty) PARTITION BY [sales.s_item, items.i_name] ORDER BY [sales.s_day ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "sum(sales.s_qty) PARTITION BY [sales.s_item, items.i_name] ORDER BY [sales.s_day ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": nullable Int64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
03)----HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(i_id@0, s_item@0)], projection=[i_name@1, s_item@2, s_day@3, s_qty@4]
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/items.csv]]}, projection=[i_id, i_name], output_ordering=[i_id@0 ASC NULLS LAST], constraints=[PrimaryKey([0])], file_type=csv, has_header=true
05)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/equivalence_properties/sales.csv]]}, projection=[s_item, s_day, s_qty], output_ordering=[s_item@0 ASC NULLS LAST, s_day@1 ASC NULLS LAST], file_type=csv, has_header=true

query ITII
SELECT s_item, i_name, s_day, sum(s_qty) OVER (PARTITION BY s_item, i_name ORDER BY s_day)
FROM items JOIN sales ON s_item = i_id ORDER BY s_item, s_day;
----
1 apple 1 5
1 apple 2 8
2 bread 1 7
2 bread 3 8
3 cheese 2 4

statement ok
DROP TABLE sales;

statement ok
DROP TABLE items_no_key;

statement ok
DROP TABLE items;

statement ok
set datafusion.execution.target_partitions = 4;

###
### Functions whose ordering cannot be derived from their input
###

# sqrt has no ordering that can be derived from c, because c may be negative.
# The inner ORDER BY still makes the subquery sorted by sqrt(c), so the
# window's ORDER BY sqrt(c) needs no second sort.
query TT
EXPLAIN SELECT c, row_number() OVER (ORDER BY sqrt(c)) FROM (SELECT c FROM t ORDER BY sqrt(c) LIMIT 5);
----
physical_plan
01)BoundedWindowAggExec: wdw=[row_number() ORDER BY [sqrt(t.c) ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "row_number() ORDER BY [sqrt(t.c) ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": UInt64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
02)--SortExec: TopK(fetch=5), expr=[sqrt(CAST(c@0 AS Float64)) ASC NULLS LAST], preserve_partitioning=[false]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[c], output_ordering=[c@0 ASC NULLS LAST], file_type=csv, has_header=true

query II
SELECT c, row_number() OVER (ORDER BY sqrt(c)) FROM (SELECT c FROM t ORDER BY sqrt(c) LIMIT 5);
----
0 1
1 2
2 3
3 4
4 5

# -sqrt(c) is ordered opposite to sqrt(c), whose order is known only from the
# inner ORDER BY. So the window's ORDER BY -sqrt(c) needs no second sort.
query TT
EXPLAIN SELECT c, row_number() OVER (ORDER BY -sqrt(c)) FROM (SELECT c FROM t ORDER BY sqrt(c) DESC NULLS LAST LIMIT 5);
----
physical_plan
01)BoundedWindowAggExec: wdw=[row_number() ORDER BY [(- sqrt(t.c)) ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "row_number() ORDER BY [(- sqrt(t.c)) ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": UInt64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
02)--SortExec: TopK(fetch=5), expr=[sqrt(CAST(c@0 AS Float64)) DESC NULLS LAST], preserve_partitioning=[false]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[c], output_ordering=[c@0 ASC NULLS LAST], file_type=csv, has_header=true

query II
SELECT c, row_number() OVER (ORDER BY -sqrt(c)) FROM (SELECT c FROM t ORDER BY sqrt(c) DESC NULLS LAST LIMIT 5);
----
99 1
98 2
97 3
96 4
95 5

# On a table sorted by (a, b), the filter a = sqrt(b) would make it sorted by
# b alone too, if sqrt(b) were known to be increasing in b. That cannot be
# derived, because b may be negative, so no new ordering is found and the
# query runs.
statement ok
CREATE EXTERNAL TABLE t_double (a0 DOUBLE, a DOUBLE, b DOUBLE, c DOUBLE, d DOUBLE)
STORED AS CSV
WITH ORDER (a ASC, b ASC)
LOCATION '../core/tests/data/window_2.csv'
OPTIONS ('format.has_header' 'true');

query TT
EXPLAIN SELECT a, b FROM t_double WHERE a = sqrt(b);
----
physical_plan
01)FilterExec: a@0 = sqrt(b@1)
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, maintains_sort_order=true
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true

query I
SELECT count(*) FROM t_double WHERE a = sqrt(b);
----
25

statement ok
DROP TABLE t_double;

###
### Order-preserving repartition of an unbounded input
###

# x = CAST(a AS BIGINT) is strictly increasing in a. The order-preserving
# repartition on x merges on its input's order (a, b, c, then x), and its
# output must still be known to be sorted by x, b as well. So the window's
# PARTITION BY x ORDER BY b runs in sorted mode without a SortExec. A sort
# here would make planning fail, because the input is unbounded.
statement ok
set datafusion.execution.target_partitions = 2;

statement ok
CREATE UNBOUNDED EXTERNAL TABLE t_inf (a0 INTEGER, a INTEGER, b INTEGER, c INTEGER, d INTEGER)
STORED AS CSV
WITH ORDER (a ASC, b ASC, c ASC)
LOCATION '../core/tests/data/window_2.csv'
OPTIONS ('format.has_header' 'true');

query TT
EXPLAIN SELECT a, x, SUM(c) OVER (PARTITION BY x ORDER BY b) s
FROM (SELECT CAST(a AS BIGINT) x, a, b, c FROM t_inf);
----
physical_plan
01)ProjectionExec: expr=[a@1 as a, x@0 as x, sum(t_inf.c) PARTITION BY [x] ORDER BY [t_inf.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@4 as s]
02)--BoundedWindowAggExec: wdw=[sum(t_inf.c) PARTITION BY [x] ORDER BY [t_inf.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "sum(t_inf.c) PARTITION BY [x] ORDER BY [t_inf.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": nullable Int64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
03)----RepartitionExec: partitioning=Hash([x@0], 2), input_partitions=2, preserve_order=true, sort_exprs=a@1 ASC NULLS LAST, b@2 ASC NULLS LAST, c@3 ASC NULLS LAST, x@0 ASC NULLS LAST
04)------ProjectionExec: expr=[CAST(a@0 AS Int64) as x, a@0 as a, b@1 as b, c@2 as c]
05)--------RepartitionExec: partitioning=RoundRobinBatch(2), input_partitions=1, maintains_sort_order=true
06)----------StreamingTableExec: partition_sizes=1, projection=[a, b, c], infinite_source=true, output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST, c@2 ASC NULLS LAST]

# Strictly increasing functions also retain their derived ordering after merging.
query TT
EXPLAIN SELECT a, x, SUM(c) OVER (PARTITION BY x ORDER BY b) s
FROM (SELECT to_unixtime(a) x, a, b, c FROM t_inf);
----
