include ./init_data.slt.part

# --------------------------------------
# Setup test tables with different physical string types
# and repeat tests in `string_query.slt.part`
# --------------------------------------
statement ok
create table test_basic_operator as
select
    arrow_cast(column1, 'Dictionary(Int32, Utf8)') as ascii_1,
    arrow_cast(column2, 'Dictionary(Int32, Utf8)') as ascii_2,
    arrow_cast(column3, 'Dictionary(Int32, Utf8)') as unicode_1,
    arrow_cast(column4, 'Dictionary(Int32, Utf8)') as unicode_2
from test_source;

statement ok
create table test_substr as
select arrow_cast(col1, 'Dictionary(Int32, Utf8)') as c1 from test_substr_base;

statement ok
create table test_datetime as
select
  arrow_cast(column1, 'Dictionary(Int32, Utf8)') as ts,
  arrow_cast(column2, 'Dictionary(Int32, Utf8)') as d,
  arrow_cast(column3, 'Dictionary(Int32, Utf8)') as t
from test_datetime_base;


statement ok
drop table test_source

query T
SELECT arrow_cast('', 'Dictionary(Int32, Utf8)');
----
(empty)


#
# common test for string-like functions and operators
#
include ./string_query.slt.part

# Scalar start/length preserves dict encoding end-to-end.
query T
SELECT DISTINCT arrow_typeof(substr(c1, 1, 3)) FROM test_substr;
----
Dictionary(Int32, Utf8)

# Runtime scalars that are not literals must agree with the planned return type.
query TT
SELECT substr(c1, (SELECT 2)), arrow_typeof(substr(c1, (SELECT 2)))
FROM test_substr
WHERE c1 = 'foo';
----
oo Dictionary(Int32, Utf8)

# Scalar dictionary input must use the same dictionary-aware dispatch as arrays.
query TT
SELECT
  substr(arrow_cast('hello', 'Dictionary(Int32, Utf8)'), 1, 3),
  arrow_typeof(substr(arrow_cast('hello', 'Dictionary(Int32, Utf8)'), 1, 3));
----
hel Dictionary(Int32, Utf8)

statement ok
create table test_substr_arguments (
  c VARCHAR NOT NULL,
  start_pos BIGINT,
  length BIGINT
);

statement ok
insert into test_substr_arguments values
  ('hello', 1, 2),
  ('world', NULL, 3),
  ('arrow', 2, NULL);

# Nullable per-row arguments propagate nulls without changing dictionary encoding.
query TTT
SELECT
  substr(c, start_pos),
  substr(arrow_cast(c, 'Dictionary(Int32, Utf8)'), start_pos),
  substr(arrow_cast(c, 'Dictionary(Int32, Utf8)'), 1, length)
FROM test_substr_arguments
ORDER BY c;
----
rrow rrow NULL
hello hello he
NULL NULL wor

query TT
SELECT DISTINCT
  arrow_typeof(substr(arrow_cast(c, 'Dictionary(Int32, Utf8)'), start_pos)),
  arrow_typeof(substr(arrow_cast(c, 'Dictionary(Int32, Utf8)'), 1, length))
FROM test_substr_arguments;
----
Dictionary(Int32, Utf8) Dictionary(Int32, Utf8)

#
# Clean up
#
statement ok
drop table test_basic_operator;

statement ok
drop table test_substr_base;

statement ok
drop table test_datetime_base;

statement ok
drop table test_substr_arguments;
