# A struct field can be NULL when the struct column itself is not
# nullable. A row group is fully matched only if the field has no nulls.
statement ok
COPY (SELECT named_struct('a', column1) AS s, column2 AS id FROM (VALUES (1, 1), (CAST(NULL AS INT), 2), (3, 3)))
TO 'test_files/scratch/parquet_struct_field_pruning/full_match/f.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE full_match STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_struct_field_pruning/full_match/f.parquet';

statement ok
set datafusion.execution.parquet.pushdown_filters = true;

query I
SELECT id FROM full_match WHERE s['a'] <= 5 ORDER BY id;
----
1
3

statement ok
set datafusion.execution.parquet.pushdown_filters = false;
