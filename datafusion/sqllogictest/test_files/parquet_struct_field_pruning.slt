# Row group pruning with statistics for predicates on struct fields
# (`get_field(s, 'a')`, written `s['a']`).

statement ok
CREATE TABLE src AS VALUES
-- ***** Row Group 0: a in [1, 3] *****
  (1, 100),
  (2, 200),
  (3, 300),
-- ***** Row Group 1: a in [10, 12] *****
  (10, 100),
  (11, 200),
  (12, 300),
-- ***** Row Group 2: null struct, a = 20, null a *****
  (NULL, NULL),
  (20, 400),
  (-1, 500),
-- ***** Row Group 3: a in [30, 32] *****
  (30, 100),
  (31, 200),
  (32, 300);

# Row 7 (column1 = NULL) is a null struct. Row 9 (column1 = -1) is a non-null
# struct with a null `a`.
statement ok
COPY (
  SELECT
    CASE
      WHEN column1 IS NULL THEN NULL
      WHEN column1 = -1 THEN named_struct('a', CAST(NULL AS INT), 'b', column2)
      ELSE named_struct('a', column1, 'b', column2)
    END AS s,
    column1 AS id
  FROM src
)
TO 'test_files/scratch/parquet_struct_field_pruning/data.parquet'
STORED AS PARQUET
OPTIONS ('format.max_row_group_size' '3');

statement ok
DROP TABLE src;

statement ok
CREATE EXTERNAL TABLE t
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_struct_field_pruning/data.parquet';

statement ok
set datafusion.explain.analyze_level = summary;

statement ok
set datafusion.explain.analyze_categories = 'rows';

# Results are correct.
query ?I rowsort
SELECT s, id FROM t WHERE s['a'] > 15;
----
{a: 20, b: 400} 20
{a: 30, b: 100} 30
{a: 31, b: 200} 31
{a: 32, b: 300} 32

query I rowsort
SELECT id FROM t WHERE s['a'] IS NULL;
----
-1
NULL

# Row groups 0 and 1 are pruned.
query TT
EXPLAIN ANALYZE SELECT * FROM t WHERE s['a'] > 15;
----
Plan with Metrics
01)FilterExec: __datafusion_extracted_1@0 > 15, projection=[s@1, id@2], metrics=[output_rows=4, selectivity=66.67% (4/6)]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, metrics=[output_rows=6]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/data.parquet]]}, projection=[get_field(s@0, a) as __datafusion_extracted_1, s, id], file_type=parquet, predicate=get_field(s@0, a) > 15, pruning_predicate=s.a_null_count@1 != row_count@2 AND s.a_max@0 > 15, required_guarantees=[], metrics=[output_rows=6, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=4 total → 2 matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=13.43% (452/3.37 K)]

