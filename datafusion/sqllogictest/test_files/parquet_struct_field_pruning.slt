02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/topk.parquet]]}, projection=[get_field(s@0, a) as topk.s[a]], file_type=parquet, predicate=DynamicFilter [ get_field(s@0, a) IS NULL OR get_field(s@0, a) > 12 ], dynamic_rg_pruning=eligible, metrics=[output_rows=3, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=5 total → 5 matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, row_groups_pruned_dynamic_filter=0, scan_efficiency_ratio=14.08% (387/2.75 K)]

statement ok
reset datafusion.execution.parquet.pushdown_filters;

statement ok
set datafusion.execution.target_partitions = 4;

statement ok
set datafusion.explain.analyze_categories = 'rows';

statement ok
DROP TABLE topk;

# Struct type drift: the file stores `s.a` as INT, the table declares
# DOUBLE. The schema adapter rewrites `s['a']` to
# `CAST(get_field(s, 'a') AS DOUBLE)` for this file. Comparing with 6.5
# keeps the cast, because 6.5 has no INT equivalent.
statement ok
COPY (SELECT named_struct('a', CAST(value AS INT)) AS s FROM generate_series(0, 8))
TO 'test_files/scratch/parquet_struct_field_pruning/drift/data.parquet'
STORED AS PARQUET
OPTIONS ('format.max_row_group_size' '3');

statement ok
CREATE EXTERNAL TABLE drift (s STRUCT<a DOUBLE>)
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_struct_field_pruning/drift/';

query R
SELECT s['a'] FROM drift WHERE s['a'] > 6.5 ORDER BY s['a'];
----
7
8

# Row groups 0 and 1 (`a` in [0, 5]) can be pruned.
query TT
EXPLAIN ANALYZE SELECT * FROM drift WHERE s['a'] > 6.5;
----
Plan with Metrics
01)FilterExec: __datafusion_extracted_1@0 > 6.5, projection=[s@1], metrics=[output_rows=2, selectivity=22.22% (2/9)]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, metrics=[output_rows=9]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/drift/data.parquet]]}, projection=[get_field(s@0, a) as __datafusion_extracted_1, s], file_type=parquet, predicate=get_field(s@0, a) > 6.5, metrics=[output_rows=9, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=3 total → 3 matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=21.39% (213/996)]

statement ok
DROP TABLE drift;

# Hash join dynamic filter. The build side `u` has ids 0, 5000 and 9999, so
# its bounds [0, 9999] cover all 10 row groups of `hj`, but its key bitmap
# only reaches row groups 0, 5 and 9. A hash-lookup filter (forced by an
# IN-list limit of 0) carries that bitmap to the probe-side scan.
statement ok
COPY (SELECT named_struct('a', value) AS s, value AS v FROM generate_series(0, 9999) ORDER BY value)
TO 'test_files/scratch/parquet_struct_field_pruning/hj.parquet'
STORED AS PARQUET
OPTIONS ('format.max_row_group_size' '1000');

statement ok
CREATE EXTERNAL TABLE hj
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_struct_field_pruning/hj.parquet';

statement ok
CREATE TABLE u(id BIGINT) AS VALUES (0), (5000), (9999);

statement ok
set datafusion.execution.target_partitions = 1;

statement ok
set datafusion.optimizer.hash_join_inlist_pushdown_max_size = 0;

statement ok
set datafusion.optimizer.hash_join_inlist_pushdown_max_distinct_values = 0;

query I
SELECT hj.v FROM u JOIN hj ON hj.s['a'] = u.id ORDER BY hj.v;
----
0
5000
9999

# The same join on a plain column, for comparison.
query TT
EXPLAIN ANALYZE SELECT hj.v FROM u JOIN hj ON hj.v = u.id;
----
