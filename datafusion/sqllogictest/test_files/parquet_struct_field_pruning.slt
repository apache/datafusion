02)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]
03)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/hj.parquet]]}, projection=[v], output_ordering=[v@0 ASC NULLS LAST], file_type=parquet, predicate=DynamicFilter [ v@1 >= 0 AND v@1 <= 9999 AND hash_lookup ], dynamic_rg_pruning=eligible, pruning_predicate=v_null_count@1 != row_count@2 AND v_max@0 >= 0 AND v_null_count@1 != row_count@2 AND v_min@3 <= 9999 AND v_null_count@1 != row_count@2 AND KEY_RANGE_BITMAP(v_min@3, v_max@0, 3/16384 buckets), required_guarantees=[], metrics=[output_rows=3.00 K, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=10 total → 3 matched, page_index_pages_pruned=3 total → 3 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=14.55% (7.59 K/52.19 K)]

