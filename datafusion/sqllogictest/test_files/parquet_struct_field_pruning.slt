02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, metrics=[output_rows=12]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/data.parquet]]}, projection=[get_field(s@0, a) as __datafusion_extracted_1, get_field(s@0, b) as __datafusion_extracted_2, s, id], file_type=parquet, predicate=get_field(s@0, b) < get_field(s@0, a), metrics=[output_rows=12, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=4 total → 4 matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=27.52% (926/3.37 K)]

# A struct field combined with a plain column in OR.
query TT
EXPLAIN ANALYZE SELECT * FROM t WHERE s['a'] > 25 OR id < 2;
----
Plan with Metrics
01)FilterExec: __datafusion_extracted_1@0 > 25 OR id@2 < 2, projection=[s@1, id@2], metrics=[output_rows=5, selectivity=55.56% (5/9)]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, metrics=[output_rows=9]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/data.parquet]]}, projection=[get_field(s@0, a) as __datafusion_extracted_1, s, id], file_type=parquet, predicate=get_field(s@0, a) > 25 OR id@1 < 2, pruning_predicate=s.a_null_count@1 != row_count@2 AND s.a_max@0 > 25 OR id_null_count@4 != row_count@2 AND id_min@3 < 2, required_guarantees=[], metrics=[output_rows=9, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=4 total → 3 matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=20.48% (689/3.37 K)]

statement ok
DROP TABLE t;

# Two files with one row group each. The row group of the file with
# `a` in [30, 32] is pruned by statistics, so the scan reads no data pages
# from it. File-level pruning (`files_ranges_pruned_statistics`) is not
# covered: it reads `Statistics`, which has no struct field statistics.
statement ok
COPY (SELECT named_struct('a', column1) AS s FROM (VALUES (1), (2), (3)))
TO 'test_files/scratch/parquet_struct_field_pruning/two_files/low.parquet'
STORED AS PARQUET;

statement ok
COPY (SELECT named_struct('a', column1) AS s FROM (VALUES (30), (31), (32)))
TO 'test_files/scratch/parquet_struct_field_pruning/two_files/high.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE two_files
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_struct_field_pruning/two_files/';

query ?
SELECT s FROM two_files WHERE s['a'] < 10 ORDER BY s['a'];
----
{a: 1}
{a: 2}
{a: 3}

query TT
EXPLAIN ANALYZE SELECT * FROM two_files WHERE s['a'] < 10;
----
Plan with Metrics
01)FilterExec: __datafusion_extracted_1@0 < 10, projection=[s@1], metrics=[output_rows=3, selectivity=100% (3/3)]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=2, metrics=[output_rows=3]
03)----DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/two_files/high.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/two_files/low.parquet]]}, projection=[get_field(s@0, a) as __datafusion_extracted_1, s], file_type=parquet, predicate=get_field(s@0, a) < 10, pruning_predicate=s.a_null_count@1 != row_count@2 AND s.a_min@0 < 10, required_guarantees=[], metrics=[output_rows=3, files_ranges_pruned_statistics=2 total → 2 matched, row_groups_pruned_statistics=2 total → 1 matched -> 1 fully matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=13.34% (79/592)]

statement ok
DROP TABLE two_files;

# One row group with 10 pages of 10 rows each. Page i holds `a` in
# [10 * i, 10 * i + 9], so `s['a'] >= 85` can skip 8 of the 10 pages.
statement ok
COPY (SELECT named_struct('a', value) AS s FROM generate_series(0, 99))
TO 'test_files/scratch/parquet_struct_field_pruning/pages.parquet'
STORED AS PARQUET
OPTIONS (
  'format.max_row_group_size' '100',
  'format.data_page_row_count_limit' '10',
  'format.write_batch_size' '10'
);

statement ok
CREATE EXTERNAL TABLE pages
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_struct_field_pruning/pages.parquet';

query I
SELECT count(*) FROM pages WHERE s['a'] >= 85;
----
15

query TT
EXPLAIN ANALYZE SELECT * FROM pages WHERE s['a'] >= 85;
----
Plan with Metrics
01)FilterExec: __datafusion_extracted_1@0 >= 85, projection=[s@1], metrics=[output_rows=15, selectivity=15% (15/100)]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1, metrics=[output_rows=100]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_struct_field_pruning/pages.parquet]]}, projection=[get_field(s@0, a) as __datafusion_extracted_1, s], file_type=parquet, predicate=get_field(s@0, a) >= 85, pruning_predicate=s.a_null_count@1 != row_count@2 AND s.a_max@0 >= 85, required_guarantees=[], metrics=[output_rows=100, files_ranges_pruned_statistics=1 total → 1 matched, row_groups_pruned_statistics=1 total → 1 matched, page_index_pages_pruned=0 total → 0 matched, limit_pruned_row_groups=0 total → 0 matched, scan_efficiency_ratio=43.97% (624/1.42 K)]

statement ok
