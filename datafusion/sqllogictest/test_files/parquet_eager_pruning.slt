DROP TABLE t;

######
# Bloom filters
######

statement ok
set datafusion.execution.parquet.eager_pruning = 'bloom_filters';

statement ok
CREATE EXTERNAL TABLE t
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_eager_pruning/t/';

# 's5005' is within the min/max range of every row group, but absent
query TT
EXPLAIN SELECT a FROM t WHERE s = 's5005';
----
physical_plan
01)FilterExec: s@1 = s5005, projection=[a@0], statistics=[Rows=Inexact(0), Bytes=Inexact(0), [(Col[0]:)]]
02)--DataSourceExec: file_groups={1 group: [[]]}, projection=[a, s], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet, predicate=s@1 = s5005, pruning_predicate=s_null_count@2 != row_count@3 AND s_min@0 <= s5005 AND s5005 <= s_max@1, required_guarantees=[s in (s5005)], eager_pruning=[level=bloom_filters, files_pruned=1/1, row_groups_pruned=10/10, rows_pruned=1000/1000], statistics=[Rows=Inexact(0), Bytes=Inexact(0), [(Col[0]:),(Col[1]:)]]

query I
SELECT count(*) FROM t WHERE s = 's5005';
----
0

query I
SELECT count(*) FROM t WHERE s = 's500';
----
1

statement ok
DROP TABLE t;

######
# Scans with more files than eager_pruning_file_limit are not pruned
######

statement ok
set datafusion.execution.parquet.eager_pruning_file_limit = 0;

statement ok
CREATE EXTERNAL TABLE t
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_eager_pruning/t/';

query TT
EXPLAIN SELECT a FROM t WHERE a < 150;
----
physical_plan
01)FilterExec: a@0 < 150, statistics=[Rows=Inexact(150), Bytes=Inexact(1200), [(Col[0]: Min=Inexact(Int64(0)) Max=Inexact(Int64(149)) Null=Exact(0) ScanBytes=Inexact(1200))]]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_eager_pruning/t/0.parquet]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet, predicate=a@0 < 150, pruning_predicate=a_null_count@1 != row_count@2 AND a_min@0 < 150, required_guarantees=[], eager_pruning=[level=bloom_filters, skipped=1 files exceed eager_pruning_file_limit 0], statistics=[Rows=Inexact(1000), Bytes=Inexact(8000), [(Col[0]: Min=Inexact(Int64(0)) Max=Inexact(Int64(999)) Null=Inexact(0) ScanBytes=Inexact(8000))]]

statement ok
DROP TABLE t;

statement ok
reset datafusion.execution.parquet.eager_pruning_file_limit;

statement ok
reset datafusion.execution.parquet.eager_pruning;

######
# Eager pruning can be enabled for a single table
######

statement ok
CREATE EXTERNAL TABLE t
STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_eager_pruning/t/'
OPTIONS ('format.eager_pruning' 'row_groups');

query TT
EXPLAIN SELECT a FROM t WHERE a < 150;
----
physical_plan
01)FilterExec: a@0 < 150, statistics=[Rows=Inexact(150), Bytes=Inexact(1200), [(Col[0]: Min=Inexact(Int64(0)) Max=Inexact(Int64(149)) Null=Exact(0) ScanBytes=Inexact(1200))]]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_eager_pruning/t/0.parquet]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet, predicate=a@0 < 150, pruning_predicate=a_null_count@1 != row_count@2 AND a_min@0 < 150, required_guarantees=[], eager_pruning=[level=row_groups, files_pruned=0/1, row_groups_pruned=8/10, rows_pruned=800/1000], statistics=[Rows=Inexact(200), Bytes=Inexact(1600), [(Col[0]: Min=Inexact(Int64(0)) Max=Inexact(Int64(199)) Null=Inexact(0) ScanBytes=Inexact(1600))]]

statement ok
DROP TABLE t;

######
# Invalid values
######

statement error Invalid eager parquet pruning level: full\. Expected one of: disabled, row_groups, page_index, bloom_filters
set datafusion.execution.parquet.eager_pruning = 'full';

statement ok
set datafusion.explain.show_statistics = false;

statement ok
set datafusion.explain.physical_plan_only = false;

# The SLT runner sets `target_partitions` to 4
statement ok
set datafusion.execution.target_partitions = 4;
