02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_eager_pruning/t/0.parquet]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet, predicate=a@0 = 123, pruning_predicate=a_null_count@2 != row_count@3 AND a_min@0 <= 123 AND 123 <= a_max@1, required_guarantees=[a in (123)], eager_pruning=[level=page_index, files_pruned=0/1, row_groups_pruned=9/10, rows_pruned=990/1000], statistics=[Rows=Inexact(10), Bytes=Inexact(80), [(Col[0]: Min=Inexact(Int64(100)) Max=Inexact(Int64(199)) Null=Inexact(0) ScanBytes=Inexact(80))]]

