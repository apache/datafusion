# Every family: how many rows it compared and how many differ from the oracle

statement ok
CREATE VIEW checks AS
SELECT name, count(*) AS n, count(*) FILTER (WHERE bad) AS mismatches FROM (
  SELECT 'rows_moving' AS name, (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mn IS DISTINCT FROM o.mn OR w.mx IS DISTINCT FROM o.mx OR w.av IS DISTINCT FROM o.av OR w.sf IS DISTINCT FROM o.sf OR w.af IS DISTINCT FROM o.af OR w.cf IS DISTINCT FROM o.cf) AS bad
  FROM rows_moving_w w JOIN rows_moving_o o ON w.id = o.id
  UNION ALL
  SELECT 'rows_following', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mn IS DISTINCT FROM o.mn OR w.mxf IS DISTINCT FROM o.mxf)
  FROM rows_following_w w JOIN rows_following_o o ON w.id = o.id
  UNION ALL
  SELECT 'rows_preceding', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mx IS DISTINCT FROM o.mx OR w.sf IS DISTINCT FROM o.sf)
  FROM rows_preceding_w w JOIN rows_preceding_o o ON w.id = o.id
  UNION ALL
  SELECT 'rows_running', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mx IS DISTINCT FROM o.mx OR w.af IS DISTINCT FROM o.af)
  FROM rows_running_w w JOIN rows_running_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_offset', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mn IS DISTINCT FROM o.mn OR w.mx IS DISTINCT FROM o.mx OR w.af IS DISTINCT FROM o.af)
  FROM range_offset_w w JOIN range_offset_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_desc', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mn IS DISTINCT FROM o.mn OR w.mx IS DISTINCT FROM o.mx)
  FROM range_desc_w w JOIN range_desc_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_peers', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mxf IS DISTINCT FROM o.mxf)
  FROM range_peers_w w JOIN range_peers_o o ON w.id = o.id
  UNION ALL
  SELECT 'default_frame', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c OR w.mn IS DISTINCT FROM o.mn OR w.af IS DISTINCT FROM o.af)
  FROM default_frame_w w JOIN default_frame_o o ON w.id = o.id
  UNION ALL
  SELECT 'ranks', (w.r IS DISTINCT FROM o.r OR w.dr IS DISTINCT FROM o.dr OR w.pr IS DISTINCT FROM o.pr OR w.cd IS DISTINCT FROM o.cd OR w.rn IS DISTINCT FROM o.rn)
  FROM ranks_w w JOIN ranks_o o ON w.id = o.id
  UNION ALL
  SELECT 'lag_lead', (w.l1 IS DISTINCT FROM o.l1 OR w.l2 IS DISTINCT FROM o.l2 OR w.d1 IS DISTINCT FROM o.d1 OR w.d3 IS DISTINCT FROM o.d3 OR w.lf IS DISTINCT FROM o.lf)
  FROM lag_lead_w w JOIN lag_lead_o o ON w.id = o.id
  UNION ALL
  SELECT 'lag_lead_str', (w.l1 IS DISTINCT FROM o.l1 OR w.l2 IS DISTINCT FROM o.l2 OR w.d1 IS DISTINCT FROM o.d1 OR w.d3 IS DISTINCT FROM o.d3 OR w.dl1 IS DISTINCT FROM o.dl1 OR w.dd2 IS DISTINCT FROM o.dd2)
  FROM lag_lead_str_w w JOIN lag_lead_str_o o ON w.id = o.id
  UNION ALL
  SELECT 'first_last', (w.fv IS DISTINCT FROM o.fv OR w.lv IS DISTINCT FROM o.lv OR w.fp IS DISTINCT FROM o.fp)
  FROM first_last_w w JOIN first_last_o o ON w.id = o.id
  UNION ALL
  SELECT 'filter', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c)
  FROM filter_w w JOIN filter_o o ON w.id = o.id
  UNION ALL
  SELECT 'groups', (w.gs IS DISTINCT FROM o.gs OR w.gm IS DISTINCT FROM o.gm OR w.gt IS DISTINCT FROM o.gt)
  FROM groups_w w JOIN groups_o o ON w.id = o.id
  UNION ALL
  SELECT 'mixed', (w.s IS DISTINCT FROM o.s OR w.rn IS DISTINCT FROM o.rn OR w.l1 IS DISTINCT FROM o.l1 OR w.cg IS DISTINCT FROM o.cg OR w.mx IS DISTINCT FROM o.mx)
  FROM mixed_w w JOIN mixed_o o ON w.id = o.id
  UNION ALL
  SELECT 'string_key', (w.s IS DISTINCT FROM o.s OR w.rn IS DISTINCT FROM o.rn)
  FROM string_key_w w JOIN string_key_o o ON w.id = o.id
  UNION ALL
  SELECT 'null_key', (w.s IS DISTINCT FROM o.s OR w.c IS DISTINCT FROM o.c)
  FROM null_key_w w JOIN null_key_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_unsigned', (w.s1 IS DISTINCT FROM o.s1 OR w.m1 IS DISTINCT FROM o.m1 OR w.s2 IS DISTINCT FROM o.s2 OR w.m2 IS DISTINCT FROM o.m2)
  FROM range_unsigned_w w JOIN range_unsigned_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_signed', (w.s1 IS DISTINCT FROM o.s1 OR w.c1 IS DISTINCT FROM o.c1 OR w.s2 IS DISTINCT FROM o.s2 OR w.c2 IS DISTINCT FROM o.c2)
  FROM range_signed_w w JOIN range_signed_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_timestamp', (w.s1 IS DISTINCT FROM o.s1 OR w.c1 IS DISTINCT FROM o.c1 OR w.s2 IS DISTINCT FROM o.s2 OR w.c2 IS DISTINCT FROM o.c2)
  FROM range_timestamp_w w JOIN range_timestamp_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_nullable', (w.s1 IS DISTINCT FROM o.s1 OR w.c1 IS DISTINCT FROM o.c1 OR w.s2 IS DISTINCT FROM o.s2 OR w.c2 IS DISTINCT FROM o.c2 OR w.s3 IS DISTINCT FROM o.s3 OR w.c3 IS DISTINCT FROM o.c3 OR w.s4 IS DISTINCT FROM o.s4 OR w.c4 IS DISTINCT FROM o.c4)
  FROM range_nullable_w w JOIN range_nullable_o o ON w.id = o.id
  UNION ALL
  SELECT 'float_bits', (w.r IS DISTINCT FROM o.r)
  FROM float_bits_w w JOIN float_bits_o o ON w.id = o.id
  UNION ALL
  SELECT 'typed_moving', (w.r IS DISTINCT FROM o.r)
  FROM typed_moving_w w JOIN typed_moving_o o ON w.id = o.id
  UNION ALL
  SELECT 'typed_running', (w.r IS DISTINCT FROM o.r)
  FROM typed_running_w w JOIN typed_running_o o ON w.id = o.id
  UNION ALL
  SELECT 'ignore_nulls', (w.r IS DISTINCT FROM o.r)
  FROM ignore_nulls_w w JOIN ignore_nulls_o o ON w.id = o.id
  UNION ALL
  SELECT 'range_overflow_int8', (w.r IS DISTINCT FROM x.r)
  FROM ov_int8_w w JOIN ov_int8_x x ON w.id = x.id
  UNION ALL
  SELECT 'range_overflow_int64', (w.r IS DISTINCT FROM x.r)
  FROM ov_int64_w w JOIN ov_int64_x x ON w.id = x.id
  UNION ALL
  SELECT 'range_overflow_uint64', (w.r IS DISTINCT FROM x.r)
  FROM ov_uint64_w w JOIN ov_uint64_x x ON w.id = x.id
  UNION ALL
  SELECT 'range_overflow_timestamp', (w.r IS DISTINCT FROM x.r)
  FROM ov_timestamp_w w JOIN ov_timestamp_x x ON w.id = x.id
) AS compared
GROUP BY name;

###########
# Each family compares every row, and none differs, whatever the batch size
###########

query IIIT
SELECT count(*), sum(n), sum(mismatches), string_agg(name, ',' ORDER BY name) FILTER (WHERE mismatches > 0) FROM checks;
----
29 15140 0 NULL

# One row per batch: no run of complete partitions, every partition streams through

statement ok
set datafusion.execution.batch_size = 1;

query IIIT
SELECT count(*), sum(n), sum(mismatches), string_agg(name, ',' ORDER BY name) FILTER (WHERE mismatches > 0) FROM checks;
----
29 15140 0 NULL

# Batches that end inside partitions of every size

statement ok
