query IIIT
SELECT count(*), sum(n), sum(mismatches), string_agg(name, ',' ORDER BY name) FILTER (WHERE mismatches > 0) FROM checks;
----
29 15140 0 NULL

# A run of complete partitions in the first batch, with no open partition before it

statement ok
set datafusion.execution.batch_size = 50;

query IIIT
SELECT count(*), sum(n), sum(mismatches), string_agg(name, ',' ORDER BY name) FILTER (WHERE mismatches > 0) FROM checks;
----
29 15140 0 NULL

# Batches that start inside a partition and hold four or more complete partitions after it:
# the first rows complete the open partition, the run after them is evaluated in one call

statement ok
set datafusion.execution.batch_size = 70;

query IIIT
SELECT count(*), sum(n), sum(mismatches), string_agg(name, ',' ORDER BY name) FILTER (WHERE mismatches > 0) FROM checks;
