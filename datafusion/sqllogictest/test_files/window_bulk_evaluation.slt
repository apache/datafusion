###########
# Columns the window expressions do not read pass through unchanged
###########

# `wide` interleaves columns of several types between the ones the windows read

statement ok
CREATE VIEW wide AS
SELECT
  CAST(id AS VARCHAR) AS p1,
  id,
  CAST(id AS DECIMAL(12, 2)) / 8 AS p2,
  k,
  make_array(id, id + 1) AS p3,
  tie,
  CASE WHEN id % 7 = 0 THEN NULL ELSE named_struct('a', id, 'b', CAST(k AS VARCHAR)) END AS p4,
  ts,
  id % 3 = 0 AS p5,
  v,
  arrow_cast(id, 'Timestamp(Nanosecond, None)') AS p6,
  f,
  CASE WHEN id % 4 = 0 THEN NULL ELSE CAST(id AS VARCHAR) || '-' || CAST(k AS VARCHAR) END AS p7
FROM wb;

# The window functions read some of the columns; `wide_w` reads six of thirteen

statement ok
CREATE VIEW wide_w AS
SELECT *,
  sum(v) OVER (PARTITION BY k ORDER BY id ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS s,
  avg(f) OVER (PARTITION BY k ORDER BY id RANGE BETWEEN 4 PRECEDING AND 2 FOLLOWING) AS af,
  rank() OVER (PARTITION BY k ORDER BY tie) AS r,
  lag(v) OVER (PARTITION BY k ORDER BY id) AS l1,
  sum(v) FILTER (WHERE f IS NOT NULL) OVER (PARTITION BY k ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS fs
FROM wide;

# The same functions over the table that has nothing else

statement ok
CREATE VIEW narrow_w AS
SELECT id,
  sum(v) OVER (PARTITION BY k ORDER BY id ROWS BETWEEN 2 PRECEDING AND 1 FOLLOWING) AS s,
  avg(f) OVER (PARTITION BY k ORDER BY id RANGE BETWEEN 4 PRECEDING AND 2 FOLLOWING) AS af,
  rank() OVER (PARTITION BY k ORDER BY tie) AS r,
  lag(v) OVER (PARTITION BY k ORDER BY id) AS l1,
  sum(v) FILTER (WHERE f IS NOT NULL) OVER (PARTITION BY k ORDER BY id ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS fs
FROM wb;

statement ok
CREATE VIEW wide_checks AS
SELECT count(*) AS n,
  count(*) FILTER (WHERE x.s IS DISTINCT FROM y.s OR x.af IS DISTINCT FROM y.af OR x.r IS DISTINCT FROM y.r
                     OR x.l1 IS DISTINCT FROM y.l1 OR x.fs IS DISTINCT FROM y.fs) AS window_mismatches,
  count(*) FILTER (WHERE x.p1 IS DISTINCT FROM z.p1 OR x.p2 IS DISTINCT FROM z.p2 OR CAST(x.p3 AS VARCHAR) IS DISTINCT FROM CAST(z.p3 AS VARCHAR)
                     OR (x.p4 IS NULL) IS DISTINCT FROM (z.p4 IS NULL) OR x.p4['a'] IS DISTINCT FROM z.p4['a'] OR x.p4['b'] IS DISTINCT FROM z.p4['b'] OR x.p5 IS DISTINCT FROM z.p5 OR x.p6 IS DISTINCT FROM z.p6
                     OR x.p7 IS DISTINCT FROM z.p7 OR x.k IS DISTINCT FROM z.k OR x.tie IS DISTINCT FROM z.tie
                     OR x.ts IS DISTINCT FROM z.ts OR x.v IS DISTINCT FROM z.v OR x.f IS DISTINCT FROM z.f) AS passthrough_mismatches
FROM wide_w x JOIN narrow_w y ON x.id = y.id JOIN wide z ON x.id = z.id;

query III
SELECT * FROM wide_checks;
----
600 0 0

