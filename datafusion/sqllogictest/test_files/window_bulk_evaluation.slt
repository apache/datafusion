29 15140 0 NULL

# One batch for the whole table, and one batch less one row

statement ok
set datafusion.execution.batch_size = 599;

query IIIT
SELECT count(*), sum(n), sum(mismatches), string_agg(name, ',' ORDER BY name) FILTER (WHERE mismatches > 0) FROM checks;
