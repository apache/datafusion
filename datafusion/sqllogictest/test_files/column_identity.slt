##########
# Regression tests for bugs caused by identifying columns by name
# (qualifier + name) instead of by their column ids.
#
# Each block holds the correct result. Other regression tests of the column
# ids are in subquery.slt (#26573) and aggregates_topk.slt (#26691).
##########

##########
# #26621: GROUP BY CAST(a AS VARCHAR), a with a common subexpression
# before column ids: Optimizer rule 'optimize_projections' failed ... No field named t.a
# (the second variant panicked)
##########

statement ok
CREATE TABLE t26621 (a INT) AS VALUES (1);

query III
SELECT a, a + 1, (a + 1) * 2 FROM t26621 GROUP BY CAST(a AS VARCHAR), a;
----
1 2 4

# the second variant (before column ids: a panic or the schema error, depending on
# HashMap order)
query IIT
SELECT a, a + 1, COALESCE(min('x'), CAST(a AS VARCHAR)) FROM t26621 GROUP BY CAST(a AS VARCHAR), a;
----
1 2 x

##########
# #25837: LATERAL over a derived table whose alias differs from the table name
# before column ids: Schema error: No field named l.id
##########

statement ok
CREATE TABLE o25837 (k INT) AS VALUES (1), (2);

statement ok
CREATE TABLE l25837 (id INT, v INT) AS VALUES (1, 10), (2, 20);

query II
SELECT o25837.k, s.v
FROM o25837, LATERAL (
  SELECT l2.v FROM (SELECT * FROM l25837 WHERE l25837.id = o25837.k) AS l2
) AS s
ORDER BY o25837.k;
----
1 10
2 20

##########
# #26692: decorrelation loses correlated columns when a subquery contains
# two equal subplans
# before column ids: Q1 wrong rows (one row instead of two), Q2 No field named s.a,
# Q3 No field named l.a
##########

statement ok
CREATE TABLE t26692 (a INT, b INT) AS VALUES (1, 1), (2, 2);

statement ok
CREATE TABLE t2_26692 (a INT, b INT) AS VALUES (1, 1), (3, 30);

query I
SELECT t26692.a FROM t26692, t2_26692 AS s
WHERE EXISTS (
    SELECT 1 FROM (SELECT * FROM t2_26692 AS s WHERE s.a = t26692.a) x
    CROSS JOIN t2_26692 AS s
);
----
1
1

query I
SELECT t26692.a FROM t26692
WHERE EXISTS (
    SELECT 1 FROM (SELECT * FROM t2_26692 AS s WHERE s.a = t26692.a) x
    CROSS JOIN t2_26692 AS s
);
----
1

query I
SELECT t26692.a FROM t26692
WHERE EXISTS (
    SELECT 1 FROM (SELECT a FROM t2_26692 WHERE t2_26692.a = t26692.a) x
    CROSS JOIN LATERAL (SELECT b FROM t2_26692 WHERE t2_26692.b = x.a) l
);
----
1

##########
# #26033: correlated IN subquery whose column is cast
# before column ids: Schema error: No field named __correlated_sq_1.y (the
# issue reported "Projections require unique expression names"): the pulled
# up `i.y` was not added to the subquery's outputs, because the cast
# `CAST(i.y AS Int64)` is also named `i.y`
##########

statement ok
CREATE TABLE o26033 (k INT, b BIGINT) AS VALUES (1, 1), (2, 2), (3, 30);

statement ok
CREATE TABLE i26033 (y INT) AS VALUES (1), (2), (3);

query I
SELECT o26033.k FROM o26033
WHERE o26033.b IN (SELECT i26033.y FROM i26033 WHERE i26033.y = o26033.k)
ORDER BY o26033.k;
----
1
2

query I
SELECT o26033.k FROM o26033
WHERE o26033.b IN (SELECT CAST(i26033.y AS BIGINT) FROM i26033 WHERE i26033.y = o26033.k)
ORDER BY o26033.k;
----
1
2

# The projection branch of #26619 (push_down_filter), which #26033 masked
statement ok
CREATE TABLE t0_26619 (c0 BIGINT) AS VALUES (1);

statement ok
CREATE TABLE t1_26619 (c0 BIGINT) AS VALUES (0);

query I
SELECT c0 FROM t1_26619
WHERE '1' IN (SELECT CAST(t0_26619.c0 AS VARCHAR) FROM t0_26619 WHERE t0_26619.c0 > t1_26619.c0);
----
0

##########
# #26221: aggregates of x and CAST(x AS ...) share a name
# before column ids: duplicate unqualified field name "sum(t.x)" (aliased),
# Projections require unique expression names (unaliased)
##########

query RR
SELECT sum(x) AS a, sum(CAST(x AS FLOAT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
3 3

query II
SELECT count(x) AS a, count(CAST(x AS BIGINT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
2 2

query II
SELECT count(DISTINCT x) AS a, count(DISTINCT CAST(x AS BIGINT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
2 2

# unaliased form
query RR
SELECT sum(x), sum(CAST(x AS FLOAT)) FROM (VALUES (1.0), (2.0)) AS t(x);
----
3 3

# window form (no separate issue; before column ids: Windows require unique expression names)
query IR
SELECT sum(x) OVER () AS a, sum(CAST(x AS DOUBLE)) OVER () AS b FROM (VALUES (1), (2)) AS t(x);
----
3 3
3 3

##########
# #3353: approx_distinct(c) and approx_distinct(CAST(c AS VARCHAR)), aliased
# before column ids: duplicate unqualified field name "approx_distinct(t.c)"
##########

statement ok
CREATE TABLE t3353 (c BIGINT) AS SELECT value % 99 FROM generate_series(1, 100);

query II
SELECT approx_distinct(c) AS count_c, approx_distinct(CAST(c AS VARCHAR)) AS count_c_str FROM t3353;
----
99 99

##########
# #6543: two outputs with the same alias
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE t6543 (ts INT, inc_col INT) AS VALUES (1, 10), (2, 20);

query II
SELECT ts AS c1, inc_col AS c1 FROM t6543 ORDER BY ts;
----
1 10
2 20

##########
# #4478: SELECT a, CAST(a AS INT)
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE t4478 (a BIGINT) AS VALUES (1);

query II
SELECT a, CAST(a AS INT) FROM t4478;
----
1 1

##########
# #13558: SELECT CAST(col AS TEXT) ... ORDER BY col
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE foo13558 AS VALUES (1, 2), (3, 4), (5, 6);

query T
SELECT CAST(column1 AS TEXT) FROM foo13558 ORDER BY column1;
----
1
3
5

##########
# #26462: ORDER BY a source column when a select item is aliased to its name
# before column ids: Schema contains qualified field name e.email and unqualified field name email which would be ambiguous
##########

statement ok
CREATE TABLE employees26462 (id INT, email VARCHAR) AS VALUES (1, 'B@x'), (2, 'a@y');

query T
SELECT lower(e.email) AS email FROM employees26462 e ORDER BY e.email;
----
b@x
a@y

##########
# #25447: leaf extraction computes the same get_field twice in one projection
# before column ids: correct rows, but get_field(t.s, "a") was extracted under
# two generated names in the bottom projection
##########

statement ok
CREATE TABLE t25447 (v INT, s STRUCT<a INT, b INT>) AS VALUES (1, {a: 10, b: 1}), (2, {a: 20, b: 2});

statement ok
set datafusion.explain.logical_plan_only = true;

query TT
EXPLAIN SELECT s['a'] FROM (SELECT s, v FROM t25447 WHERE v > 0) WHERE s['a'] > 0;
----
logical_plan
01)Projection: t25447.s[a]
02)--Filter: t25447.v > Int32(0) AND t25447.s[a] > Int32(0)
03)----Projection: get_field(t25447.s, Utf8("a")), t25447.v
04)------TableScan: t25447 projection=[v, s]

statement ok
set datafusion.explain.logical_plan_only = false;

query I
SELECT s['a'] FROM (SELECT s, v FROM t25447 WHERE v > 0) WHERE s['a'] > 0 ORDER BY 1;
----
10
20

##########
# #26234: correlated subquery confuses same-named columns of two of its relations
# before column ids: wrong rows for all four queries (both pulled up
# references were renamed to the first `__correlated_sq_1.k`)
##########

statement ok
CREATE TABLE test26234 (k INT) AS VALUES (1), (2);

query I
SELECT o.k FROM test26234 o
WHERE EXISTS (SELECT 1 FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1);
----
1

query I
SELECT o.k FROM test26234 o
WHERE NOT EXISTS (SELECT 1 FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1);
----
2

query I
SELECT o.k FROM test26234 o
WHERE o.k IN (SELECT one.k FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1);
----
1

query II
SELECT o.k, (SELECT count(*) FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1) AS c
FROM test26234 o ORDER BY o.k;
----
1 1
2 0

##########
# #25024: NOT IN with an expression key under IS NULL (a null-aware mark join)
# before column ids: correct (`z`); a regression of the column ids gave
# `could not cast array of type Utf8View to ... BooleanArray`: the projection
# of the expression join key reused the id of the mark column
##########

statement ok
CREATE TABLE outer25024 (id VARCHAR NOT NULL) AS VALUES ('z');

statement ok
CREATE TABLE inner25024 (id VARCHAR NOT NULL) AS VALUES ('a');

query T
SELECT id FROM outer25024 WHERE (NULLIF(id, 'z') NOT IN (SELECT id FROM inner25024)) IS NULL;
----
z

##########
# #13476: SELECT ts, id, * repeats columns of the table
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE users13476 (id INT, name VARCHAR, ts INT) AS VALUES (1, 'a', 10), (2, 'b', 20);

query IIITI
SELECT ts, id, * FROM users13476 ORDER BY 2;
----
10 1 1 a 10
20 2 2 b 20

query ITII
SELECT *, id FROM users13476 ORDER BY 1;
----
1 a 10 1
2 b 20 2

##########
# #26620: two window functions share ORDER BY a + 1, one argument is constant folded
# before column ids: panic in debug builds (all window expressions shall have
# the same sort keys): CSE named the common `t.a + Int64(1)` differently in the
# two sort keys (`__common_expr_1` and `__common_expr_1 AS t.a + Int64(1)`)
##########

statement ok
CREATE TABLE t26620 (a BIGINT, b BIGINT) AS VALUES (1, 10), (2, 20);

query II rowsort
SELECT sum(1 + 1) OVER (ORDER BY a + 1), sum(b) OVER (ORDER BY a + 1) FROM t26620;
----
2 10
4 30

##########
# #15558: nested correlated subquery referencing a column two levels up
# before: Schema error: No field named e1.dept_id
# The conjunct `e2.dept_id = e1.dept_id` of the middle subquery lets the
# innermost one read `e2.dept_id` instead of `e1.dept_id` (matched by column
# id: the three levels read the same table). The plan is in subquery.slt.
##########

statement ok
CREATE TABLE employees15558 (employee_id INT, employee_name VARCHAR, dept_id INT, salary INT) AS VALUES
  (1, 'a', 1, 10), (2, 'b', 1, 20), (3, 'c', 1, 60),
  (4, 'd', 2, 10), (5, 'e', 2, 30);

query TI
SELECT e1.employee_name, e1.salary
FROM employees15558 e1
WHERE e1.salary >= (
    SELECT AVG(e2.salary)
    FROM employees15558 e2
    WHERE e2.dept_id = e1.dept_id
    AND e2.salary > (
        SELECT AVG(e3.salary)
        FROM employees15558 e3
        WHERE e3.dept_id = e1.dept_id
    )
)
ORDER BY 1;
----
c 60
e 30

# The same substitution for other subqueries, with NULL keys (results checked
# with SQLite)

statement ok
CREATE TABLE emp_2l (id INT, name VARCHAR, dept INT, sal INT) AS VALUES
  (1, 'a', 1, 10), (2, 'b', 1, 20), (3, 'c', 1, 60),
  (4, 'd', 2, 10), (5, 'e', 2, 30), (6, 'f', NULL, 50), (7, 'g', 2, NULL);

# an EXISTS in a scalar subquery
query II
SELECT e1.id, (
    SELECT count(*) FROM emp_2l e2 WHERE e2.dept = e1.dept AND EXISTS (
        SELECT 1 FROM emp_2l e3 WHERE e3.dept = e1.dept AND e3.sal > e2.sal
    )
) AS n
FROM emp_2l e1 ORDER BY 1;
----
1 2
2 2
3 2
4 1
5 1
6 0
7 1

# a NOT EXISTS in a scalar subquery
query I
SELECT e1.id FROM emp_2l e1 WHERE e1.sal > (
    SELECT min(e2.sal) FROM emp_2l e2 WHERE e2.dept = e1.dept AND NOT EXISTS (
        SELECT 1 FROM emp_2l e3 WHERE e3.dept = e1.dept AND e3.sal < e2.sal
    )
) ORDER BY 1;
----
2
3
5

# an IN in an EXISTS, where the middle subquery also reads `e1.id` itself
query I
SELECT e1.id FROM emp_2l e1 WHERE EXISTS (
    SELECT 1 FROM emp_2l e2 WHERE e1.dept = e2.dept AND e2.id <> e1.id AND e2.sal IN (
        SELECT e3.sal + 10 FROM emp_2l e3 WHERE e3.dept = e1.dept
    )
) ORDER BY 1;
----
1
3

##########
# #21727: grandparent column referenced only in a nested subquery
# before: Schema error: No field named t0.g
# With no equality to substitute through, the nested EXISTS becomes an inner
# join in the middle EXISTS (which only tells if it has a row), and `t0.g`
# one of its own outer references.
##########

statement ok
CREATE TABLE t0_21727 (g INT) AS VALUES (1), (2);

statement ok
CREATE TABLE t1_21727 (a INT) AS VALUES (10);

statement ok
CREATE TABLE t2_21727 (c INT) AS VALUES (1);

query I
SELECT g FROM t0_21727 WHERE EXISTS (
    SELECT 1 FROM t1_21727 WHERE EXISTS (
        SELECT 1 FROM t2_21727 WHERE t2_21727.c = t0_21727.g
    )
);
----
1

statement ok
set datafusion.explain.logical_plan_only = true;

query TT
EXPLAIN SELECT g FROM t0_21727 WHERE EXISTS (
    SELECT 1 FROM t1_21727 WHERE EXISTS (
        SELECT 1 FROM t2_21727 WHERE t2_21727.c = t0_21727.g
    )
);
----
logical_plan
01)LeftSemi Join: t0_21727.g = __correlated_sq_1.c
02)--TableScan: t0_21727 projection=[g]
03)--SubqueryAlias: __correlated_sq_1
04)----Cross Join:
05)------TableScan: t1_21727 projection=[]
06)------TableScan: t2_21727 projection=[c]

statement ok
set datafusion.explain.logical_plan_only = false;

# The same flattening for other subqueries, with NULLs and duplicates
# (results checked with SQLite)

statement ok
CREATE TABLE t0_2l (g INT) AS VALUES (1), (2), (3), (NULL);

statement ok
CREATE TABLE t1_2l (a INT, b INT) AS VALUES (10, 1), (20, 2), (30, NULL);

statement ok
CREATE TABLE t2_2l (c INT, d INT) AS VALUES (1, 10), (2, 20), (2, 21), (NULL, 30);

# an IN in an IN
query I
SELECT g FROM t0_2l WHERE g IN (
    SELECT b FROM t1_2l WHERE a IN (SELECT d FROM t2_2l WHERE t2_2l.c = t0_2l.g)
) ORDER BY g;
----
1
2

# an IN in a NOT IN: the middle subquery is empty for g = 3 and g = NULL
query I
SELECT g FROM t0_2l WHERE g NOT IN (
    SELECT b FROM t1_2l WHERE a IN (SELECT d FROM t2_2l WHERE t2_2l.c = t0_2l.g)
) ORDER BY g;
----
3
NULL

# an EXISTS in a NOT EXISTS
query I
SELECT g FROM t0_2l WHERE NOT EXISTS (
    SELECT 1 FROM t1_2l WHERE EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
) ORDER BY g;
----
3
NULL

# an EXISTS in an IN, reading a column one level up and one two levels up
query I
SELECT g FROM t0_2l WHERE g IN (
    SELECT b FROM t1_2l WHERE EXISTS (
        SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g AND t2_2l.d >= t1_2l.a
    )
) ORDER BY g;
----
1
2

# an EXISTS in an EXISTS in a projection (a mark join)
query IB
SELECT g, EXISTS (
    SELECT 1 FROM t1_2l WHERE EXISTS (
        SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g AND t2_2l.d > t1_2l.a
    )
) AS e FROM t0_2l ORDER BY g;
----
1 false
2 true
3 false
NULL false

# the same table in the middle and the nested subquery
query I
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT 1 FROM t2_2l WHERE EXISTS (
        SELECT 1 FROM t2_2l x WHERE x.c = t0_2l.g AND x.d > t2_2l.d
    )
) ORDER BY g;
----
2

# both rewrites: `e3.dept = e1.dept` reads `e2.dept` through the equality, and
# `e3.id <> e1.id`, with no equality, is flattened
query I
SELECT e1.id FROM emp_2l e1 WHERE EXISTS (
    SELECT 1 FROM emp_2l e2 WHERE e2.dept = e1.dept AND e2.id <> e1.id AND EXISTS (
        SELECT 1 FROM emp_2l e3 WHERE e3.dept = e1.dept AND e3.sal > e2.sal AND e3.id <> e1.id
    )
) ORDER BY 1;
----
1
2
3
7

# three levels: flattened one level per optimizer pass
query I
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT 1 FROM t1_2l WHERE EXISTS (
        SELECT 1 FROM t2_2l WHERE EXISTS (SELECT 1 FROM t2_2l x WHERE x.c = t0_2l.g)
    )
) ORDER BY g;
----
1
2

##########
# Outer references two levels up that neither rewrite removes. The subqueries
# are not decorrelated (the join filter would read the column out of scope),
# and physical planning fails. Before: Schema error: No field named t0_2l.g
# (or another column two levels up)
##########

# a NOT EXISTS in an EXISTS
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT 1 FROM t1_2l WHERE NOT EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
);

# a NOT IN in an EXISTS
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT 1 FROM t1_2l WHERE a NOT IN (SELECT d FROM t2_2l WHERE t2_2l.c = t0_2l.g)
);

# an EXISTS under OR
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT 1 FROM t1_2l WHERE t1_2l.a > 25 OR EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
);

# an aggregate above the filter of the middle subquery
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT count(*) FROM t1_2l WHERE EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
    HAVING count(*) > 1
);

# a LIMIT
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT 1 FROM t1_2l WHERE EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g) LIMIT 1
);

# a DISTINCT
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE g IN (
    SELECT DISTINCT b FROM t1_2l WHERE EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
);

# a window function
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g FROM t0_2l WHERE EXISTS (
    SELECT row_number() OVER () FROM t1_2l WHERE EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
);

# a scalar middle subquery (its rows are counted) without an equality to
# substitute through
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g, (
    SELECT count(*) FROM t1_2l WHERE EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
) FROM t0_2l;

# the equality under OR
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT g, (
    SELECT count(*) FROM t1_2l WHERE (t1_2l.b = t0_2l.g OR t1_2l.a > 25)
    AND EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = t0_2l.g)
) FROM t0_2l;

statement ok
CREATE TABLE tf_2l (g INT, f DOUBLE, h BIGINT) AS VALUES (1, 1.0, 1), (2, 2.0, 2), (NULL, NULL, NULL);

statement ok
CREATE TABLE tf1_2l (b INT, fb DOUBLE) AS VALUES (1, 1.0), (2, 2.0), (NULL, NULL);

# an equality of floating point numbers (equal values are not always the
# same: -0.0 and 0.0)
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT f, (
    SELECT count(*) FROM tf1_2l WHERE tf1_2l.fb = tf_2l.f
    AND EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = tf_2l.f)
) FROM tf_2l;

# an equality across a cast (INT and BIGINT)
query error DataFusion error: This feature is not implemented: Physical plan does not support logical expression (Exists|InSubquery|ScalarSubquery)
SELECT h, (
    SELECT count(*) FROM tf1_2l WHERE tf1_2l.b = tf_2l.h
    AND EXISTS (SELECT 1 FROM t2_2l WHERE t2_2l.c = tf_2l.h)
) FROM tf_2l;

