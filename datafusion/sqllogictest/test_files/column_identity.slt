##########
# Regression tests for bugs caused by identifying columns by name
# (qualifier + name) instead of by their column ids.
#
# Each block holds the correct result. Other regression tests of the column
# ids are in subquery.slt (#26573) and aggregates_topk.slt (#26691).
##########

##########
# #26621: GROUP BY CAST(a AS VARCHAR), a with a common subexpression
# before column ids: Optimizer rule 'optimize_projections' failed ... No field named t.a
# (the second variant panicked)
##########

statement ok
CREATE TABLE t26621 (a INT) AS VALUES (1);

query III
SELECT a, a + 1, (a + 1) * 2 FROM t26621 GROUP BY CAST(a AS VARCHAR), a;
----
1 2 4

# the second variant (before column ids: a panic or the schema error, depending on
# HashMap order)
query IIT
SELECT a, a + 1, COALESCE(min('x'), CAST(a AS VARCHAR)) FROM t26621 GROUP BY CAST(a AS VARCHAR), a;
----
1 2 x

##########
# #25837: LATERAL over a derived table whose alias differs from the table name
# before column ids: Schema error: No field named l.id
##########

statement ok
CREATE TABLE o25837 (k INT) AS VALUES (1), (2);

statement ok
CREATE TABLE l25837 (id INT, v INT) AS VALUES (1, 10), (2, 20);

query II
SELECT o25837.k, s.v
FROM o25837, LATERAL (
  SELECT l2.v FROM (SELECT * FROM l25837 WHERE l25837.id = o25837.k) AS l2
) AS s
ORDER BY o25837.k;
----
1 10
2 20

##########
# #26692: decorrelation loses correlated columns when a subquery contains
# two equal subplans
# before column ids: Q1 wrong rows (one row instead of two), Q2 No field named s.a,
# Q3 No field named l.a
##########

statement ok
CREATE TABLE t26692 (a INT, b INT) AS VALUES (1, 1), (2, 2);

statement ok
CREATE TABLE t2_26692 (a INT, b INT) AS VALUES (1, 1), (3, 30);

query I
SELECT t26692.a FROM t26692, t2_26692 AS s
WHERE EXISTS (
    SELECT 1 FROM (SELECT * FROM t2_26692 AS s WHERE s.a = t26692.a) x
    CROSS JOIN t2_26692 AS s
);
----
1
1

query I
SELECT t26692.a FROM t26692
WHERE EXISTS (
    SELECT 1 FROM (SELECT * FROM t2_26692 AS s WHERE s.a = t26692.a) x
    CROSS JOIN t2_26692 AS s
);
----
1

query I
SELECT t26692.a FROM t26692
WHERE EXISTS (
    SELECT 1 FROM (SELECT a FROM t2_26692 WHERE t2_26692.a = t26692.a) x
    CROSS JOIN LATERAL (SELECT b FROM t2_26692 WHERE t2_26692.b = x.a) l
);
----
1

##########
# #26033: correlated IN subquery whose column is cast
# before column ids: Schema error: No field named __correlated_sq_1.y (the
# issue reported "Projections require unique expression names"): the pulled
# up `i.y` was not added to the subquery's outputs, because the cast
# `CAST(i.y AS Int64)` is also named `i.y`
##########

statement ok
CREATE TABLE o26033 (k INT, b BIGINT) AS VALUES (1, 1), (2, 2), (3, 30);

statement ok
CREATE TABLE i26033 (y INT) AS VALUES (1), (2), (3);

query I
SELECT o26033.k FROM o26033
WHERE o26033.b IN (SELECT i26033.y FROM i26033 WHERE i26033.y = o26033.k)
ORDER BY o26033.k;
----
1
2

query I
SELECT o26033.k FROM o26033
WHERE o26033.b IN (SELECT CAST(i26033.y AS BIGINT) FROM i26033 WHERE i26033.y = o26033.k)
ORDER BY o26033.k;
----
1
2

# The projection branch of #26619 (push_down_filter), which #26033 masked
statement ok
CREATE TABLE t0_26619 (c0 BIGINT) AS VALUES (1);

statement ok
CREATE TABLE t1_26619 (c0 BIGINT) AS VALUES (0);

query I
SELECT c0 FROM t1_26619
WHERE '1' IN (SELECT CAST(t0_26619.c0 AS VARCHAR) FROM t0_26619 WHERE t0_26619.c0 > t1_26619.c0);
----
0

##########
# #26221: aggregates of x and CAST(x AS ...) share a name
# before column ids: duplicate unqualified field name "sum(t.x)" (aliased),
# Projections require unique expression names (unaliased)
##########

query RR
SELECT sum(x) AS a, sum(CAST(x AS FLOAT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
3 3

query II
SELECT count(x) AS a, count(CAST(x AS BIGINT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
2 2

query II
SELECT count(DISTINCT x) AS a, count(DISTINCT CAST(x AS BIGINT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
2 2

# unaliased form
query RR
SELECT sum(x), sum(CAST(x AS FLOAT)) FROM (VALUES (1.0), (2.0)) AS t(x);
----
3 3

# window form (no separate issue; before column ids: Windows require unique expression names)
query IR
SELECT sum(x) OVER () AS a, sum(CAST(x AS DOUBLE)) OVER () AS b FROM (VALUES (1), (2)) AS t(x);
----
3 3
3 3

##########
# #3353: approx_distinct(c) and approx_distinct(CAST(c AS VARCHAR)), aliased
# before column ids: duplicate unqualified field name "approx_distinct(t.c)"
##########

statement ok
CREATE TABLE t3353 (c BIGINT) AS SELECT value % 99 FROM generate_series(1, 100);

query II
SELECT approx_distinct(c) AS count_c, approx_distinct(CAST(c AS VARCHAR)) AS count_c_str FROM t3353;
----
99 99

##########
# #6543: two outputs with the same alias
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE t6543 (ts INT, inc_col INT) AS VALUES (1, 10), (2, 20);

query II
SELECT ts AS c1, inc_col AS c1 FROM t6543 ORDER BY ts;
----
1 10
2 20

##########
# #4478: SELECT a, CAST(a AS INT)
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE t4478 (a BIGINT) AS VALUES (1);

query II
SELECT a, CAST(a AS INT) FROM t4478;
----
1 1

##########
# #13558: SELECT CAST(col AS TEXT) ... ORDER BY col
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE foo13558 AS VALUES (1, 2), (3, 4), (5, 6);

query T
SELECT CAST(column1 AS TEXT) FROM foo13558 ORDER BY column1;
----
1
3
5

##########
# #26462: ORDER BY a source column when a select item is aliased to its name
# before column ids: Schema contains qualified field name e.email and unqualified field name email which would be ambiguous
##########

statement ok
CREATE TABLE employees26462 (id INT, email VARCHAR) AS VALUES (1, 'B@x'), (2, 'a@y');

query T
SELECT lower(e.email) AS email FROM employees26462 e ORDER BY e.email;
----
b@x
a@y

##########
# #25447: leaf extraction computes the same get_field twice in one projection
# before column ids: correct rows, but get_field(t.s, "a") was extracted under
# two generated names in the bottom projection
##########

statement ok
CREATE TABLE t25447 (v INT, s STRUCT<a INT, b INT>) AS VALUES (1, {a: 10, b: 1}), (2, {a: 20, b: 2});

statement ok
set datafusion.explain.logical_plan_only = true;

query TT
EXPLAIN SELECT s['a'] FROM (SELECT s, v FROM t25447 WHERE v > 0) WHERE s['a'] > 0;
----
logical_plan
01)Projection: t25447.s[a]
02)--Filter: t25447.v > Int32(0) AND t25447.s[a] > Int32(0)
03)----Projection: get_field(t25447.s, Utf8("a")), t25447.v
04)------TableScan: t25447 projection=[v, s]

statement ok
set datafusion.explain.logical_plan_only = false;

query I
SELECT s['a'] FROM (SELECT s, v FROM t25447 WHERE v > 0) WHERE s['a'] > 0 ORDER BY 1;
----
10
20

##########
# #26234: correlated subquery confuses same-named columns of two of its relations
# before column ids: wrong rows for all four queries (both pulled up
# references were renamed to the first `__correlated_sq_1.k`)
##########

statement ok
CREATE TABLE test26234 (k INT) AS VALUES (1), (2);

query I
SELECT o.k FROM test26234 o
WHERE EXISTS (SELECT 1 FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1);
----
1

query I
SELECT o.k FROM test26234 o
WHERE NOT EXISTS (SELECT 1 FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1);
----
2

query I
SELECT o.k FROM test26234 o
WHERE o.k IN (SELECT one.k FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1);
----
1

query II
SELECT o.k, (SELECT count(*) FROM test26234 one, test26234 two WHERE one.k = o.k AND two.k = o.k + 1) AS c
FROM test26234 o ORDER BY o.k;
----
1 1
2 0

##########
# #25024: NOT IN with an expression key under IS NULL (a null-aware mark join)
# before column ids: correct (`z`); a regression of the column ids gave
# `could not cast array of type Utf8View to ... BooleanArray`: the projection
# of the expression join key reused the id of the mark column
##########

statement ok
CREATE TABLE outer25024 (id VARCHAR NOT NULL) AS VALUES ('z');

statement ok
CREATE TABLE inner25024 (id VARCHAR NOT NULL) AS VALUES ('a');

query T
SELECT id FROM outer25024 WHERE (NULLIF(id, 'z') NOT IN (SELECT id FROM inner25024)) IS NULL;
----
z

##########
# #13476: SELECT ts, id, * repeats columns of the table
# before column ids: Projections require unique expression names
##########

statement ok
CREATE TABLE users13476 (id INT, name VARCHAR, ts INT) AS VALUES (1, 'a', 10), (2, 'b', 20);

query IIITI
SELECT ts, id, * FROM users13476 ORDER BY 2;
----
10 1 1 a 10
20 2 2 b 20

query ITII
SELECT *, id FROM users13476 ORDER BY 1;
----
1 a 10 1
2 b 20 2

##########
# #26620: two window functions share ORDER BY a + 1, one argument is constant folded
# before column ids: panic in debug builds (all window expressions shall have
# the same sort keys): CSE named the common `t.a + Int64(1)` differently in the
# two sort keys (`__common_expr_1` and `__common_expr_1 AS t.a + Int64(1)`)
##########

statement ok
CREATE TABLE t26620 (a BIGINT, b BIGINT) AS VALUES (1, 10), (2, 20);

query II rowsort
SELECT sum(1 + 1) OVER (ORDER BY a + 1), sum(b) OVER (ORDER BY a + 1) FROM t26620;
----
2 10
4 30

