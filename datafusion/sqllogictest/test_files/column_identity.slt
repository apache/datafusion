##########
# Outputs with the same name next to UNNEST: the select list is planned as an
# inner projection read by name, which kept one expression per name, so both
# `x` read the first (a wrong result; on main the duplicate names are an
# error)
##########

query III
SELECT 1 AS x, 2 AS x, unnest([1, 2]) AS u;
----
1 2 1
1 2 2

query II
SELECT x, x2 FROM (SELECT 1 AS x, 2 AS x, unnest([1, 2]) AS u) AS t(x, x2, u);
----
1 2
1 2

# the same expression under the same name is one inner column
query III
SELECT 1 AS x, 1 AS x, unnest([3]) AS u;
----
1 1 3
