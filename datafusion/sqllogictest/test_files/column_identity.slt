# Queries whose columns share a name, or lose their qualifier, while the
# optimizer moves them. Column ids (`ColumnId`) let the optimizer tell such
# columns apart.

##########
## A column and a cast of it share a schema name
##########

statement ok
CREATE TABLE ci_t (a INT) AS VALUES (1), (2);

# https://github.com/apache/datafusion/issues/26619
# `push_down_filter` used to substitute `CAST(t.a AS ..)` for `t.a`
query I
SELECT a FROM ci_t GROUP BY a, CAST(a AS VARCHAR) HAVING a > (SELECT min(a) FROM ci_t);
----
2

statement ok
CREATE TABLE ci_one (a INT) AS VALUES (1);

# https://github.com/apache/datafusion/issues/26621
# common subexpression elimination used to drop `t.a` from its projection
query III
SELECT a, a + 1, (a + 1) * 2 FROM ci_one GROUP BY CAST(a AS VARCHAR), a;
----
1 2 4

query IIT
SELECT a, a + 1, COALESCE(min('x'), CAST(a AS VARCHAR)) FROM ci_one GROUP BY CAST(a AS VARCHAR), a;
----
1 2 x

statement ok
CREATE TABLE ci_bigint (a BIGINT) AS VALUES (1);

# https://github.com/apache/datafusion/issues/4478
query II
SELECT a, CAST(a AS INT) FROM ci_bigint;
----
1 1

statement ok
CREATE TABLE ci_values AS VALUES (1, 2), (3, 4), (5, 6);

# https://github.com/apache/datafusion/issues/13558
query T
SELECT CAST(column1 AS TEXT) FROM ci_values ORDER BY column1;
----
1
3
5

# Two expressions with the same qualifier and name are still rejected
statement error DataFusion error: Error during planning: Projections require unique expression names
SELECT a, a FROM ci_t;

##########
## Outputs with the same name that define different columns
##########

# https://github.com/apache/datafusion/issues/26221
# `sum(x)` and `sum(CAST(x AS FLOAT))` are both named `sum(t.x)`
query RR
SELECT sum(x) AS a, sum(CAST(x AS FLOAT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
3 3

query II
SELECT count(x) AS a, count(CAST(x AS BIGINT)) AS b FROM (VALUES (1.0), (2.0)) AS t(x);
----
2 2

# https://github.com/apache/datafusion/issues/6543
query II
SELECT a AS c1, a AS c1 FROM ci_t ORDER BY 1;
----
1 1
2 2

# A reference to either of them by name is ambiguous, as in Postgres
statement error DataFusion error: Schema error: Ambiguous reference to unqualified field c1
SELECT c1 FROM (SELECT a AS c1, a AS c1 FROM ci_t);

# A relation name used twice is still rejected
statement error DataFusion error: Schema error: Schema contains duplicate qualified field name ci_t\.a
SELECT count(*) FROM ci_t RIGHT JOIN ci_t ON ci_t.a > 0;

##########
## Correlated subqueries
##########

statement ok
CREATE TABLE ci_o (k INT, b BIGINT) AS VALUES (1, 1), (2, 2), (3, 30);

statement ok
CREATE TABLE ci_i (y INT) AS VALUES (1), (2), (3);

# https://github.com/apache/datafusion/issues/26033
# decorrelation used to treat `i.y` as already projected by `CAST(i.y AS ..)`
query I
SELECT ci_o.k FROM ci_o WHERE ci_o.b IN (SELECT ci_i.y FROM ci_i WHERE ci_i.y = ci_o.k) ORDER BY ci_o.k;
----
1
2

query I
SELECT ci_o.k FROM ci_o WHERE 1 IN (SELECT ci_i.y FROM ci_i WHERE ci_i.y = ci_o.k) ORDER BY ci_o.k;
----
1

query I
SELECT ci_o.k FROM ci_o WHERE ci_o.k + 0 IN (SELECT ci_i.y FROM ci_i WHERE ci_i.y = ci_o.b) ORDER BY ci_o.k;
----
1
2

query I
SELECT ci_o.k FROM ci_o WHERE ci_o.b NOT IN (SELECT ci_i.y FROM ci_i WHERE ci_i.y = ci_o.k) ORDER BY ci_o.k;
----
3

query I
SELECT ci_o.k FROM ci_o WHERE ci_o.b IN (SELECT CAST(ci_i.y AS BIGINT) FROM ci_i WHERE ci_i.y = ci_o.k) ORDER BY ci_o.k;
----
1
2

statement ok
CREATE TABLE ci_s (b INT) AS VALUES (1);

# https://github.com/apache/datafusion/issues/26573
# the outer reference `x.a` used to lose its table alias when the filter
# moved below `SubqueryAlias: x`
query II rowsort
SELECT * FROM ci_t AS x JOIN ci_t AS y ON x.a = ANY (SELECT b FROM ci_s);
----
1 1
1 2

statement ok
CREATE TABLE ci_lo (k INT) AS VALUES (1), (2);

statement ok
CREATE TABLE ci_l (id INT, v INT) AS VALUES (1, 10), (2, 20);

# https://github.com/apache/datafusion/issues/25837
query II
SELECT ci_lo.k, s.v
FROM ci_lo, LATERAL (
  SELECT l2.v FROM (SELECT * FROM ci_l WHERE ci_l.id = ci_lo.k) AS l2
) AS s
ORDER BY ci_lo.k;
----
1 10
2 20

statement ok
CREATE TABLE ci_x (x INT) AS VALUES (1), (6);

statement ok
CREATE TABLE ci_y (y INT) AS VALUES (5);

# https://github.com/apache/datafusion/issues/26622
# rewriting `x > ALL (..)` used to change the name of the output column
query B rowsort
SELECT x > ALL (SELECT y FROM ci_y) FROM ci_x;
----
false
true

statement ok
CREATE TABLE ci_t1 (a INT, b INT) AS VALUES (1, 1), (2, 2);

statement ok
CREATE TABLE ci_t2 (a INT, b INT) AS VALUES (1, 1), (3, 30);

# https://github.com/apache/datafusion/issues/26692
# decorrelation used to mix up two scans of the same table
query I rowsort
SELECT ci_t1.a FROM ci_t1, ci_t2 AS s
WHERE EXISTS (
    SELECT 1 FROM (SELECT * FROM ci_t2 AS s WHERE s.a = ci_t1.a) x
    CROSS JOIN ci_t2 AS s
);
----
1
1

query I
SELECT ci_t1.a FROM ci_t1
WHERE EXISTS (
    SELECT 1 FROM (SELECT * FROM ci_t2 AS s WHERE s.a = ci_t1.a) x
    CROSS JOIN ci_t2 AS s
);
----
1

query I
SELECT ci_t1.a FROM ci_t1
WHERE EXISTS (
    SELECT 1 FROM (SELECT a FROM ci_t2 WHERE ci_t2.a = ci_t1.a) x
    CROSS JOIN LATERAL (SELECT b FROM ci_t2 WHERE ci_t2.b = x.a) l
);
----
1

statement ok
DROP TABLE ci_t;

statement ok
DROP TABLE ci_one;

statement ok
DROP TABLE ci_bigint;

statement ok
DROP TABLE ci_values;

statement ok
DROP TABLE ci_o;

statement ok
DROP TABLE ci_i;

statement ok
DROP TABLE ci_s;

statement ok
DROP TABLE ci_lo;

statement ok
DROP TABLE ci_l;

statement ok
DROP TABLE ci_x;

statement ok
DROP TABLE ci_y;

statement ok
DROP TABLE ci_t1;

statement ok
DROP TABLE ci_t2;
