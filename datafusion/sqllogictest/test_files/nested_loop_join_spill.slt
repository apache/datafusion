# Tests for NestedLoopJoinExec memory-limited execution (spill to disk).
#
# Memory-limited execution is disabled on branch-55 (see ENABLE_MEMORY_LIMITED_EXECUTION in
# datafusion/physical-plan/src/joins/nested_loop_join.rs): when the left (build) side exceeds the
# memory budget, the query fails with ResourcesExhausted instead of spilling, as before 54.0.0.
# The queries below are the ones that exercised the spill fallback.

# Use a single target partition to avoid repartitioning.
statement ok
SET datafusion.execution.target_partitions = 1

# Set a memory limit small enough to force OOM on the left-side buffering
# (100K rows × 8 bytes ≈ 800KB > 150KB limit).
statement ok
SET datafusion.runtime.memory_limit = '150K'

# --- INNER JOIN with non-equijoin predicate (forces NestedLoopJoinExec) ---
query error Resources exhausted
SELECT count(*) as cnt, min(v1) as mn, max(v1) as mx
FROM generate_series(1, 100000) AS t1(v1)
INNER JOIN generate_series(1, 1) AS t2(v2)
  ON (t1.v1 + t2.v2) > 0

# --- RIGHT JOIN with non-equijoin predicate ---
query error Resources exhausted
SELECT count(*)
FROM generate_series(1, 100000) AS t1(v1)
RIGHT JOIN generate_series(1, 1) AS t2(v2)
  ON (t1.v1 + t2.v2) > 0

# --- RIGHT JOIN with partial matches ---
query error Resources exhausted
SELECT count(*) as cnt,
       sum(case when t1.v1 IS NULL then 1 else 0 end) as unmatched_right,
       sum(case when t1.v1 IS NOT NULL then 1 else 0 end) as matched
FROM generate_series(1, 100000) AS t1(v1)
RIGHT JOIN generate_series(1, 200) AS t2(v2)
  ON (t1.v1 + t2.v2) = 2 AND t2.v2 <= 100

# --- FULL JOIN with partial matches ---
query error Resources exhausted
SELECT count(*) as cnt,
       sum(case when t1.v1 IS NULL then 1 else 0 end) as unmatched_right,
       sum(case when t2.v2 IS NULL then 1 else 0 end) as unmatched_left
FROM generate_series(1, 100000) AS t1(v1)
FULL JOIN generate_series(1, 200) AS t2(v2)
  ON (t1.v1 + t2.v2) = 2 AND t2.v2 <= 100

# Restore settings to slt runner defaults
statement ok
RESET datafusion.runtime.memory_limit

statement ok
SET datafusion.execution.target_partitions = 4

statement ok
RESET datafusion.catalog.create_default_catalog_and_schema
