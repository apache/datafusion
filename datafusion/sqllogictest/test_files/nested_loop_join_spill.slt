03)----NestedLoopJoinExec: join_type=RightAnti, filter=threshold@0 > value@1, projection=[], metrics=[output_rows=0, <slt:ignore> spill_count=2, <slt:ignore> input_batches=8, input_rows=516, <slt:ignore>]
04)------ProjectionExec: expr=[CASE WHEN value@0 = 0 THEN 129 ELSE 0 END as threshold], metrics=[<slt:ignore>]
05)--------LazyMemoryExec: partitions=1, batch_generators=[range: start=0, end=5000, batch_size=65], metrics=[<slt:ignore>]
06)------LazyMemoryExec: partitions=1, batch_generators=[range: start=0, end=129, batch_size=65], metrics=[<slt:ignore>]

# Restore settings to slt runner defaults
statement ok
RESET datafusion.runtime.memory_limit

statement ok
RESET datafusion.catalog.create_default_catalog_and_schema

statement ok
RESET datafusion.execution.batch_size

statement ok
SET datafusion.execution.target_partitions = 4

statement ok
RESET datafusion.optimizer.join_reordering
