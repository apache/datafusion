# Exercise the integer prefilter inside HashJoin, including probe rows that
# skip lookup but must still contribute to outer, anti, and mark join output.
# Sparse keys avoid the existing ArrayMap path. Keep the SQL build/probe order
# and prevent dynamic filters from removing probe rows before HashJoin sees them.
statement ok
SET datafusion.execution.target_partitions = 1;

statement ok
SET datafusion.optimizer.join_reordering = false;

statement ok
SET datafusion.optimizer.enable_join_dynamic_filter_pushdown = false;

statement ok
SET datafusion.explain.analyze_categories = 'rows,uncategorized';

statement ok
SET datafusion.catalog.information_schema = true;

query TT rowsort
SELECT name, value FROM information_schema.df_settings
WHERE name LIKE 'datafusion.execution.%join_integer_prefilter%';
----
datafusion.execution.enable_join_integer_prefilter false
datafusion.execution.join_integer_prefilter_max_key_range 262144
datafusion.execution.join_integer_prefilter_min_pruning_ratio 0.5
datafusion.execution.join_integer_prefilter_sample_rows 12288

statement ok
CREATE TABLE build(k INT, label VARCHAR) AS VALUES
  (NULL, 'build_null'), (0, 'zero_a'), (0, 'zero_b'), (2048, 'build_only');

statement ok
CREATE TABLE probe(k INT, label VARCHAR) AS VALUES
  (NULL, 'probe_null'), (-1, 'below'), (0, 'hit_a'),
  (1, 'gap'), (3000, 'above'), (0, 'hit_b');

# Baseline: duplicate matches and unmatched rows on both sides.
query TT rowsort
SELECT b.label, p.label FROM build b FULL JOIN probe p ON b.k = p.k;
----
NULL above
NULL below
NULL gap
NULL probe_null
build_null NULL
build_only NULL
zero_a hit_a
zero_a hit_b
zero_b hit_a
zero_b hit_b

statement ok
SET datafusion.execution.enable_join_integer_prefilter = true;

# The bitmap is created and rejects below-range, in-range-gap, and above-range
# keys. The NULL probe key is already invalid for equality and is not counted.
# These three rejected rows must remain in the full join's output.
query TT
EXPLAIN ANALYZE SELECT * FROM build b FULL JOIN probe p ON b.k = p.k;
----
Plan with Metrics
01)HashJoinExec: mode=CollectLeft, join_type=Full, on=[(k@0, k@0)], metrics=[output_rows=10, <slt:ignore>array_map_created_count=0, <slt:ignore>integer_prefilter_created_count=1, probe_prefilter_rows_pruned=3, <slt:ignore>]
02)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]
03)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]

query TT rowsort
SELECT b.label, p.label FROM build b FULL JOIN probe p ON b.k = p.k;
----
NULL above
NULL below
NULL gap
NULL probe_null
build_null NULL
build_only NULL
zero_a hit_a
zero_a hit_b
zero_b hit_a
zero_b hit_b

query TT rowsort
SELECT b.label, p.label FROM build b JOIN probe p ON b.k = p.k;
----
zero_a hit_a
zero_a hit_b
zero_b hit_a
zero_b hit_b

# NULL equality must still look up the build-side NULL.
query TT rowsort
SELECT b.label, p.label FROM build b JOIN probe p
ON b.k IS NOT DISTINCT FROM p.k;
----
build_null probe_null
zero_a hit_a
zero_a hit_b
zero_b hit_a
zero_b hit_b

# Anti joins retain rejected probe rows and unmatched build rows respectively.
query T rowsort
SELECT p.label FROM build b RIGHT ANTI JOIN probe p ON b.k = p.k;
----
above
below
gap
probe_null

query T rowsort
SELECT b.label FROM build b LEFT ANTI JOIN probe p ON b.k = p.k;
----
build_null
build_only

query T rowsort
SELECT p.label FROM build b RIGHT SEMI JOIN probe p ON b.k = p.k;
----
hit_a
hit_b

# IS NULL around IN requires a null-aware mark join, which bypasses the
# prefilter and preserves SQL's three-valued result.
query TT
EXPLAIN ANALYZE SELECT p.label FROM probe p
WHERE (p.k IN (SELECT k FROM build)) IS NULL;
----
Plan with Metrics
<slt:ignore>HashJoinExec: mode=CollectLeft, join_type=LeftMark, on=[(k@0, k@0)], <slt:ignore>null_aware, metrics=[output_rows=6, <slt:ignore>array_map_created_count=0, <slt:ignore>integer_prefilter_created_count=0, probe_prefilter_rows_pruned=0, <slt:ignore>]
<slt:ignore>

query T rowsort
SELECT p.label FROM probe p WHERE (p.k IN (SELECT k FROM build)) IS NULL;
----
above
below
gap
probe_null

query T rowsort
SELECT p.label FROM probe p
WHERE (p.k IN (SELECT k FROM build WHERE k IS NOT NULL)) IS NULL;
----
probe_null

query T rowsort
SELECT p.label FROM probe p
WHERE (p.k IN (SELECT k FROM build WHERE k IS NOT NULL)) IS FALSE;
----
above
below
gap

# NOT IN must not emit the misses when its subquery contains NULL.
query T rowsort
SELECT p.label FROM probe p WHERE p.k NOT IN (SELECT k FROM build);
----

query T rowsort
SELECT p.label FROM probe p
WHERE p.k NOT IN (SELECT k FROM build WHERE k IS NOT NULL);
----
above
below
gap

# max_key_range counts max - min + 1: 0..=2048 needs 2049 bits. A smaller
# configured limit falls back to the normal hash lookup with identical output.
statement ok
SET datafusion.execution.join_integer_prefilter_max_key_range = 2048;

query TT
EXPLAIN ANALYZE SELECT * FROM build b FULL JOIN probe p ON b.k = p.k;
----
Plan with Metrics
01)HashJoinExec: mode=CollectLeft, join_type=Full, on=[(k@0, k@0)], metrics=[output_rows=10, <slt:ignore>array_map_created_count=0, <slt:ignore>integer_prefilter_created_count=0, probe_prefilter_rows_pruned=0, <slt:ignore>]
02)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]
03)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]

query TT rowsort
SELECT b.label, p.label FROM build b FULL JOIN probe p ON b.k = p.k;
----
NULL above
NULL below
NULL gap
NULL probe_null
build_null NULL
build_only NULL
zero_a hit_a
zero_a hit_b
zero_b hit_a
zero_b hit_b

# A zero range disables bitmap construction without disabling the feature.
statement ok
SET datafusion.execution.join_integer_prefilter_max_key_range = 0;

query TT
EXPLAIN ANALYZE SELECT * FROM build b FULL JOIN probe p ON b.k = p.k;
----
Plan with Metrics
01)HashJoinExec: mode=CollectLeft, join_type=Full, on=[(k@0, k@0)], metrics=[output_rows=10, <slt:ignore>array_map_created_count=0, <slt:ignore>integer_prefilter_created_count=0, probe_prefilter_rows_pruned=0, <slt:ignore>]
02)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]
03)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[]

statement ok
RESET datafusion.execution.enable_join_integer_prefilter;

statement ok
RESET datafusion.execution.join_integer_prefilter_max_key_range;

# The SLT runner starts with four partitions, rather than the CPU-count default.
statement ok
SET datafusion.execution.target_partitions = 4;

statement ok
RESET datafusion.optimizer.join_reordering;

statement ok
RESET datafusion.optimizer.enable_join_dynamic_filter_pushdown;

statement ok
RESET datafusion.explain.analyze_categories;

statement ok
RESET datafusion.catalog.information_schema;
