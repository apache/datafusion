query ?? rowsort
with tbl as (SELECT * FROM (VALUES ('xxx', 'yyy'), ('xxx', 'yyy'), ('xxx2', 'yyy2')) AS t(x, y))
select
    array_agg(distinct x order by x) as x_agg,
    array_agg(distinct y order by y) as y_agg
from tbl
group by all
----
[xxx, xxx2] [yyy, yyy2]

query ??
