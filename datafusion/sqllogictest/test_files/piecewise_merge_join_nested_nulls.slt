SELECT 'LEFT' AS kind, l.id AS l_id, r.id AS r_id FROM nested_left l LEFT JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'RIGHT' AS kind, l.id AS l_id, r.id AS r_id FROM nested_left l RIGHT JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'FULL' AS kind, l.id AS l_id, r.id AS r_id FROM nested_left l FULL JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'LEFT SEMI' AS kind, l.id AS l_id, NULL AS r_id FROM nested_left l LEFT SEMI JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'LEFT ANTI' AS kind, l.id AS l_id, NULL AS r_id FROM nested_left l LEFT ANTI JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'RIGHT SEMI' AS kind, NULL AS l_id, r.id AS r_id FROM nested_left l RIGHT SEMI JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'RIGHT ANTI' AS kind, NULL AS l_id, r.id AS r_id FROM nested_left l RIGHT ANTI JOIN nested_right r ON l.k >= r.k
UNION ALL
SELECT 'MARK' AS kind, l.id AS l_id, CAST(EXISTS (SELECT 1 FROM nested_right r WHERE l.k >= r.k) OR l.id = -1 AS INT) AS r_id FROM nested_left l;

statement ok
CREATE TABLE ref_nested_ge AS SELECT * FROM case_nested_ge;

statement ok
SET datafusion.optimizer.enable_piecewise_merge_join = true;

query I
WITH actual AS (SELECT * FROM case_nested_ge), differences AS (
(SELECT * FROM actual EXCEPT ALL SELECT * FROM ref_nested_ge)
UNION ALL
(SELECT * FROM ref_nested_ge EXCEPT ALL SELECT * FROM actual)
)
SELECT COUNT(*) FROM differences;
