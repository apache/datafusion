# configMatrix: datafusion.execution.batch_size=1,2,8192
# configMatrix: datafusion.execution.target_partitions=1,4

statement ok
SET datafusion.optimizer.enable_piecewise_merge_join = true;

statement ok
CREATE TABLE l AS SELECT * FROM (VALUES (make_array(5), 'l5')) t(a, p);

statement ok
CREATE TABLE r AS SELECT * FROM (VALUES (make_array(arrow_cast(NULL, 'Int64')), 'rnull'), (make_array(7), 'r7'), (make_array(1), 'r1')) t(b, q);

query TT
SELECT l.p, r.q FROM l JOIN r ON l.a < r.b ORDER BY 1, 2;
----
l5 r7

statement ok
CREATE TABLE sl AS SELECT * FROM (VALUES (named_struct('x', 5), 'l5')) t(a, p);

statement ok
CREATE TABLE sr AS SELECT * FROM (VALUES (named_struct('x', 7), 'r7'), (named_struct('x', 1), 'r1')) t(b, q);

query TT
SELECT sl.p, sr.q FROM sl JOIN sr ON sl.a < sr.b ORDER BY 1, 2;
----
l5 r7


statement ok
CREATE TABLE list_left AS
SELECT id, CASE WHEN id = 0 THEN NULL ELSE make_array(v) END AS k
FROM (SELECT value AS id, CASE WHEN value < 2 THEN NULL WHEN value = 2 THEN 1 WHEN value < 5 THEN 5 ELSE 7 END AS v FROM range(0, 6)) AS t;

statement ok
CREATE TABLE list_right AS
SELECT id, CASE WHEN id = 0 THEN NULL ELSE make_array(v) END AS k
FROM (SELECT value AS id, CASE WHEN value < 2 THEN NULL WHEN value = 2 THEN 1 WHEN value < 5 THEN 5 ELSE 7 END AS v FROM range(0, 6)) AS t;

# list keys, <: compare all join variants with NestedLoopJoin.
statement ok
SET datafusion.optimizer.enable_piecewise_merge_join = false;

statement ok
CREATE VIEW case_list_lt AS
SELECT 'INNER' AS kind, l.id AS l_id, r.id AS r_id FROM list_left l INNER JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'LEFT' AS kind, l.id AS l_id, r.id AS r_id FROM list_left l LEFT JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'RIGHT' AS kind, l.id AS l_id, r.id AS r_id FROM list_left l RIGHT JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'FULL' AS kind, l.id AS l_id, r.id AS r_id FROM list_left l FULL JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'LEFT SEMI' AS kind, l.id AS l_id, NULL AS r_id FROM list_left l LEFT SEMI JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'LEFT ANTI' AS kind, l.id AS l_id, NULL AS r_id FROM list_left l LEFT ANTI JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'RIGHT SEMI' AS kind, NULL AS l_id, r.id AS r_id FROM list_left l RIGHT SEMI JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'RIGHT ANTI' AS kind, NULL AS l_id, r.id AS r_id FROM list_left l RIGHT ANTI JOIN list_right r ON l.k < r.k
UNION ALL
SELECT 'MARK' AS kind, l.id AS l_id, CAST(EXISTS (SELECT 1 FROM list_right r WHERE l.k < r.k) OR l.id = -1 AS INT) AS r_id FROM list_left l;

statement ok
CREATE TABLE ref_list_lt AS SELECT * FROM case_list_lt;

statement ok
SET datafusion.optimizer.enable_piecewise_merge_join = true;

query I
WITH actual AS (SELECT * FROM case_list_lt), differences AS (
(SELECT * FROM actual EXCEPT ALL SELECT * FROM ref_list_lt)
UNION ALL
(SELECT * FROM ref_list_lt EXCEPT ALL SELECT * FROM actual)
)
SELECT COUNT(*) FROM differences;
----
0

