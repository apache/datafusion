#######
# Tests for bit_xor with sliding (bounded) window frames.
# Validates the retract_batch implementation on BitXorAccumulator.
#######

# Setup test data
statement ok
CREATE TABLE t(i INT, x INT) AS VALUES
  (1, 5), (2, NULL), (3, 6);

# Regression test for #26470: once every non-NULL value has left a sliding
# frame, the aggregate must yield NULL, matching the whole-partition result.
# Before the fix the sliding column returned 0 on the NULL row.
query III
SELECT x,
  bit_xor(x) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND CURRENT ROW) AS sliding,
  bit_xor(x) OVER (PARTITION BY i) AS whole
FROM t
ORDER BY i;
----
5 5 5
NULL NULL NULL
6 6 6

# A wider frame where every value left after it was added
statement ok
CREATE TABLE t_all_null_tail(i INT, x INT) AS VALUES
  (1, 7), (2, NULL), (3, NULL);

# The last frame [NULL, NULL] has seen the 7 arrive and leave
query I
SELECT bit_xor(x) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM t_all_null_tail
ORDER BY i;
----
7
7
NULL

# Frames that only ever contained NULLs stay NULL
statement ok
CREATE TABLE t_null_head(i INT, x INT) AS VALUES
  (1, NULL), (2, NULL), (3, 7);

query I
SELECT bit_xor(x) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND CURRENT ROW)
FROM t_null_head
ORDER BY i;
----
NULL
NULL
7

# Distinct legitimate zero: a frame holding two equal values XORs to zero
# and must not be NULL (guards against an over-broad empty-frame check)
statement ok
CREATE TABLE t_double(i INT, x INT) AS VALUES
  (1, 10), (2, 10), (3, NULL), (4, 4);

query I
SELECT bit_xor(x) OVER (ORDER BY i ROWS BETWEEN 1 PRECEDING AND CURRENT ROW)
FROM t_double
ORDER BY i;
----
10
0
10
4

# Values entering a frame that became all-NULL aggregate from scratch
query I
SELECT bit_xor(x) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND CURRENT ROW)
FROM t_all_null_tail
ORDER BY i;
----
7
NULL
NULL

# Regression: unbounded frame still accumulates
query I
SELECT bit_xor(x) OVER (ORDER BY i ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
FROM t_double
ORDER BY i;
----
10
0
0
4
