# Declaring INT over files that store BIGINT leaves the file statistics
# without usable min/max values or null counts. The files cannot be proven
# sorted.
query I
COPY (SELECT * FROM (VALUES (100), (200)) AS t(a))
TO 'test_files/scratch/parquet_sorted_statistics/cast_bounds/1.parquet'
STORED AS PARQUET;
----
2

query I
COPY (SELECT * FROM (VALUES (1), (2), (3)) AS t(a))
TO 'test_files/scratch/parquet_sorted_statistics/cast_bounds/2.parquet'
STORED AS PARQUET;
----
3

