STORED AS PARQUET
WITH ORDER (a ASC NULLS LAST)
LOCATION 'test_files/scratch/parquet_sorted_statistics/cast_bounds';

query I
SELECT p.x FROM (VALUES (2), (4)) AS s(b)
JOIN (SELECT a + 1 AS x FROM dynamic_bounds) p ON p.x = s.b
ORDER BY p.x;
