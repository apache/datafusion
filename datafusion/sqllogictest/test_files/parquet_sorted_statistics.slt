# Union bounds cover every branch. A missing range is not a bounded branch.
query TT
EXPLAIN SELECT a + 1 AS x
FROM (SELECT a FROM arithmetic_bounds UNION ALL SELECT a FROM arithmetic_bounds) t
ORDER BY x;
----
physical_plan
01)SortPreservingMergeExec: [x@0 ASC NULLS LAST]
02)--ProjectionExec: expr=[a@0 + 1 as x]
03)----UnionExec
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_sorted_statistics/arithmetic_bounds.parquet]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet
05)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_sorted_statistics/arithmetic_bounds.parquet]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet

