# The SLT runner sets `target_partitions` to 4 instead of using the default, so
# reset it explicitly.
statement ok
set datafusion.execution.target_partitions = 4;

# Exact integer bounds prove that these projections cannot wrap (#25220).
statement ok
SET datafusion.explain.physical_plan_only = true;

statement ok
CREATE TABLE arithmetic_bounds_source (a BIGINT, b BIGINT, u BIGINT UNSIGNED) AS VALUES
(1, 9223372036854775805, 0),
(2, 9223372036854775806, 1),
(3, 9223372036854775807, 2),
(NULL, NULL, NULL);

query I
COPY (SELECT * FROM arithmetic_bounds_source ORDER BY a)
TO 'test_files/scratch/parquet_sorted_statistics/arithmetic_bounds.parquet'
STORED AS PARQUET;
----
4

statement ok
CREATE EXTERNAL TABLE arithmetic_bounds
STORED AS PARQUET
WITH ORDER (a ASC NULLS LAST)
WITH ORDER (b ASC NULLS LAST)
WITH ORDER (u ASC NULLS LAST)
