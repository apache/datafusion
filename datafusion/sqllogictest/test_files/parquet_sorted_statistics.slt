physical_plan
01)ProjectionExec: expr=[u@1 as u, __common_expr_1@0 as x, __common_expr_1@0 - 2 as y]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_sorted_statistics/arithmetic_bounds.parquet]]}, projection=[a@0 + 1 as __common_expr_1, u], output_ordering=[u@1 ASC NULLS LAST], file_type=parquet

