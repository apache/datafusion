# The same range information is available to grouping-expression analysis.
query TT
EXPLAIN SELECT a + 1 AS x, count(*) FROM arithmetic_bounds GROUP BY x ORDER BY x;
----
physical_plan
01)SortPreservingMergeExec: [x@0 ASC NULLS LAST]
02)--ProjectionExec: expr=[arithmetic_bounds.a + Int64(1)@0 as x, count(Int64(1))@1 as count(*)]
03)----AggregateExec: mode=FinalPartitioned, gby=[arithmetic_bounds.a + Int64(1)@0 as arithmetic_bounds.a + Int64(1)], aggr=[count(Int64(1))], group_clustering_mode=Full
04)------RepartitionExec: partitioning=Hash([arithmetic_bounds.a + Int64(1)@0], 4), input_partitions=1, maintains_sort_order=true
05)--------AggregateExec: mode=Partial, gby=[a@0 + 1 as arithmetic_bounds.a + Int64(1)], aggr=[count(Int64(1))], group_clustering_mode=Full
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_sorted_statistics/arithmetic_bounds.parquet]]}, projection=[a], output_ordering=[a@0 ASC NULLS LAST], file_type=parquet

