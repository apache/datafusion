statement ok
COPY  (VALUES (10), (20), (30), (40), (50))
TO 'test_files/scratch/file_row_index/parquet_table/data.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE parquet_table(column1 int)
STORED AS PARQUET
LOCATION 'test_files/scratch/file_row_index/parquet_table/';

query TT
EXPLAIN SELECT file_row_index(), column1 FROM parquet_table
----
logical_plan
01)Projection: file_row_index(), parquet_table.column1
02)--TableScan: parquet_table projection=[column1]
physical_plan DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[CAST(__datafusion_file_row_index@1 AS Int64;N) as file_row_index(), column1], file_type=parquet


query II
SELECT file_row_index(), column1 FROM parquet_table ORDER BY column1
----
0 10
1 20
2 30
3 40
4 50

query III
SELECT file_row_index(), file_row_index() + 1, column1
FROM parquet_table
ORDER BY column1
----
0 1 10
1 2 20
2 3 30
3 4 40
4 5 50


# `file_row_index()` is volatile, so no rule may inline a definition of it into
# more than one site. The query spells the call twice, so the projection keeps
# both calls, and the scan reads both from the same row index column.
query TT
EXPLAIN SELECT file_row_index(), file_row_index() + 1, column1
FROM parquet_table
ORDER BY column1
----
logical_plan
01)Sort: parquet_table.column1 ASC NULLS LAST
02)--Projection: file_row_index(), file_row_index() + Int64(1), parquet_table.column1
03)----TableScan: parquet_table projection=[column1]
physical_plan
01)SortExec: expr=[column1@2 ASC NULLS LAST], preserve_partitioning=[false]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[CAST(__datafusion_file_row_index@1 AS Int64;N) as file_row_index(), CAST(__datafusion_file_row_index@1 AS Int64;N) + 1 as file_row_index() + Int64(1), column1], file_type=parquet, sort_order_for_reorder=[column1@2 ASC NULLS LAST]

# A single definition of `file_row_index()` that a filter and the projection
# above both reference. The definition is volatile, so `PushDownFilter` must
# keep the filter above the projection that computes it, and no rule may copy
# the call: the plans must show exactly one `file_row_index()` call.
query TT
EXPLAIN SELECT r, r + 1, column1
FROM (SELECT file_row_index() AS r, column1 FROM parquet_table)
WHERE r + r > 2
ORDER BY column1
----
logical_plan
01)Sort: parquet_table.column1 ASC NULLS LAST
02)--Projection: r, r + Int64(1), parquet_table.column1
03)----Filter: r + r > Int64(2)
04)------Projection: file_row_index() AS r, parquet_table.column1
05)--------TableScan: parquet_table projection=[column1]
physical_plan
01)SortPreservingMergeExec: [column1@2 ASC NULLS LAST]
02)--SortExec: expr=[column1@2 ASC NULLS LAST], preserve_partitioning=[true]
03)----ProjectionExec: expr=[r@0 as r, r@0 + 1 as r + Int64(1), column1@1 as column1]
04)------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
05)--------FilterExec: r@0 + r@0 > 2
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[CAST(__datafusion_file_row_index@1 AS Int64;N) as r, column1], file_type=parquet

# Each row sees one value of `r`: `r + 1` and the filter agree with `r`.
query III
SELECT r, r + 1, column1
FROM (SELECT file_row_index() AS r, column1 FROM parquet_table)
WHERE r + r > 2
ORDER BY column1
----
2 3 30
3 4 40
4 5 50

query II
SELECT file_row_index(), column1
FROM parquet_table
WHERE file_row_index() > 2
ORDER BY column1
----
3 40
4 50

# Filter on file_row_index without having it in projection

query TT
EXPLAIN SELECT column1 FROM parquet_table WHERE file_row_index() > 2 ORDER BY column1
----
logical_plan
01)Sort: parquet_table.column1 ASC NULLS LAST
02)--Projection: parquet_table.column1
03)----Filter: __datafusion_extracted_1 > Int64(2)
04)------Projection: file_row_index() AS __datafusion_extracted_1, parquet_table.column1
05)--------TableScan: parquet_table projection=[column1]
physical_plan
01)SortExec: expr=[column1@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--FilterExec: __datafusion_extracted_1@0 > 2, projection=[column1@1]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[CAST(__datafusion_file_row_index@1 AS Int64;N) as __datafusion_extracted_1, column1], file_type=parquet

query I
SELECT column1 FROM parquet_table WHERE file_row_index() > 2 ORDER BY column1
----
40
50

# Filter on file_row_index without projecting it, while enabling filter pushdown

statement ok
SET datafusion.execution.parquet.pushdown_filters = true;

query TT
EXPLAIN SELECT column1 FROM parquet_table WHERE file_row_index() > 2 ORDER BY column1
----
logical_plan
01)Sort: parquet_table.column1 ASC NULLS LAST
02)--Projection: parquet_table.column1
03)----Filter: __datafusion_extracted_1 > Int64(2)
04)------Projection: file_row_index() AS __datafusion_extracted_1, parquet_table.column1
05)--------TableScan: parquet_table projection=[column1]
physical_plan
01)SortExec: expr=[column1@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--FilterExec: __datafusion_extracted_1@0 > 2, projection=[column1@1]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[CAST(__datafusion_file_row_index@1 AS Int64;N) as __datafusion_extracted_1, column1], file_type=parquet

query I
SELECT column1 FROM parquet_table WHERE file_row_index() > 2 ORDER BY column1
----
40
50

statement ok
RESET datafusion.execution.parquet.pushdown_filters;

# Without the rewrite in ParquetSource, `file_row_index()` errors because it
# depends on file-source context

query error file_row_index\(\) is source dependent and cannot be evaluated directly
SELECT file_row_index()

# Testing pushdown over a source that doesn't support `file_row_index()`.

statement ok
COPY  (VALUES (10), (20), (30), (40), (50))
TO 'test_files/scratch/file_row_index/csv_table/data.csv'
STORED AS CSV;

statement ok
CREATE EXTERNAL TABLE csv_table(column1 int)
STORED AS CSV
LOCATION 'test_files/scratch/file_row_index/csv_table/data.csv';

query error file_row_index\(\) is source dependent and cannot be evaluated directly
SELECT *, file_row_index() FROM csv_table;

# Testing a table with two files.

statement ok
COPY  (VALUES (10), (20))
TO 'test_files/scratch/file_row_index/parquet_two_files/part-1.parquet'
STORED AS PARQUET;

statement ok
COPY  (VALUES (30), (40))
TO 'test_files/scratch/file_row_index/parquet_two_files/part-2.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE parquet_two_files(column1 int)
STORED AS PARQUET
LOCATION 'test_files/scratch/file_row_index/parquet_two_files/';

query II
SELECT file_row_index(), column1
FROM parquet_two_files
WHERE file_row_index() = 1
ORDER BY column1
----
1 20
1 40

statement ok
DROP TABLE parquet_two_files;

# A leaf expression must still reach the scan when its projection also holds a
# `KeepInPlace` one; see `try_split_leaf_projection` in
# `datafusion/physical-optimizer/src/projection_pushdown.rs`. These need a
# repartition, so `batch_size` is below the row count: do not raise it and do
# not add a bare `LIMIT`, or the queries pass against broken code.

statement ok
SET datafusion.execution.batch_size = 2;

# The marker wrapped in arithmetic.
query II
SELECT file_row_index() + 1, column1 FROM parquet_table ORDER BY column1
----
1 10
2 20
3 30
4 40
5 50

# The marker is BARE here. An unrelated computed column in the same projection
# is enough, because the flag is a property of the whole projection.
query II
SELECT file_row_index(), column1 + 1 FROM parquet_table ORDER BY column1
----
0 11
1 21
2 31
3 41
4 51

# Not specific to arithmetic: any enclosing expression has the same effect.
query TI
SELECT arrow_typeof(file_row_index()), column1 FROM parquet_table ORDER BY column1
----
Int64 10
Int64 20
Int64 30
Int64 40
Int64 50

# The sibling marker behaves the same way. Compared against a predicate rather
# than printed, so the expectation does not depend on the absolute file path.
query BI
SELECT length(input_file_name()) > 0, column1 FROM parquet_table ORDER BY column1
----
true 10
true 20
true 30
true 40
true 50

# Both markers in one projection, each inside an enclosing expression.
query BI
SELECT input_file_name() IS NOT NULL AND file_row_index() >= 0, column1
FROM parquet_table ORDER BY column1
----
true 10
true 20
true 30
true 40
true 50

# A bare `input_file_name()` beside a computed column: the same trigger as the
# `file_row_index()` case above. Asserted through the plan rather than the
# values, because the value is an absolute path.
query TT
EXPLAIN SELECT input_file_name(), column1 + 1 FROM parquet_table
----
logical_plan
01)Projection: input_file_name(), CAST(parquet_table.column1 AS Int64) + Int64(1)
02)--TableScan: parquet_table projection=[column1]
physical_plan
01)ProjectionExec: expr=[__datafusion_leaf_0@1 as input_file_name(), CAST(column1@0 AS Int64) + 1 as parquet_table.column1 + Int64(1)]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[column1, input_file_name() as __datafusion_leaf_0], file_type=parquet

# The same marker twice. Both calls are one expression, so the split gives them
# a single column and the marker is evaluated once per row, not twice. Both
# outputs must still agree with each other.
query III
SELECT file_row_index(), file_row_index() + 1, column1
FROM parquet_table ORDER BY column1
----
0 1 10
1 2 20
2 3 30
3 4 40
4 5 50

# The single column is what the values above cannot show: both outputs would
# also agree if the marker were read twice.
query TT
EXPLAIN SELECT file_row_index(), file_row_index() + 1, column1 FROM parquet_table
----
logical_plan
01)Projection: file_row_index(), file_row_index() + Int64(1), parquet_table.column1
02)--TableScan: parquet_table projection=[column1]
physical_plan
01)ProjectionExec: expr=[__datafusion_leaf_0@1 as file_row_index(), __datafusion_leaf_0@1 + 1 as file_row_index() + Int64(1), column1@0 as column1]
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/file_row_index/parquet_table/data.parquet]]}, projection=[column1, CAST(__datafusion_file_row_index@1 AS Int64;N) as __datafusion_leaf_0], file_type=parquet

# `ORDER BY ... LIMIT` is a TopK that sorts on a column the split produced,
# with `preserve_partitioning=[true]`, so it runs above the repartition on the
# rewritten schema. No dynamic filter reaches the scan here: that needs the
# sort key to be the computed sibling rather than the rewritten marker.
query II
SELECT file_row_index() AS r, column1 + 1 FROM parquet_table ORDER BY r DESC LIMIT 2
----
4 51
3 41

# Shapes that already worked must keep working: the leaf rules extract from
# `Filter`, `Sort` and `Aggregate`, so those never depended on this fix.
query I
SELECT column1 FROM parquet_table WHERE file_row_index() + 1 = 3
----
30

query I
SELECT column1 FROM parquet_table ORDER BY file_row_index() + 1
----
10
20
30
40
50

query I
SELECT sum(file_row_index() + 1) FROM parquet_table
----
15

# A bare marker on its own is unaffected: no `KeepInPlace` expression shares
# the projection, so nothing is inserted beneath it.
query II
SELECT file_row_index(), column1 FROM parquet_table ORDER BY column1
----
0 10
1 20
2 30
3 40
4 50

# Raising `batch_size` above the row count removes the repartition. This must
# keep working, and it is also the control showing that `batch_size` is what
# triggers the repartition.
statement ok
SET datafusion.execution.batch_size = 8192;

query II
SELECT file_row_index() + 1, column1 FROM parquet_table ORDER BY column1
----
1 10
2 20
3 30
4 40
5 50

# `target_partitions = 1` also removes the repartition, but is not covered here:
# `RESET` restores the global default rather than the harness value, which the
# harness rejects as leftover configuration.

statement ok
DROP TABLE parquet_table;

statement ok
DROP TABLE csv_table;
