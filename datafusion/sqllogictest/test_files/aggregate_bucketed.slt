query III
select count(*), sum(c), sum(mn) from (select k, mn, count(*) c from (select v % 10007 as k, min(v) mn from t group by k) group by k, mn);
----
10007 10007 50075028

statement ok
set datafusion.execution.target_partitions = 1;

