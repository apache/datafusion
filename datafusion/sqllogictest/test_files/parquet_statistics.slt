######
# Aggregate statistics through casts
######

# String extrema do not bound the numeric values after a CAST. These aggregates
# must not be replaced with casts of the Parquet string min/max statistics.
statement ok
SET datafusion.execution.target_partitions = 1;

statement ok
COPY (SELECT * FROM (VALUES ('1'), ('100'), ('2')) AS t(a))
TO 'test_files/scratch/parquet_statistics/cast_strings.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE cast_stats_strings STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/cast_strings.parquet';

query II
SELECT MIN(CAST(a AS INT)), MAX(CAST(a AS INT)) FROM cast_stats_strings;
----
1 100

query II
SELECT MIN(CAST(a AS BIGINT)), MAX(CAST(a AS BIGINT)) FROM cast_stats_strings;
----
1 100

statement ok
DROP TABLE cast_stats_strings;

# Exact Int64 extrema that fit in Int8 preserve the aggregate optimization.
statement ok
COPY (SELECT CAST(a AS BIGINT) AS a FROM (VALUES (-128), (0), (127), (NULL)) AS t(a))
TO 'test_files/scratch/parquet_statistics/cast_ints.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE cast_stats_ints STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/cast_ints.parquet';

query II
SELECT MIN(CAST(a AS TINYINT)), MAX(CAST(a AS TINYINT)) FROM cast_stats_ints;
----
-128 127

statement ok
SET datafusion.explain.show_statistics = false;

query TT
EXPLAIN SELECT MIN(CAST(a AS TINYINT)), MAX(CAST(a AS TINYINT)) FROM cast_stats_ints;
----
physical_plan
01)ProjectionExec: expr=[-128 as min(cast_stats_ints.a), 127 as max(cast_stats_ints.a)]
02)--PlaceholderRowExec

statement ok
DROP TABLE cast_stats_ints;

# An out-of-range minimum or maximum must prevent aggregate folding and preserve
# the runtime cast error, even when the other endpoint fits in Int8.
statement ok
COPY (SELECT CAST(a AS BIGINT) AS a, CAST(b AS BIGINT) AS b
      FROM (VALUES (-129, -128), (0, 0), (127, 128), (NULL, NULL)) AS t(a, b))
TO 'test_files/scratch/parquet_statistics/cast_ints_overflow.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE cast_stats_ints_overflow STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/cast_ints_overflow.parquet';

query error Cast error: Can't cast value -129 to type Int8
SELECT MIN(CAST(a AS TINYINT)), MAX(CAST(a AS TINYINT)) FROM cast_stats_ints_overflow;

query error Cast error: Can't cast value 128 to type Int8
SELECT MIN(CAST(b AS TINYINT)), MAX(CAST(b AS TINYINT)) FROM cast_stats_ints_overflow;

query TT
EXPLAIN SELECT MIN(CAST(a AS TINYINT)), MAX(CAST(a AS TINYINT)) FROM cast_stats_ints_overflow;
----
physical_plan
01)AggregateExec: mode=Single, gby=[], aggr=[min(cast_stats_ints_overflow.a), max(cast_stats_ints_overflow.a)]
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_statistics/cast_ints_overflow.parquet]]}, projection=[CAST(a@0 AS Int8) as __common_expr_1], file_type=parquet

statement ok
DROP TABLE cast_stats_ints_overflow;

######
# Aggregate statistics through projected literals
######

statement ok
COPY (SELECT * FROM (VALUES (1, 10), (3, 30)) AS t(a, b))
TO 'test_files/scratch/parquet_statistics/literal_ndv.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE literal_ndv STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/literal_ndv.parquet';

# No row has a = 2, but the filter only estimates its row count.
query II
SELECT count(DISTINCT x), count(DISTINCT y)
FROM (SELECT 1 AS x, 2 AS y FROM literal_ndv WHERE a = 2);
----
0 0

# The filter estimates zero rows, but not exactly.
query II
SELECT count(DISTINCT x), count(DISTINCT y)
FROM (SELECT 1 AS x, 2 AS y FROM literal_ndv WHERE a > 100);
----
0 0

# An exact positive row count proves each literal is present once.
query II
SELECT count(DISTINCT x), count(DISTINCT y)
FROM (SELECT 1 AS x, 2 AS y FROM literal_ndv);
----
1 1

# COUNT(DISTINCT) does not count NULLs.
query II
SELECT count(DISTINCT x), count(DISTINCT y)
FROM (SELECT NULL AS x, 2 AS y FROM literal_ndv);
----
0 1

statement ok
DROP TABLE literal_ndv;

# An exactly empty file has no distinct values.
statement ok
COPY (SELECT * FROM (VALUES (1, 10)) AS t(a, b) WHERE a > 100)
TO 'test_files/scratch/parquet_statistics/literal_ndv_empty.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE literal_ndv_empty STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/literal_ndv_empty.parquet';

query II
SELECT count(DISTINCT x), count(DISTINCT y)
FROM (SELECT 1 AS x, 2 AS y FROM literal_ndv_empty);
----
0 0

statement ok
DROP TABLE literal_ndv_empty;

# The years of the date bounds limit the groups of the final aggregate. `d`
# has no NULLs, but the statistics of `date_part` do not keep the NULL count of
# `d`, so one NULL group is added to the 7 years. The partial aggregate keeps
# the input row count.
statement ok
COPY (SELECT d FROM unnest(range(DATE '1992-01-02', DATE '1998-12-02', INTERVAL '1' DAY)) AS t(d))
TO 'test_files/scratch/parquet_statistics/dates.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE date_stats STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/dates.parquet';

statement ok
SET datafusion.explain.show_statistics = true;

statement ok
SET datafusion.execution.target_partitions = 2;

query TT
EXPLAIN SELECT date_part('year', d) AS y, COUNT(*) FROM date_stats GROUP BY y;
----
physical_plan
01)ProjectionExec: expr=[date_part(Utf8("year"),date_stats.d)@0 as y, count(Int64(1))@1 as count(*)], statistics=[Rows=Inexact(8), Bytes=Inexact(96), [(Col[0]: Min=Inexact(Int32(1992)) Max=Inexact(Int32(1998))),(Col[1]:)]]
02)--AggregateExec: mode=FinalPartitioned, gby=[date_part(Utf8("year"),date_stats.d)@0 as date_part(Utf8("year"),date_stats.d)], aggr=[count(Int64(1))], statistics=[Rows=Inexact(8), Bytes=Inexact(32), [(Col[0]: Min=Inexact(Int32(1992)) Max=Inexact(Int32(1998))),(Col[1]:)]]
03)----RepartitionExec: partitioning=Hash([date_part(Utf8("year"),date_stats.d)@0], 2), input_partitions=1, statistics=[Rows=Inexact(2526), Bytes=Inexact(10104), [(Col[0]: Min=Inexact(Int32(1992)) Max=Inexact(Int32(1998))),(Col[1]:)]]
04)------AggregateExec: mode=Partial, gby=[date_part(year, d@0) as date_part(Utf8("year"),date_stats.d)], aggr=[count(Int64(1))], statistics=[Rows=Inexact(2526), Bytes=Inexact(10104), [(Col[0]: Min=Inexact(Int32(1992)) Max=Inexact(Int32(1998))),(Col[1]:)]]
05)--------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_statistics/dates.parquet]]}, projection=[d], file_type=parquet, statistics=[Rows=Exact(2526), Bytes=Exact(10104), [(Col[0]: Min=Exact(Date32("1992-01-02")) Max=Exact(Date32("1998-12-01")) Null=Exact(0) ScanBytes=Exact(10104))]]

statement ok
SET datafusion.explain.show_statistics = false;

query II rowsort
SELECT date_part('year', d) AS y, COUNT(*) FROM date_stats GROUP BY y;
----
1992 365
1993 365
1994 365
1995 365
1996 366
1997 365
1998 335

statement ok
DROP TABLE date_stats;

# The key is nullable but has no NULLs. The partial aggregate keeps the NULL
# count of the key, so the final aggregate adds no NULL group to the 7 values.
statement ok
COPY (SELECT CASE WHEN value < 0 THEN NULL ELSE CAST(value % 7 + 1 AS INT) END AS k FROM range(0, 10000))
TO 'test_files/scratch/parquet_statistics/nullable_key.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE nullable_key STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_statistics/nullable_key.parquet';

statement ok
SET datafusion.explain.show_statistics = true;

query TT
EXPLAIN SELECT k, COUNT(*) FROM nullable_key GROUP BY k;
----
physical_plan
01)ProjectionExec: expr=[k@0 as k, count(Int64(1))@1 as count(*)], statistics=[Rows=Inexact(7), Bytes=Inexact(84), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0)),(Col[1]:)]]
02)--AggregateExec: mode=FinalPartitioned, gby=[k@0 as k], aggr=[count(Int64(1))], statistics=[Rows=Inexact(7), Bytes=Inexact(28), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0)),(Col[1]:)]]
03)----RepartitionExec: partitioning=Hash([k@0], 2), input_partitions=2, statistics=[Rows=Inexact(10000), Bytes=Inexact(40000), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0)),(Col[1]:)]]
04)------AggregateExec: mode=Partial, gby=[k@0 as k], aggr=[count(Int64(1))], statistics=[Rows=Inexact(10000), Bytes=Inexact(40000), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0)),(Col[1]:)]]
05)--------RepartitionExec: partitioning=RoundRobinBatch(2), input_partitions=1, statistics=[Rows=Exact(10000), Bytes=Exact(40000), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0) ScanBytes=Exact(40000))]]
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_statistics/nullable_key.parquet]]}, projection=[k], file_type=parquet, statistics=[Rows=Exact(10000), Bytes=Exact(40000), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0) ScanBytes=Exact(40000))]]

# acos can return NaN, which floating-point intervals cannot represent.
query TT
EXPLAIN SELECT acos(CAST(k AS DOUBLE) * 100) FROM nullable_key;
----
physical_plan
01)ProjectionExec: expr=[acos(CAST(k@0 AS Float64) * 100) as acos(nullable_key.k * Int64(100))], statistics=[Rows=Exact(10000), Bytes=Exact(80000), [(Col[0]:)]]
02)--RepartitionExec: partitioning=RoundRobinBatch(2), input_partitions=1, statistics=[Rows=Exact(10000), Bytes=Exact(40000), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0) ScanBytes=Exact(40000))]]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/parquet_statistics/nullable_key.parquet]]}, projection=[k], file_type=parquet, statistics=[Rows=Exact(10000), Bytes=Exact(40000), [(Col[0]: Min=Exact(Int32(1)) Max=Exact(Int32(7)) Null=Exact(0) ScanBytes=Exact(40000))]]

statement ok
SET datafusion.explain.show_statistics = false;

statement ok
DROP TABLE nullable_key;

statement ok
SET datafusion.execution.target_partitions = 4;

# Config reset
statement ok
RESET datafusion.execution.collect_statistics;

statement ok
RESET datafusion.explain.physical_plan_only;

statement ok
RESET datafusion.explain.show_statistics;
