##########
# Tests for repartitioning
##########

# Set 4 partitions for deterministic output plans
statement ok
set datafusion.execution.target_partitions = 4;

statement ok
COPY  (VALUES (1, 2), (2, 5), (3, 2), (4, 5), (5, 0)) TO 'test_files/scratch/repartition/parquet_table/2.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE parquet_table(column1 int, column2 int)
STORED AS PARQUET
LOCATION 'test_files/scratch/repartition/parquet_table/';

# enable round robin repartitioning
statement ok
set datafusion.optimizer.enable_round_robin_repartition = true;

query TT
EXPLAIN SELECT column1, SUM(column2) FROM parquet_table GROUP BY column1;
----
logical_plan
01)Aggregate: groupBy=[[parquet_table.column1]], aggr=[[sum(CAST(parquet_table.column2 AS Int64))]]
02)--TableScan: parquet_table projection=[column1, column2]
physical_plan
01)AggregateExec: mode=FinalPartitioned, gby=[column1@0 as column1], aggr=[sum(parquet_table.column2)]
02)--RepartitionExec: partitioning=Hash([column1@0], 4), input_partitions=1
03)----AggregateExec: mode=Partial, gby=[column1@0 as column1], aggr=[sum(parquet_table.column2)]
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/repartition/parquet_table/2.parquet]]}, projection=[column1, column2], file_type=parquet

# disable round robin repartitioning
statement ok
set datafusion.optimizer.enable_round_robin_repartition = false;

query TT
EXPLAIN SELECT column1, SUM(column2) FROM parquet_table GROUP BY column1;
----
logical_plan
01)Aggregate: groupBy=[[parquet_table.column1]], aggr=[[sum(CAST(parquet_table.column2 AS Int64))]]
02)--TableScan: parquet_table projection=[column1, column2]
physical_plan
01)AggregateExec: mode=FinalPartitioned, gby=[column1@0 as column1], aggr=[sum(parquet_table.column2)]
02)--RepartitionExec: partitioning=Hash([column1@0], 4), input_partitions=1
03)----AggregateExec: mode=Partial, gby=[column1@0 as column1], aggr=[sum(parquet_table.column2)]
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/repartition/parquet_table/2.parquet]]}, projection=[column1, column2], file_type=parquet


# Cleanup
statement ok
DROP TABLE parquet_table;



# Unbounded repartition
# See https://github.com/apache/datafusion/issues/5278
# Set up unbounded table and run a query - the query plan should display a `RepartitionExec`
# and a `CoalescePartitionsExec`
statement ok
CREATE UNBOUNDED EXTERNAL TABLE sink_table (
        c1  VARCHAR NOT NULL,
        c2  TINYINT NOT NULL,
        c3  SMALLINT NOT NULL,
        c4  SMALLINT NOT NULL,
        c5  INTEGER NOT NULL,
        c6  BIGINT NOT NULL,
        c7  SMALLINT NOT NULL,
        c8  INT NOT NULL,
        c9  INT UNSIGNED NOT NULL,
        c10 BIGINT UNSIGNED NOT NULL,
        c11 FLOAT NOT NULL,
        c12 DOUBLE NOT NULL,
        c13 VARCHAR NOT NULL
    )
STORED AS CSV
LOCATION '../../testing/data/csv/aggregate_test_100.csv'
OPTIONS ('format.has_header' 'true');

query TII
SELECT c1, c2, c3 FROM sink_table WHERE c3 > 0 LIMIT 5;
----
c 2 1
b 1 29
e 3 104
a 3 13
d 1 38

statement ok
set datafusion.execution.target_partitions = 3;

statement ok
set datafusion.optimizer.enable_round_robin_repartition = true;

query TT
EXPLAIN SELECT c1, c2, c3 FROM sink_table WHERE c3 > 0 LIMIT 5;
----
logical_plan
01)Limit: skip=0, fetch=5
02)--Filter: sink_table.c3 > Int16(0)
03)----TableScan: sink_table projection=[c1, c2, c3]
physical_plan
01)CoalescePartitionsExec: fetch=5
02)--FilterExec: c3@2 > 0, fetch=5
03)----RepartitionExec: partitioning=RoundRobinBatch(3), input_partitions=1
04)------StreamingTableExec: partition_sizes=1, projection=[c1, c2, c3], infinite_source=true

# Start repartition on empty column test.
# See https://github.com/apache/datafusion/issues/12057

statement ok
CREATE TABLE t1(v1 int);

statement ok
INSERT INTO t1 values(42);

query I
SELECT sum(1) OVER (PARTITION BY false=false) 
FROM t1 WHERE ((false > (v1 = v1)) IS DISTINCT FROM true);
----
1

# Config reset

# The SLT runner sets `target_partitions` to 4 instead of using the default, so
# reset it explicitly.
statement ok
set datafusion.execution.target_partitions = 4;

statement ok
reset datafusion.optimizer.enable_round_robin_repartition;

statement ok
DROP TABLE t1;

# End repartition on empty columns test

# Start Full join repartition tests.

# One row per batch lets the tiny tables below spread over four partitions.
statement ok
set datafusion.execution.batch_size = 1;

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold = 0;

statement ok
set datafusion.optimizer.hash_join_single_partition_threshold_rows = 0;

statement ok
CREATE TABLE t1 AS SELECT * FROM (VALUES (CAST(0 AS BIGINT)), (NULL)) t(a);

statement ok
CREATE TABLE t2 AS SELECT * FROM (VALUES (CAST(0 AS BIGINT), CAST(0 AS BIGINT)), (NULL, NULL)) t(c, y);

# The filter keeps `c = coalesce(y, 0)`, which fails on the left-only row, so both rows
# land in group 0 only if the aggregate repartitions the Full join output.
query TT
EXPLAIN SELECT coalesce(a, coalesce(y, 0)) AS k, count(*), count(c)
FROM t1 FULL JOIN (SELECT * FROM t2 WHERE c = coalesce(y, 0)) r ON a = c
GROUP BY coalesce(a, coalesce(y, 0));
----
logical_plan
01)Projection: coalesce(t1.a,coalesce(r.y,Int64(0))) AS k, count(Int64(1)) AS count(*), count(r.c)
02)--Aggregate: groupBy=[[CASE WHEN t1.a IS NOT NULL THEN t1.a ELSE CASE WHEN r.y IS NOT NULL THEN r.y ELSE Int64(0) END END AS coalesce(t1.a,coalesce(r.y,Int64(0)))]], aggr=[[count(Int64(1)), count(r.c)]]
03)----Full Join: t1.a = r.c
04)------TableScan: t1 projection=[a]
05)------SubqueryAlias: r
06)--------Filter: t2.c = CASE WHEN t2.y IS NOT NULL THEN t2.y ELSE Int64(0) END
07)----------TableScan: t2 projection=[c, y]
physical_plan
01)ProjectionExec: expr=[coalesce(t1.a,coalesce(r.y,Int64(0)))@0 as k, count(Int64(1))@1 as count(*), count(r.c)@2 as count(r.c)]
02)--AggregateExec: mode=FinalPartitioned, gby=[coalesce(t1.a,coalesce(r.y,Int64(0)))@0 as coalesce(t1.a,coalesce(r.y,Int64(0)))], aggr=[count(Int64(1)), count(r.c)]
03)----RepartitionExec: partitioning=Hash([coalesce(t1.a,coalesce(r.y,Int64(0)))@0], 4), input_partitions=4
04)------AggregateExec: mode=Partial, gby=[CASE WHEN a@0 IS NOT NULL THEN a@0 ELSE CASE WHEN y@2 IS NOT NULL THEN y@2 ELSE 0 END END as coalesce(t1.a,coalesce(r.y,Int64(0)))], aggr=[count(Int64(1)), count(r.c)]
05)--------HashJoinExec: mode=Partitioned, join_type=Full, on=[(c@0, a@0)], projection=[a@2, c@0, y@1]
06)----------RepartitionExec: partitioning=Hash([c@0], 4), input_partitions=4
07)------------FilterExec: c@0 = CASE WHEN y@1 IS NOT NULL THEN y@1 ELSE 0 END
08)--------------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
09)----------------DataSourceExec: partitions=1, partition_sizes=[2]
10)----------RepartitionExec: partitioning=Hash([a@0], 4), input_partitions=1
11)------------DataSourceExec: partitions=1, partition_sizes=[2]

query III
SELECT coalesce(a, coalesce(y, 0)) AS k, count(*), count(c)
FROM t1 FULL JOIN (SELECT * FROM t2 WHERE c = coalesce(y, 0)) r ON a = c
GROUP BY coalesce(a, coalesce(y, 0));
----
0 2 1

# A computed join key with an unmatched row feeds an aggregate on the coalesced key. All
# three rows have key 0, so they must land in one group.
query TT
EXPLAIN SELECT coalesce(a, coalesce(y, 0)) AS k, count(*)
FROM t1 FULL JOIN t2 ON a = coalesce(y, 0)
GROUP BY coalesce(a, coalesce(y, 0));
----
logical_plan
01)Projection: coalesce(t1.a,coalesce(t2.y,Int64(0))) AS k, count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[CASE WHEN t1.a IS NOT NULL THEN t1.a ELSE CASE WHEN t2.y IS NOT NULL THEN t2.y ELSE Int64(0) END END AS coalesce(t1.a,coalesce(t2.y,Int64(0)))]], aggr=[[count(Int64(1))]]
03)----Full Join: t1.a = CASE WHEN t2.y IS NOT NULL THEN t2.y ELSE Int64(0) END
04)------TableScan: t1 projection=[a]
05)------TableScan: t2 projection=[y]
physical_plan
01)ProjectionExec: expr=[coalesce(t1.a,coalesce(t2.y,Int64(0)))@0 as k, count(Int64(1))@1 as count(*)]
02)--AggregateExec: mode=FinalPartitioned, gby=[coalesce(t1.a,coalesce(t2.y,Int64(0)))@0 as coalesce(t1.a,coalesce(t2.y,Int64(0)))], aggr=[count(Int64(1))]
03)----RepartitionExec: partitioning=Hash([coalesce(t1.a,coalesce(t2.y,Int64(0)))@0], 4), input_partitions=4
04)------AggregateExec: mode=Partial, gby=[CASE WHEN a@0 IS NOT NULL THEN a@0 ELSE CASE WHEN y@1 IS NOT NULL THEN y@1 ELSE 0 END END as coalesce(t1.a,coalesce(t2.y,Int64(0)))], aggr=[count(Int64(1))]
05)--------HashJoinExec: mode=Partitioned, join_type=Full, on=[(CASE WHEN t2.y IS NOT NULL THEN t2.y ELSE Int64(0) END@1, a@0)], projection=[a@2, y@0]
06)----------RepartitionExec: partitioning=Hash([CASE WHEN t2.y IS NOT NULL THEN t2.y ELSE Int64(0) END@1], 4), input_partitions=4
07)------------ProjectionExec: expr=[y@0 as y, CASE WHEN y@0 IS NOT NULL THEN y@0 ELSE 0 END as CASE WHEN t2.y IS NOT NULL THEN t2.y ELSE Int64(0) END]
08)--------------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
09)----------------DataSourceExec: partitions=1, partition_sizes=[2]
10)----------RepartitionExec: partitioning=Hash([a@0], 4), input_partitions=1
11)------------DataSourceExec: partitions=1, partition_sizes=[2]

query II
SELECT coalesce(a, coalesce(y, 0)) AS k, count(*)
FROM t1 FULL JOIN t2 ON a = coalesce(y, 0)
GROUP BY coalesce(a, coalesce(y, 0));
----
0 3

statement ok
CREATE TABLE t3 AS SELECT * FROM (VALUES (CAST(1 AS BIGINT)), (2), (NULL), (NULL)) t(k);

statement ok
CREATE TABLE t4 AS SELECT * FROM (VALUES (CAST(2 AS BIGINT)), (3), (NULL)) t(k);

# NULL keys never match under `=`, and every NULL row still shares one partition, so the
# aggregate on the coalesced key needs no repartition and returns a single NULL group.
query TT
EXPLAIN SELECT coalesce(t3.k, t4.k) AS k, count(*)
FROM t3 FULL JOIN t4 ON t3.k = t4.k
GROUP BY coalesce(t3.k, t4.k);
----
logical_plan
01)Projection: coalesce(t3.k,t4.k) AS k, count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[CASE WHEN t3.k IS NOT NULL THEN t3.k ELSE t4.k END AS coalesce(t3.k,t4.k)]], aggr=[[count(Int64(1))]]
03)----Full Join: t3.k = t4.k
04)------TableScan: t3 projection=[k]
05)------TableScan: t4 projection=[k]
physical_plan
01)ProjectionExec: expr=[coalesce(t3.k,t4.k)@0 as k, count(Int64(1))@1 as count(*)]
02)--AggregateExec: mode=SinglePartitioned, gby=[CASE WHEN k@0 IS NOT NULL THEN k@0 ELSE k@1 END as coalesce(t3.k,t4.k)], aggr=[count(Int64(1))]
03)----HashJoinExec: mode=Partitioned, join_type=Full, on=[(k@0, k@0)], projection=[k@1, k@0]
04)------RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=1
05)--------DataSourceExec: partitions=1, partition_sizes=[3]
06)------RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4
07)--------DataSourceExec: partitions=4, partition_sizes=[1, 1, 1, 1]

query II rowsort
SELECT coalesce(t3.k, t4.k) AS k, count(*)
FROM t3 FULL JOIN t4 ON t3.k = t4.k
GROUP BY coalesce(t3.k, t4.k);
----
1 1
2 1
3 1
NULL 3

# Under `IS NOT DISTINCT FROM` the NULL keys match each other.
query TT
EXPLAIN SELECT coalesce(t3.k, t4.k) AS k, count(*)
FROM t3 FULL JOIN t4 ON t3.k IS NOT DISTINCT FROM t4.k
GROUP BY coalesce(t3.k, t4.k);
----
logical_plan
01)Projection: coalesce(t3.k,t4.k) AS k, count(Int64(1)) AS count(*)
02)--Aggregate: groupBy=[[CASE WHEN t3.k IS NOT NULL THEN t3.k ELSE t4.k END AS coalesce(t3.k,t4.k)]], aggr=[[count(Int64(1))]]
03)----Full Join: t3.k = t4.k
04)------TableScan: t3 projection=[k]
05)------TableScan: t4 projection=[k]
physical_plan
01)ProjectionExec: expr=[coalesce(t3.k,t4.k)@0 as k, count(Int64(1))@1 as count(*)]
02)--AggregateExec: mode=SinglePartitioned, gby=[CASE WHEN k@0 IS NOT NULL THEN k@0 ELSE k@1 END as coalesce(t3.k,t4.k)], aggr=[count(Int64(1))]
03)----HashJoinExec: mode=Partitioned, join_type=Full, on=[(k@0, k@0)], projection=[k@1, k@0], NullsEqual: true
04)------RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=1
05)--------DataSourceExec: partitions=1, partition_sizes=[3]
06)------RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=4
07)--------DataSourceExec: partitions=4, partition_sizes=[1, 1, 1, 1]

query II rowsort
SELECT coalesce(t3.k, t4.k) AS k, count(*)
FROM t3 FULL JOIN t4 ON t3.k IS NOT DISTINCT FROM t4.k
GROUP BY coalesce(t3.k, t4.k);
----
1 1
2 1
3 1
NULL 2

# Config reset

statement ok
reset datafusion.execution.batch_size;

statement ok
reset datafusion.optimizer.hash_join_single_partition_threshold;

statement ok
reset datafusion.optimizer.hash_join_single_partition_threshold_rows;

statement ok
DROP TABLE t1;

statement ok
DROP TABLE t2;

statement ok
DROP TABLE t3;

statement ok
DROP TABLE t4;

# End Full join repartition tests
