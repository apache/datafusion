# Joins of every type, whose results must not depend on the join mode

query II
SELECT count(*), sum(v) FROM dim JOIN fact ON dim.k = fact.k;
----
5000 24752500

query I
SELECT count(*) FROM fact WHERE k IN (SELECT k FROM dim);
----
5000

query I
SELECT count(*) FROM fact WHERE k NOT IN (SELECT k FROM dim);
----
5000

query I
SELECT count(*) FROM dim WHERE k IN (SELECT k FROM fact WHERE v < 50);
----
49

query I
SELECT count(*) FROM dim WHERE NOT EXISTS (SELECT 1 FROM fact WHERE fact.k = dim.k AND v < 50);
----
51

query II
SELECT count(*), count(fact.k) FROM dim LEFT JOIN fact ON dim.k = fact.k AND v < 50;
----
100 49

query III
SELECT count(*), count(dim.k), count(fact.k) FROM dim FULL JOIN fact ON dim.k = fact.k AND v < 50;
----
10051 100 10000
