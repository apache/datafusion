# Session-local named credentials. Values are public synthetic fixtures.

statement ok
CREATE SECRET shared (TYPE synthetic, TOKEN 'slt-test-token');

statement error Secret 'shared' already exists
CREATE SECRET shared (TOKEN 'must-not-replace');

statement ok
CREATE SECRET IF NOT EXISTS shared (TOKEN 'ignored');

statement ok
CREATE OR REPLACE SECRET shared (TOKEN 'replacement');

statement error CREATE SECRET cannot combine OR REPLACE and IF NOT EXISTS
CREATE OR REPLACE SECRET IF NOT EXISTS shared (TOKEN 'invalid');

statement ok
DROP SECRET shared;

statement error Secret 'shared' does not exist
DROP SECRET shared;

statement ok
DROP SECRET IF EXISTS shared;

# Ordinary SQL identifier normalization applies to secret names.
statement ok
CREATE SECRET MIXED (TOKEN 'lower-name');

statement ok
DROP SECRET mixed;

statement ok
CREATE SECRET "Quoted" (TOKEN 'quoted-name');

statement error Secret 'quoted' does not exist
DROP SECRET quoted;

statement ok
DROP SECRET "Quoted";

statement error duplicate option names
CREATE SECRET duplicates (TOKEN 'first', token 'second');

statement error Invalid CREATE SECRET syntax
CREATE SECRET incomplete (TOKEN 'not-an-expression' + 'another');

# Unrelated statements still execute after secret DDL.
query I
SELECT 42;
----
42
