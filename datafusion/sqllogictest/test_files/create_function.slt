## SQL tests for CREATE / DROP FUNCTION
##
## Note that DataFusion provides a pluggable system for creating functions
## but has no built in support for doing so.

# Create function will fail unless a user supplied function factory is supplied
statement error DataFusion error: Invalid or Unsupported Configuration: Function factory has not been configured
CREATE FUNCTION foo (DOUBLE) RETURNS DOUBLE RETURN $1;

# Invalid placeholders are rejected during planning, before a function
# factory is consulted (see #25038)
statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$2
CREATE FUNCTION foo (DOUBLE) RETURNS DOUBLE RETURN $1 + $2;

# a zero-argument function cannot reference arguments either
statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$1
CREATE FUNCTION foo_zero () RETURNS DOUBLE RETURN $1;

# placeholders inside subqueries are validated too
statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_subquery (DOUBLE) RETURNS DOUBLE RETURN $1 + (SELECT $9);

# placeholders in argument default expressions are validated too
statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_default (a DOUBLE, b DOUBLE DEFAULT $9) RETURNS DOUBLE RETURN $1 + $2;

# out of range placeholder in a subquery's LIMIT clause
statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_limit (DOUBLE) RETURNS BOOLEAN RETURN $1 IN (SELECT v FROM (VALUES (1.0), (2.0)) AS t(v) ORDER BY v LIMIT $9);

# Named arguments are resolved before placeholder validation
statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$3
CREATE FUNCTION foo_named (a DOUBLE, b DOUBLE) RETURNS DOUBLE RETURN $a + $3;

statement error DataFusion error: Error during planning: Unknown placeholder: \$a
CREATE FUNCTION foo_unknown () RETURNS DOUBLE RETURN $a;

# Defaults use positional placeholders
statement error DataFusion error: Error during planning: Unknown placeholder: \$a
CREATE FUNCTION foo_named_default (a DOUBLE, b DOUBLE DEFAULT $a) RETURNS DOUBLE RETURN $1 + $2;

statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_exists (DOUBLE) RETURNS BOOLEAN RETURN EXISTS (SELECT $9);

statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_in (DOUBLE) RETURNS BOOLEAN RETURN $1 IN (SELECT $9);

statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_any (DOUBLE) RETURNS BOOLEAN RETURN $1 = ANY (SELECT $9);

statement error DataFusion error: Error during planning: Invalid placeholder, out of range: \$9
CREATE FUNCTION foo_nested (DOUBLE) RETURNS BOOLEAN RETURN EXISTS (SELECT 1 WHERE (SELECT $9) > 0.0);

# Valid definitions reach the function factory
statement error DataFusion error: Invalid or Unsupported Configuration: Function factory has not been configured
CREATE FUNCTION foo_valid (DOUBLE, DOUBLE) RETURNS DOUBLE RETURN $1 + $2;

statement error DataFusion error: Invalid or Unsupported Configuration: Function factory has not been configured
CREATE FUNCTION foo_valid_default (a DOUBLE, b DOUBLE DEFAULT $1) RETURNS DOUBLE RETURN $1 + $2;

statement error DataFusion error: Invalid or Unsupported Configuration: Function factory has not been configured
CREATE FUNCTION foo_valid_subquery (DOUBLE) RETURNS BOOLEAN RETURN $1 IN (SELECT v FROM (VALUES (1.0)) AS t(v) WHERE v > $1);

# multi-part identifiers are not supported
statement error DataFusion error: This feature is not implemented: Qualified functions are not supported
CREATE FUNCTION foo.bar (DOUBLE) RETURNS DOUBLE RETURN $1 + $2;

statement error DataFusion error: This feature is not implemented: Qualified functions are not supported
DROP FUNCTION foo.bar;

# Show it is possible to drop existing (UDF) functions
query I
select abs(-1);
----
1

# drop the function
statement ok
DROP FUNCTION abs;

# now the query errors
query error Invalid function 'abs'.
select abs(-1);

# Can't drop the function again
statement error DataFusion error: Execution error: Function does not exist
DROP FUNCTION abs;

# But DROP IF EXISTS does not error
statement ok
DROP FUNCTION IF EXISTS abs;
