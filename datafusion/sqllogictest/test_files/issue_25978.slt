##########
# Regression test for https://github.com/apache/datafusion/issues/25978
# A GROUP BY aggregate over a UNION ALL fails to plan when one branch
# projects coalesce(<nullable boolean expression>, FALSE).
# The CSE optimizer rewrites this into an AND/OR pattern whose
# nullability was incorrectly reported, causing a physical vs logical
# schema mismatch.
##########

statement ok
CREATE TABLE a (k VARCHAR NOT NULL, x VARCHAR) AS VALUES ('k1', 'y'), ('k2', NULL);

statement ok
CREATE TABLE b (k VARCHAR NOT NULL) AS VALUES ('k3');

query TB rowsort
SELECT k, bool_or(f) AS f FROM (
  SELECT k, coalesce(x = 'y', FALSE) AS f FROM a
  UNION ALL
  SELECT k, TRUE AS f FROM b
) u GROUP BY k;
----
k1 true
k2 false
k3 true

statement ok
DROP TABLE a;

statement ok
DROP TABLE b;
