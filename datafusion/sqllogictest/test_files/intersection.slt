DROP TABLE set_all_left;

statement ok
DROP TABLE set_all_right;

statement ok
DROP TABLE set_all_pairs_left;

statement ok
DROP TABLE set_all_pairs_right;

statement ok
DROP TABLE set_all_a;

statement ok
DROP TABLE set_all_b;

statement ok
DROP TABLE set_all_c;

statement ok
DROP TABLE set_all_t;

statement ok
DROP TABLE set_all_u;
