----
20806 200000 20000100000

# nullable key
query II
select count(*), sum(c) from (select case when v % 11 = 0 then null else v % 5003 end as k, count(*) c from t group by k);
----
5004 200000

# distinct has no accumulators
query I
select count(*) from (select distinct v % 20011 as k, v % 3 as j from t);
----
60033

# accumulators with list state
query II
select count(*), sum(d) from (select v % 5003 as k, count(distinct v % 17) d from t group by k);
----
5003 85051

# median
query IR
select count(*), sum(m) from (select v % 5003 as k, median(v) m from t group by k);
----
5003 500302501.5

# array_agg
query II
select count(*), sum(array_length(a)) from (select v % 5003 as k, array_agg(v) a from t group by k);
----
5003 200000

# every row its own group, largest groups first
query III
select k, c, s from (select v as k, count(*) c, sum(v) s from t group by v) order by k desc limit 3;
----
200000 1 200000
199999 1 199999
199998 1 199998

statement ok
set datafusion.execution.partial_aggregation_flush_bytes = 0;

