# Verify the information schema does not exit by default
statement error DataFusion error: Error during planning: table 'datafusion.information_schema.tables' not found
SELECT * from information_schema.tables

# SHOW resolves its content directly (like DESCRIBE/SHOW COLUMNS), so it
# works regardless of whether information_schema is enabled.
query TT
SHOW datafusion.catalog.information_schema
----
datafusion.catalog.information_schema false

# Turn it on

# expect that the queries now work
statement ok
set datafusion.catalog.information_schema = true;

# Verify the information schema now does exist and is empty
query TTTT rowsort
SELECT * from information_schema.tables;
----
datafusion information_schema columns VIEW
datafusion information_schema df_settings VIEW
datafusion information_schema parameters VIEW
datafusion information_schema routines VIEW
datafusion information_schema schemata VIEW
datafusion information_schema tables VIEW
datafusion information_schema views VIEW

############
# Create multiple catalogs
###########
statement ok
create catalog my_catalog;

statement ok
create schema my_catalog.my_schema;

statement ok
set datafusion.catalog.default_catalog = my_catalog;

statement ok
set datafusion.catalog.default_schema = my_schema;

statement ok
create table t1 as values(1);

statement ok
create table t2 as values(1);

statement ok
create catalog my_other_catalog;

statement ok
create schema my_other_catalog.my_other_schema;

statement ok
set datafusion.catalog.default_catalog = my_other_catalog;

statement ok
set datafusion.catalog.default_schema = my_other_schema;

statement ok
create table t3 as values(1);

query TTT rowsort
SELECT table_catalog, table_schema, table_name
FROM my_catalog.information_schema.tables
WHERE table_schema <> 'information_schema';
----
my_catalog my_schema t1
my_catalog my_schema t2
my_other_catalog my_other_schema t3

query TTT rowsort
SELECT table_catalog, table_schema, table_name
FROM my_other_catalog.information_schema.tables
WHERE table_schema <> 'information_schema';
----
my_catalog my_schema t1
my_catalog my_schema t2
my_other_catalog my_other_schema t3

query TTTT rowsort
SELECT * from information_schema.tables;
----
datafusion information_schema columns VIEW
datafusion information_schema df_settings VIEW
datafusion information_schema parameters VIEW
datafusion information_schema routines VIEW
datafusion information_schema schemata VIEW
datafusion information_schema tables VIEW
datafusion information_schema views VIEW
my_catalog information_schema columns VIEW
my_catalog information_schema df_settings VIEW
my_catalog information_schema parameters VIEW
my_catalog information_schema routines VIEW
my_catalog information_schema schemata VIEW
my_catalog information_schema tables VIEW
my_catalog information_schema views VIEW
my_catalog my_schema t1 BASE TABLE
my_catalog my_schema t2 BASE TABLE
my_other_catalog information_schema columns VIEW
my_other_catalog information_schema df_settings VIEW
my_other_catalog information_schema parameters VIEW
my_other_catalog information_schema routines VIEW
my_other_catalog information_schema schemata VIEW
my_other_catalog information_schema tables VIEW
my_other_catalog information_schema views VIEW
my_other_catalog my_other_schema t3 BASE TABLE

############
# Enable information schema partitioning so that the `information_schema`
# of each catalog only describes the objects in that catalog.
###########
statement ok
set datafusion.catalog.partition_information_schema = true;

query TTTT rowsort
SELECT * FROM my_catalog.information_schema.tables;
----
my_catalog information_schema columns VIEW
my_catalog information_schema df_settings VIEW
my_catalog information_schema parameters VIEW
my_catalog information_schema routines VIEW
my_catalog information_schema schemata VIEW
my_catalog information_schema tables VIEW
my_catalog information_schema views VIEW
my_catalog my_schema t1 BASE TABLE
my_catalog my_schema t2 BASE TABLE

query TTTT rowsort
SELECT * FROM my_other_catalog.information_schema.tables;
----
my_other_catalog information_schema columns VIEW
my_other_catalog information_schema df_settings VIEW
my_other_catalog information_schema parameters VIEW
my_other_catalog information_schema routines VIEW
my_other_catalog information_schema schemata VIEW
my_other_catalog information_schema tables VIEW
my_other_catalog information_schema views VIEW
my_other_catalog my_other_schema t3 BASE TABLE

query TTTT rowsort
SELECT * FROM datafusion.information_schema.tables;
----
datafusion information_schema columns VIEW
datafusion information_schema df_settings VIEW
datafusion information_schema parameters VIEW
datafusion information_schema routines VIEW
datafusion information_schema schemata VIEW
datafusion information_schema tables VIEW
datafusion information_schema views VIEW

# Unqualified `information_schema` resolves against the default catalog
query TTTT rowsort
SELECT * FROM information_schema.tables;
----
my_other_catalog information_schema columns VIEW
my_other_catalog information_schema df_settings VIEW
my_other_catalog information_schema parameters VIEW
my_other_catalog information_schema routines VIEW
my_other_catalog information_schema schemata VIEW
my_other_catalog information_schema tables VIEW
my_other_catalog information_schema views VIEW
my_other_catalog my_other_schema t3 BASE TABLE

query TTTTTTT rowsort
SELECT * FROM my_catalog.information_schema.schemata;
----
my_catalog my_schema NULL NULL NULL NULL NULL

query TTTTTTT rowsort
SELECT * FROM my_other_catalog.information_schema.schemata;
----
my_other_catalog my_other_schema NULL NULL NULL NULL NULL

query TTTT rowsort
SELECT table_catalog, table_schema, table_name, column_name
FROM my_catalog.information_schema.columns;
----
my_catalog my_schema t1 column1
my_catalog my_schema t2 column1

query TTTT rowsort
SELECT table_catalog, table_schema, table_name, column_name
FROM my_other_catalog.information_schema.columns;
----
my_other_catalog my_other_schema t3 column1

query TTT rowsort
SELECT table_catalog, table_schema, table_name
FROM my_catalog.information_schema.views
WHERE table_schema <> 'information_schema';
----
my_catalog my_schema t1
my_catalog my_schema t2

# SHOW statements are not affected by partition_information_schema and describe all catalogs
query TTTT rowsort
SHOW TABLES;
----
datafusion information_schema columns VIEW
datafusion information_schema df_settings VIEW
datafusion information_schema parameters VIEW
datafusion information_schema routines VIEW
datafusion information_schema schemata VIEW
datafusion information_schema tables VIEW
datafusion information_schema views VIEW
my_catalog information_schema columns VIEW
my_catalog information_schema df_settings VIEW
my_catalog information_schema parameters VIEW
my_catalog information_schema routines VIEW
my_catalog information_schema schemata VIEW
my_catalog information_schema tables VIEW
my_catalog information_schema views VIEW
my_catalog my_schema t1 BASE TABLE
my_catalog my_schema t2 BASE TABLE
my_other_catalog information_schema columns VIEW
my_other_catalog information_schema df_settings VIEW
my_other_catalog information_schema parameters VIEW
my_other_catalog information_schema routines VIEW
my_other_catalog information_schema schemata VIEW
my_other_catalog information_schema tables VIEW
my_other_catalog information_schema views VIEW
my_other_catalog my_other_schema t3 BASE TABLE

query TTTTTT
SHOW COLUMNS FROM my_catalog.my_schema.t1;
----
my_catalog my_schema t1 column1 Int64 NO

# The information schema of a catalog that does not exist cannot be queried
statement error DataFusion error: Error during planning: table 'no_such_catalog.information_schema.tables' not found
SELECT * FROM no_such_catalog.information_schema.tables;

# Resetting partition_information_schema makes every information schema global again
statement ok
RESET datafusion.catalog.partition_information_schema;

query TTT rowsort
SELECT table_catalog, table_schema, table_name
FROM my_other_catalog.information_schema.tables
WHERE table_schema <> 'information_schema';
----
my_catalog my_schema t1
my_catalog my_schema t2
my_other_catalog my_other_schema t3

# Cleanup

statement ok
drop table t3

statement ok
set datafusion.catalog.default_catalog = my_catalog;

statement ok
set datafusion.catalog.default_schema = my_schema;

statement ok
drop table t1

statement ok
drop table t2

# Config reset
statement ok
RESET datafusion.catalog.default_catalog;

statement ok
RESET datafusion.catalog.default_schema;

statement ok
RESET datafusion.catalog.information_schema;
