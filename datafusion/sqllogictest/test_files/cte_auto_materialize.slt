# Limits and automatic materialization.

# A `LIMIT` above all references inlines the CTE, so the limit can stop each
# copy early.
query TT
EXPLAIN WITH c AS (SELECT k, sum(v) AS s FROM t GROUP BY k)
SELECT a.k FROM c a JOIN c b ON a.s = b.s LIMIT 1
----
logical_plan
01)Projection: a.k
02)--Limit: skip=0, fetch=1
03)----Inner Join: a.s = b.s
04)------SubqueryAlias: a
05)--------SubqueryAlias: c
06)----------Projection: t.k, sum(t.v) AS s
07)------------Aggregate: groupBy=[[t.k]], aggr=[[sum(CAST(t.v AS Int64))]]
08)--------------TableScan: t projection=[k, v]
09)------SubqueryAlias: b
10)--------SubqueryAlias: c
11)----------Projection: sum(t.v) AS s
12)------------Aggregate: groupBy=[[t.k]], aggr=[[sum(CAST(t.v AS Int64))]]
13)--------------TableScan: t projection=[k, v]
physical_plan
01)CoalescePartitionsExec: fetch=1
02)--ProjectionExec: expr=[k@0 as k]
03)----HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(s@0, s@1)], projection=[k@1, s@2, s@0], fetch=1
04)------CoalescePartitionsExec
05)--------ProjectionExec: expr=[sum(t.v)@1 as s]
06)----------AggregateExec: mode=FinalPartitioned, gby=[k@0 as k], aggr=[sum(t.v)]
07)------------RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=1
08)--------------AggregateExec: mode=Partial, gby=[k@0 as k], aggr=[sum(t.v)]
09)----------------DataSourceExec: partitions=1, partition_sizes=[1]
10)------ProjectionExec: expr=[k@0 as k, sum(t.v)@1 as s]
11)--------AggregateExec: mode=FinalPartitioned, gby=[k@0 as k], aggr=[sum(t.v)]
12)----------RepartitionExec: partitioning=Hash([k@0], 4), input_partitions=1
13)------------AggregateExec: mode=Partial, gby=[k@0 as k], aggr=[sum(t.v)]
14)--------------DataSourceExec: partitions=1, partition_sizes=[1]

