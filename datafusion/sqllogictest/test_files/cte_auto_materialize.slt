# A `LIMIT` above only one side of the join keeps the CTE materialized,
# because the other side reads the full body.
query TT
EXPLAIN WITH c AS (SELECT k, sum(v) AS s FROM t GROUP BY k)
SELECT a.k FROM (SELECT * FROM c LIMIT 2) a JOIN c b ON a.s = b.s
