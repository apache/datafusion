set datafusion.sql_parser.dialect = 'Generic';

# An unbounded body cannot be buffered. An automatic CTE with such a body
# stays in the logical plan, and the physical planner inlines it, so the query
# still plans.
statement ok
CREATE UNBOUNDED EXTERNAL TABLE unbounded_t(c1 integer, c2 integer, c3 integer)
STORED AS CSV
LOCATION '../core/tests/data/empty.csv'
OPTIONS ('format.has_header' 'true');

query TT
EXPLAIN WITH u AS (SELECT c1 FROM unbounded_t UNION ALL SELECT c1 + 1 FROM unbounded_t)
SELECT c1 FROM u UNION ALL SELECT c1 FROM u
----
logical_plan
01)MaterializedCte: name=u, automatic=true
02)--SubqueryAlias: u
03)----Union
04)------Projection: CAST(unbounded_t.c1 AS Int64) AS c1
