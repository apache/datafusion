statement count 0
set datafusion.execution.listing_table_factory_infer_partitions = true;

# Test: files outside partition structure are skipped
# This simulates a table that transitioned from non-partitioned to
# hive-partitioned storage, leaving a stale file in the root directory.

# Create partitioned files first
query I
copy (values(1, 'alice'), (2, 'bob'))
to 'test_files/scratch/listing_table_partitions/root_file_skipped/year=2024/data.parquet';
----
2

query I
copy (values(3, 'charlie'))
to 'test_files/scratch/listing_table_partitions/root_file_skipped/year=2025/data.parquet';
----
1

# Create the table before adding the stale root file, so partition
# inference succeeds (it only runs at CREATE TABLE time).
statement count 0
create external table root_file_test
stored as parquet
location 'test_files/scratch/listing_table_partitions/root_file_skipped/';

# Now add a stale root-level file (outside any partition directory).
# This simulates a file left over from before partitioning was added.
query I
copy (values(99, 'stale'))
to 'test_files/scratch/listing_table_partitions/root_file_skipped/stale.parquet';
----
1

# The root file should be skipped — only partitioned files are included
query IT
select column1, column2 from root_file_test order by column1;
----
1 alice
2 bob
3 charlie

# Partition column should be accessible
query ITT
select column1, column2, year from root_file_test order by column1;
----
1 alice 2024
2 bob 2024
3 charlie 2025

# Partition filter should work
query ITT
select column1, column2, year from root_file_test where year = '2025';
----
3 charlie 2025

# COUNT should not include the root file's rows
query I
select count(*) from root_file_test;
----
3

# GROUP BY partition column should work
query TI
select year, count(*) from root_file_test group by year order by year;
----
2024 2
2025 1

# Test: with listing_table_strict_partitions, files outside the partition
# structure are an error instead of being skipped

# Disable the list files cache so the stale root file, written after the
# table was created, is listed
statement count 0
set datafusion.runtime.list_files_cache_limit = "0K";

query I
select count(*) from root_file_test;
----
3

statement count 0
set datafusion.execution.listing_table_strict_partitions = true;

query error DataFusion error: Error during planning: File '.*root_file_skipped/stale\.parquet' in table '.*' does not match partition columns \["year"\]: it is not under a directory for partition column 'year'\. Set datafusion\.execution\.listing_table_strict_partitions = false to skip such files
select count(*) from root_file_test;

# Only listed files are checked: a partition filter narrows the listing
# prefix to year=2025/, so the root file is never listed
query ITT
select column1, column2, year from root_file_test where year = '2025';
----
3 charlie 2025

# A file outside the partition directories errors when listed
query I
copy (values(1, 'alice'), (2, 'bob'))
to 'test_files/scratch/listing_table_partitions/stray_root_file/year=2024/data.parquet';
----
2

statement count 0
create external table stray_root_file (column1 int, column2 varchar, year varchar)
stored as parquet
partitioned by (year)
location 'test_files/scratch/listing_table_partitions/stray_root_file/';

query I
copy (values(3, 'charlie'))
to 'test_files/scratch/listing_table_partitions/stray_root_file/stray.parquet';
----
1

query error File '.*stray_root_file/stray\.parquet'.*does not match partition columns \["year"\]: it is not under a directory for partition column 'year'
select count(*) from stray_root_file;

# An insert lists every file in the table, so it fails even when writing to
# another partition
query error File '.*stray_root_file/stray\.parquet'.*does not match partition columns \["year"\]: it is not under a directory for partition column 'year'
insert into stray_root_file values (4, 'dave', '2026');

# Declaring fewer partition columns than the directories have is an error
statement count 0
create external table multi_part_only_a
stored as parquet
partitioned by (a)
location 'test_files/scratch/listing_table_partitions/multi_part/';

query error DataFusion error: Error during planning: File '.*multi_part/a=1/b=[0-9]+/file1\.parquet' in table '.*' does not match partition columns \["a"\]: directory 'b=[0-9]+' is not a declared partition column
select * from multi_part_only_a;

# Also for tables without partition columns
query error DataFusion error: Error during planning: File '.*multi_part/a=1/b=[0-9]+/file1\.parquet' in table '.*' does not match partition columns \[\]: directory 'a=1' is not a declared partition column
select * from infer_disabled;

# Matching files are read as usual
query TTT
select * from multi_part order by column1;
----
bar 1 100
baz 1 200
foo 1 100

