statement count 0
set datafusion.execution.listing_table_strict_partitions = false;

statement count 0
reset datafusion.runtime.list_files_cache_limit;

# Setting a runtime option rebuilds the session state, which turns this off
statement count 0
reset datafusion.catalog.create_default_catalog_and_schema;

# Without strict partitions, undeclared partition directories are read
query TT
select * from multi_part_only_a order by column1;
----
bar 1
baz 1
foo 1

# Test: a null partition value, which Hive compliant writers spell with a
# `__HIVE_DEFAULT_PARTITION__` directory, is read as NULL.

query I
copy (values(1, 'alice'))
to 'test_files/scratch/listing_table_partitions/null_part/d=2024-01-01/data.parquet';
----
1

query I
copy (values(2, 'bob'))
to 'test_files/scratch/listing_table_partitions/null_part/d=__HIVE_DEFAULT_PARTITION__/data.parquet';
----
1

statement count 0
create external table null_part (column1 int, column2 varchar, d date)
stored as parquet
partitioned by (d)
location 'test_files/scratch/listing_table_partitions/null_part/';

query ITD
select column1, column2, d from null_part order by column1;
----
1 alice 2024-01-01
2 bob NULL

query ITD
select column1, column2, d from null_part where d is null;
----
2 bob NULL

# The null partition does not match an equality filter.
query ITD
select column1, column2, d from null_part where d = '2024-01-01';
----
1 alice 2024-01-01

# ... nor an inequality filter.
query ITD
select column1, column2, d from null_part where d <> '2024-01-01';
----

query ITD
select column1, column2, d from null_part where d not in ('2024-01-01');
----

# Statistics for the null partition count its rows as nulls.
query I
select count(d) from null_part;
----
1

query DD
select min(d), max(d) from null_part;
----
2024-01-01 2024-01-01

# Partition columns inferred from the directories are dictionary encoded.
statement count 0
create external table null_part_inferred
stored as parquet
location 'test_files/scratch/listing_table_partitions/null_part/';

query TT
select arrow_typeof(d), d from null_part_inferred where d is null;
----
Dictionary(UInt16, Utf8) NULL

query I
select column1 from null_part_inferred where d <> '2024-01-01';
----

# A null partition still lets files be ordered by their partition value.
statement ok
set datafusion.execution.target_partitions = 1;

statement count 0
create external table null_part_ordered (column1 int, column2 varchar, d date)
stored as parquet
partitioned by (d)
with order (d)
location 'test_files/scratch/listing_table_partitions/null_part/';

query TT
explain select column1, d from null_part_ordered order by d;
----
logical_plan
01)Sort: null_part_ordered.d ASC NULLS LAST
02)--TableScan: null_part_ordered projection=[column1, d]
physical_plan DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/listing_table_partitions/null_part/d=2024-01-01/data.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/listing_table_partitions/null_part/d=__HIVE_DEFAULT_PARTITION__/data.parquet]]}, projection=[column1, d], output_ordering=[d@1 ASC NULLS LAST], file_type=parquet

query ID
select column1, d from null_part_ordered order by d;
----
1 2024-01-01
2 NULL

statement ok
set datafusion.execution.target_partitions = 4;

# Writing the null partition name as a real value is rejected, since it would
# be read back as NULL.
statement count 0
create external table null_part_write (a int, p varchar)
stored as parquet
partitioned by (p)
location 'test_files/scratch/listing_table_partitions/null_part_write/';

statement error Cannot write value '__HIVE_DEFAULT_PARTITION__' for partition column 'p': it is the null partition name and would be read back as NULL
insert into null_part_write values (1, 'x'), (2, '__HIVE_DEFAULT_PARTITION__');

# With the null partition name disabled, the value round trips.
statement ok
set datafusion.execution.listing_table_hive_default_partition_name = '';

query I
insert into null_part_write values (1, 'x'), (2, '__HIVE_DEFAULT_PARTITION__');
----
2

query IT
select a, p from null_part_write order by a;
----
1 x
2 __HIVE_DEFAULT_PARTITION__

statement ok
set datafusion.execution.listing_table_hive_default_partition_name = '__HIVE_DEFAULT_PARTITION__';
