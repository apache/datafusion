# --- Case G: partial/final aggregation under memory limit ---
# Four final aggregate partitions share the runtime pool; leave replay headroom.
statement ok
SET datafusion.runtime.memory_limit = '1M'

statement ok
SET datafusion.execution.target_partitions = 4

# Four final partitions share the greedy pool. Limit merge buffers so a
# partition that replays its spills can allocate while the other partitions
# retain their aggregate state.
# See https://github.com/apache/datafusion/issues/25423
statement ok
SET datafusion.runtime.max_spill_merge_fan_in = 2

query II
SELECT count(*), sum(total)
FROM (
  SELECT (v * 7) % 100000 AS k, sum(v) AS total
  FROM generate_series(1, 100000) AS t(v)
  GROUP BY (v * 7) % 100000
)
----
100000 5000050000

# Assert spill happened in the final aggregation and the partial aggregation
# reports memory-pressure emissions. Their exact counts are not deterministic,
# so assert only the spilled_rows unit and the presence of early_emit_count.
query TT
EXPLAIN ANALYZE
SELECT count(*), sum(total)
FROM (
  SELECT (v * 7) % 100000 AS k, sum(v) AS total
  FROM generate_series(1, 100000) AS t(v)
  GROUP BY (v * 7) % 100000
)
----
<slt:ignore>
06)----------AggregateExec: mode=FinalPartitioned, gby=[t.v * Int64(7) % Int64(100000)@0 as t.v * Int64(7) % Int64(100000)], aggr=[sum(t.v)], metrics=[<slt:ignore>spill_count=<slt:ignore>, spilled_bytes=<slt:ignore>, spilled_rows=<slt:ignore> K,<slt:ignore>]
<slt:ignore>
08)--------------AggregateExec: mode=Partial, gby=[v@0 * 7 % 100000 as t.v * Int64(7) % Int64(100000)], aggr=[sum(t.v)], metrics=[<slt:ignore>early_emit_count=<slt:ignore>]
<slt:ignore>

# --- Case H: DISTINCT ON with nested FIRST_VALUE state after spilling ---
# Merged list states must not retain the entire replay batch for every group.
# Check the complete nested payload as well as row count.
statement ok
SET datafusion.execution.target_partitions = 1

query II
SELECT count(*), count(*) FILTER (
  WHERE contents = [named_struct('key', k, 'value', repeat('v', 224))]
)
FROM (
  SELECT DISTINCT ON (k) k,
    [named_struct('key', k, 'value', repeat('v', 224))] AS contents
  FROM (
    SELECT (v * 7) % 8192 AS k
    FROM generate_series(0, 8191) AS t(v)
  )
)
----
8192 8192

# --- Case I: byte array keys in compressed spill files ---
# Compressed spill files store `Utf8`, `LargeUtf8`, `Binary` and `LargeBinary`
# columns as lengths, unless their batches are too small to benefit. The keys
# are cast because `varchar` maps to `Utf8View`.
statement ok
SET datafusion.execution.batch_size = 8192

statement ok
CREATE VIEW byte_keys AS
SELECT
  arrow_cast(CASE WHEN v % 10 = 0 THEN NULL ELSE concat('k', (v * 7) % 100000) END, 'Utf8') AS s,
  arrow_cast(concat('k', (v * 7) % 100000), 'LargeUtf8') AS ls,
  arrow_cast(concat('k', (v * 7) % 100000), 'Binary') AS b,
  arrow_cast(concat('k', (v * 7) % 100000), 'LargeBinary') AS lb
FROM generate_series(1, 100000) AS t(v)

statement ok
SET datafusion.execution.spill_compression = 'zstd'

query IITTII
SELECT count(*), count(s), min(s), max(ls), sum(length(s)), count(*) FILTER (
  WHERE arrow_cast(b, 'LargeUtf8') = ls AND arrow_cast(lb, 'LargeUtf8') = ls
    AND (s IS NULL OR s = ls)
)
FROM (SELECT s, ls, b, lb FROM byte_keys GROUP BY s, ls, b, lb)
----
100000 90000 k1 k99999 530001 100000

statement ok
SET datafusion.execution.spill_compression = 'lz4_frame'

query IITTII
SELECT count(*), count(s), min(s), max(ls), sum(length(s)), count(*) FILTER (
  WHERE arrow_cast(b, 'LargeUtf8') = ls AND arrow_cast(lb, 'LargeUtf8') = ls
    AND (s IS NULL OR s = ls)
)
FROM (SELECT s, ls, b, lb FROM byte_keys GROUP BY s, ls, b, lb)
----
100000 90000 k1 k99999 530001 100000

# Assert spill happened
query TT
EXPLAIN ANALYZE
SELECT count(*) FROM (SELECT s, ls, b, lb FROM byte_keys GROUP BY s, ls, b, lb)
----
<slt:ignore>
04)------AggregateExec: mode=Single, gby=[s@0 as s, ls@1 as ls, b@2 as b, lb@3 as lb], aggr=[], metrics=[<slt:ignore>spill_count=<slt:ignore>, spilled_bytes=<slt:ignore>, spilled_rows=<slt:ignore> K,<slt:ignore>]
<slt:ignore>

statement ok
RESET datafusion.execution.spill_compression

statement ok
DROP VIEW byte_keys

# --- Case J: a few groups with large state ---
# The array_agg states of all 32 groups do not fit in the memory limit, but a
# single group does. Spilling must write the groups in batches that can be
# read back within the limit, instead of one batch holding every group.
# See https://github.com/apache/datafusion/issues/25851
statement ok
RESET datafusion.runtime.max_spill_merge_fan_in

statement ok
SET datafusion.execution.batch_size = 8192

statement ok
SET datafusion.runtime.memory_limit = '24M'

# Partial/final aggregation: the final aggregation spills the partial states of
# its partition.
statement ok
SET datafusion.execution.target_partitions = 2

query II
SELECT count(*), sum(n)
FROM (
  SELECT v % 32 AS k, cardinality(array_agg(concat(CAST(v AS VARCHAR), repeat('x', 100)))) AS n
  FROM generate_series(1, 500000) AS t(v)
  GROUP BY v % 32
)
----
32 500000

# Assert the final aggregation spilled, the `spilled_bytes` metric must be in MB
query TT
EXPLAIN ANALYZE
SELECT count(*), sum(n)
FROM (
  SELECT v % 32 AS k, cardinality(array_agg(concat(CAST(v AS VARCHAR), repeat('x', 100)))) AS n
  FROM generate_series(1, 500000) AS t(v)
  GROUP BY v % 32
)
----
<slt:ignore>
