<slt:ignore>

# --- Case G: partial/final aggregation under memory limit ---
statement ok
SET datafusion.execution.target_partitions = 4

# Four final partitions share the greedy pool. Limit merge buffers so a
# partition that replays its spills can allocate while the other partitions
# retain their aggregate state.
# See https://github.com/apache/datafusion/issues/25423
statement ok
SET datafusion.runtime.max_spill_merge_fan_in = 2

query II
SELECT count(*), sum(total)
FROM (
  SELECT (v * 7) % 100000 AS k, sum(v) AS total
  FROM generate_series(1, 100000) AS t(v)
  GROUP BY (v * 7) % 100000
)
----
100000 5000050000

# Assert spill happened in the final aggregation and the partial aggregation
# reports memory-pressure emissions. Their exact counts are not deterministic,
# so assert only the spilled_rows unit and the presence of early_emit_count.
query TT
EXPLAIN ANALYZE
SELECT count(*), sum(total)
FROM (
  SELECT (v * 7) % 100000 AS k, sum(v) AS total
  FROM generate_series(1, 100000) AS t(v)
  GROUP BY (v * 7) % 100000
)
----
