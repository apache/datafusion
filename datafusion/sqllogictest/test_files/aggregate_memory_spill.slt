<slt:ignore>

# --- Case C: DISTINCT aggregate under memory limit ---
# One distinct value per group, so each count(DISTINCT v) = 1.
query II
SELECT count(*), sum(d)
FROM (
  SELECT (v * 7) % 100000 AS k, count(DISTINCT v) AS d
  FROM generate_series(1, 100000) AS t(v)
  GROUP BY (v * 7) % 100000
)
----
100000 100000

# Assert spill happened, the `spill_count` metric must be > 0
query TT
EXPLAIN ANALYZE
SELECT count(*), sum(d)
FROM (
  SELECT (v * 7) % 100000 AS k, count(DISTINCT v) AS d
  FROM generate_series(1, 100000) AS t(v)
  GROUP BY (v * 7) % 100000
)
----
<slt:ignore>
