# Each dictionary value repeats 50 times within one group. Spilled batches
# share the whole dictionary, so replay must compact the lists it keeps to the
# values of their own group.
statement ok
SET datafusion.runtime.memory_limit = '8M'

query II
SELECT count(*), sum(n)
FROM (
  SELECT (v / 50) % 32 AS k, cardinality(array_agg(arrow_cast(concat(CAST(v / 50 AS VARCHAR), repeat('x', 100)), 'Dictionary(Int32, Utf8)'))) AS n
  FROM generate_series(1, 2000000) AS t(v)
  GROUP BY (v / 50) % 32
)
