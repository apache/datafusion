# ------------------------------------------------------------------
# Existence joins: NULL-only and multi-NULL buffered side
# ------------------------------------------------------------------
# An all-NULL buffered side saturates the watermark before the first poll -- a different
# early-exit trigger from the "every row marked" case above -- so no streamed batch is read
# at all and EXISTS must still be empty.
statement ok
CREATE TABLE ex_l_allnull(id INT, v INT);

statement ok
