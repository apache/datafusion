1
2
3
4
5

# The same holds when the buffered side is present but every key is NULL, since a NULL key
# matches nothing either.
statement ok
CREATE TABLE rex_null_l(v INT);

statement ok
INSERT INTO rex_null_l VALUES (NULL), (NULL);

query I
SELECT r.id FROM rex_null_l l RIGHT SEMI JOIN rex_r r ON l.v > r.v ORDER BY 1;
----

query I
