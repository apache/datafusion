query TT
EXPLAIN
SELECT t1.t1_id, t2.t2_id
FROM join_t1 t1
JOIN join_t2 t2
  ON t1.t1_id < t2.t2_id
WHERE t2.t2_int >= 3
ORDER BY 1,2;
