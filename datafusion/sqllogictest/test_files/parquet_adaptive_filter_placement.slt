# Tests for `datafusion.execution.adaptive_filter_placement`: the Parquet scan
# places each filter conjunct in the row filter or in the post-scan filter,
# and changes the placement at row group boundaries. The results must be the
# same as without adaptive placement.

statement ok
set datafusion.execution.parquet.max_row_group_size = 1024;

# `a` is scattered (every second row), `b` is clustered (increases every 100
# rows), `s` is a wide string column that the filters do not read.
query I
COPY (
  SELECT i % 2 AS a, i / 100 AS b, repeat('x', 50) || i AS s, i AS v
  FROM generate_series(0, 9999) AS t(i)
) TO 'test_files/scratch/parquet_adaptive_filter_placement/t.parquet'
STORED AS PARQUET;
----
10000

statement ok
reset datafusion.execution.parquet.max_row_group_size;

statement ok
CREATE EXTERNAL TABLE t STORED AS PARQUET
LOCATION 'test_files/scratch/parquet_adaptive_filter_placement/t.parquet';

statement ok
set datafusion.execution.parquet.pushdown_filters = true;

statement ok
set datafusion.execution.batch_size = 256;

statement ok
set datafusion.execution.adaptive_filter_placement = true;

query IIII
SELECT count(*), min(v), max(v), sum(v) FROM t WHERE a = 0;
----
5000 0 9998 24995000

query IIII
SELECT count(*), min(v), max(v), sum(v) FROM t WHERE b < 5 OR b BETWEEN 50 AND 54;
----
1000 0 5499 2749500

query IIII
SELECT count(*), min(v), max(v), sum(v) FROM t WHERE a = 0 AND b >= 90 AND s LIKE '%8';
----
100 9008 9998 950300

query IT
SELECT v, s FROM t WHERE a = 1 AND b = 42 ORDER BY v LIMIT 3;
----
4201 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx4201
4203 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx4203
4205 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx4205

# A limit without an order: the placement can move `a = 0` to the post-scan
# filter in the middle of the file.
query I
SELECT count(*) FROM (SELECT v FROM t WHERE a = 0 LIMIT 3000);
----
3000

# The same queries without adaptive placement give the same results.
statement ok
set datafusion.execution.adaptive_filter_placement = false;

query IIII
SELECT count(*), min(v), max(v), sum(v) FROM t WHERE a = 0;
----
5000 0 9998 24995000

query IIII
SELECT count(*), min(v), max(v), sum(v) FROM t WHERE b < 5 OR b BETWEEN 50 AND 54;
----
1000 0 5499 2749500

query IIII
SELECT count(*), min(v), max(v), sum(v) FROM t WHERE a = 0 AND b >= 90 AND s LIKE '%8';
----
100 9008 9998 950300

query IT
SELECT v, s FROM t WHERE a = 1 AND b = 42 ORDER BY v LIMIT 3;
----
4201 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx4201
4203 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx4203
4205 xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx4205

statement ok
reset datafusion.execution.batch_size;

statement ok
reset datafusion.execution.parquet.pushdown_filters;

statement ok
reset datafusion.execution.adaptive_filter_placement;

statement ok
DROP TABLE t;
