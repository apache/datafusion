# Spilled sorts and aggregates over wide rows.
#
# Each query below spills rows much wider than `batch_size` rows of narrow
# data, under a memory limit that fits each row but not a whole batch of them.

statement ok
SET datafusion.execution.target_partitions = 1

# --- Sort: 512 rows of 64 KiB, built in small batches so each input batch fits ---

statement ok
SET datafusion.execution.sort_spill_reservation_bytes = 1048576

statement ok
SET datafusion.execution.batch_size = 4

statement ok
CREATE TABLE wide AS
SELECT value AS id, concat(CAST(value AS VARCHAR), repeat('x', 65536)) AS payload
FROM generate_series(0, 511)

statement ok
CREATE TABLE wide_ree AS
SELECT id, arrow_cast(payload, 'RunEndEncoded("run_ends": non-null Int32, "values": Utf8)') AS payload
FROM wide

statement ok
SET datafusion.execution.batch_size = 512

statement ok
SET datafusion.runtime.memory_limit = '16M'

# The last column counts rows out of order, so 0 means sorted.
query III
SELECT count(*), sum(length(payload)), sum(CASE WHEN prev <= id THEN 1 ELSE 0 END)
FROM (SELECT id, payload, lag(id) OVER (ORDER BY id DESC) AS prev FROM wide)
----
512 33555858 0

# A slice of a run-end encoded array keeps all its values. The sort copies each
# spill piece, so these payloads split within the same limit.
query III
SELECT count(*), sum(length(CAST(payload AS VARCHAR))), sum(CASE WHEN prev <= id THEN 1 ELSE 0 END)
FROM (SELECT id, payload, lag(id) OVER (ORDER BY id DESC) AS prev FROM wide_ree)
----
512 33555858 0

statement ok
DROP TABLE wide

statement ok
DROP TABLE wide_ree

statement ok
RESET datafusion.execution.sort_spill_reservation_bytes

statement ok
RESET datafusion.execution.batch_size

# --- Aggregate: a few groups with large states (#25851) ---

statement ok
SET datafusion.execution.target_partitions = 2

statement ok
SET datafusion.runtime.memory_limit = '12M'

query II
SELECT count(*) AS groups, sum(n) AS values_collected FROM (
  SELECT k, cardinality(array_agg(v)) AS n
  FROM (
    SELECT value % 4 AS k, concat(CAST(value AS VARCHAR), repeat('x', 100)) AS v
    FROM generate_series(1, 200000)
  )
  GROUP BY k
)
----
4 200000

statement ok
SET datafusion.execution.target_partitions = 1

# --- Aggregate: many groups whose states are wide relative to the pool ---

statement ok
SET datafusion.runtime.memory_limit = '4M'

query II
SELECT count(*), sum(length(s)) FROM (
  SELECT k, string_agg(v, ',') AS s
  FROM (SELECT value % 40000 AS k, repeat('x', 600) AS v FROM generate_series(1, 160000))
  GROUP BY k
)
----
40000 96120000

# The same groups under a 2 MB limit. The aggregate bounds its spill batches
# by what it held at the first spill, so the smallest merge fits.
statement ok
SET datafusion.runtime.memory_limit = '2M'

query II
SELECT count(*), sum(length(s)) FROM (
  SELECT k, string_agg(v, ',') AS s
  FROM (SELECT value % 40000 AS k, repeat('x', 200) AS v FROM generate_series(1, 160000))
  GROUP BY k
)
----
40000 32120000

query II
SELECT count(*), sum(length(s)) FROM (
  SELECT k, string_agg(v, ',') AS s
  FROM (SELECT value % 40000 AS k, repeat('x', 600) AS v FROM generate_series(1, 160000))
  GROUP BY k
)
----
40000 96120000

# The legacy aggregate stream.
statement ok
SET datafusion.execution.enable_migration_aggregate = false

statement ok
SET datafusion.runtime.memory_limit = '4M'

query II
SELECT count(*), sum(length(s)) FROM (
  SELECT k, string_agg(v, ',') AS s
  FROM (SELECT value % 40000 AS k, repeat('x', 200) AS v FROM generate_series(1, 160000))
  GROUP BY k
)
----
40000 32120000

statement ok
RESET datafusion.execution.enable_migration_aggregate

# Restore settings to slt runner defaults
statement ok
SET datafusion.execution.target_partitions = 4

statement ok
RESET datafusion.runtime.memory_limit

statement ok
RESET datafusion.catalog.create_default_catalog_and_schema
