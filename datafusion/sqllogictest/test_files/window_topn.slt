# DENSE_RANK on the streaming path. Same single-pass shape as RANK, but the rank
# advances by one per *distinct* ORDER BY value instead of jumping to the row
# position, so it retains strictly more rows.
query TT
EXPLAIN SELECT * FROM (
  SELECT a, b, DENSE_RANK() OVER (PARTITION BY a ORDER BY b) as dr
  FROM window_topn_sorted
) WHERE dr <= 2;
----
logical_plan
01)Projection: window_topn_sorted.a, window_topn_sorted.b, dense_rank() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS dr
02)--Filter: dense_rank() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW <= UInt64(2)
03)----WindowAggr: windowExpr=[[dense_rank() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
04)------TableScan: window_topn_sorted projection=[a, b]
physical_plan
01)ProjectionExec: expr=[a@0 as a, b@1 as b, dense_rank() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@2 as dr]
02)--BoundedWindowAggExec: wdw=[dense_rank() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "dense_rank() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": UInt64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
03)----StreamingPartitionedTopKExec: fn=dense_rank, fetch=2, partition=[a@0], order=[b@1 ASC NULLS LAST]
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true

# Each partition has exactly two distinct `b` values, 25 rows each, so
# `dr <= 2` retains all 100 rows. This is the discriminating case against RANK:
# the second distinct value sits at RANK 26, so `rk <= 2` would drop it.
query IIII
SELECT a, b, dr, count(*) FROM (
  SELECT a, b, DENSE_RANK() OVER (PARTITION BY a ORDER BY b) as dr
  FROM window_topn_sorted
) WHERE dr <= 2 GROUP BY a, b, dr ORDER BY a, b;
----
0 0 1 25
0 1 2 25
1 2 1 25
1 3 2 25

# ...and `dr <= 1` drops the second distinct value in each partition.
query IIII
SELECT a, b, dr, count(*) FROM (
  SELECT a, b, DENSE_RANK() OVER (PARTITION BY a ORDER BY b) as dr
  FROM window_topn_sorted
) WHERE dr <= 1 GROUP BY a, b, dr ORDER BY a, b;
----
0 0 1 25
1 2 1 25

# Sibling prune-safety on the streaming path. Tail-pruning drops rows, so a
# sibling window expression that reads *following* rows (LEAD) would resolve to a
# dropped row. The rule must decline: FilterExec stays, no
# StreamingPartitionedTopKExec. The heap-path equivalent of this test uses the
# unsorted table, so it cannot catch a streaming-path regression.
query TT
EXPLAIN SELECT a, b, rn, next_b FROM (
  SELECT a, b, ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) as rn,
               LEAD(b)      OVER (PARTITION BY a ORDER BY b) as next_b
  FROM window_topn_sorted
) WHERE rn <= 2;
----
logical_plan
01)Projection: window_topn_sorted.a, window_topn_sorted.b, row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS rn, lead(window_topn_sorted.b) PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS next_b
02)--Filter: row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW <= UInt64(2)
03)----WindowAggr: windowExpr=[[row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, lead(window_topn_sorted.b) PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
04)------TableScan: window_topn_sorted projection=[a, b]
physical_plan
01)ProjectionExec: expr=[a@0 as a, b@1 as b, row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@2 as rn, lead(window_topn_sorted.b) PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@3 as next_b]
02)--FilterExec: row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@2 <= 2
03)----BoundedWindowAggExec: wdw=[row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "row_number() PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": UInt64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, lead(window_topn_sorted.b) PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "lead(window_topn_sorted.b) PARTITION BY [window_topn_sorted.a] ORDER BY [window_topn_sorted.b ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": nullable Int32 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/window_2.csv]]}, projection=[a, b], output_ordering=[a@0 ASC NULLS LAST, b@1 ASC NULLS LAST], file_type=csv, has_header=true

# ...and the LEAD values are the true ones: rn=2 rows must see their real
# successor, not NULL from a pruned tail.
query IIII
SELECT a, b, rn, next_b FROM (
  SELECT a, b, ROW_NUMBER() OVER (PARTITION BY a ORDER BY b) as rn,
               LEAD(b)      OVER (PARTITION BY a ORDER BY b) as next_b
  FROM window_topn_sorted
) WHERE rn <= 2 ORDER BY a, b LIMIT 4;
----
0 0 1 0
0 0 2 0
1 2 1 2
1 2 2 2

statement ok
set datafusion.execution.target_partitions = 4;

statement ok
set datafusion.optimizer.enable_window_topn = false;

###############################################################################
# Streaming path: the heap-path fixtures replayed over sorted sources
###############################################################################
#
# Everything above this point (apart from the `window_topn_sorted` section)
# reaches `PartitionedTopKExec` — the child is unsorted, so the rule takes the
# heap branch. The streaming branch is chosen purely on the child's *declared*
# output ordering (`WindowTopN` runs before `EnsureRequirements`, so there is no
# `SortExec` to pattern-match on yet), which those fixtures can never produce.
#
# So the same fixtures are re-published as `WITH ORDER` external tables, written
# by `COPY ... ORDER BY` from the very same in-memory tables. The queries and
# expected results below are copied verbatim from their heap counterparts, and
# the test id of each origin is named. Two operators computing the same window
# function over the same rows must agree; where they legitimately differ the
# comment says so.
#
# `enable_window_topn` stays **false** throughout: the streaming rewrite is not
# gated on it, so leaving it off also proves the flag only governs the heap.

statement ok
set datafusion.optimizer.enable_window_topn = false;

