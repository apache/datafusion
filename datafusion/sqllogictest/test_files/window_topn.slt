# S23 (= Test 11): a RANK sibling alongside the matched ROW_NUMBER is
# prune-safe (both read only at-or-before the current row), so the rewrite
# still applies and both columns stay correct.
query IIIII rowsort
SELECT id, pk, val, rn, rk FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY pk ORDER BY val) as rn,
            RANK()       OVER (PARTITION BY pk ORDER BY val) as rk
  FROM st_rk_asc
) WHERE rn <= 2;
----
1 1 10 1 1
10 3 200 2 2
2 1 20 2 2
6 2 5 1 1
7 2 15 2 2
9 3 100 1 1

# S24: a SUM sibling is NOT prune-safe over the same frame, so `all_prune_safe`
# must decline — mirrors the sibling-safety guard, on the streaming path.
query TT
EXPLAIN SELECT id, pk, val, rn, s FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY pk ORDER BY val) as rn,
            SUM(val)     OVER (PARTITION BY pk ORDER BY val) as s
  FROM st_rn_asc
) WHERE rn <= 2;
----
logical_plan
01)Projection: st_rn_asc.id, st_rn_asc.pk, st_rn_asc.val, row_number() PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS rn, sum(st_rn_asc.val) PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS s
02)--Filter: row_number() PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW <= UInt64(2)
03)----WindowAggr: windowExpr=[[row_number() PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, sum(CAST(st_rn_asc.val AS Int64)) PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
04)------TableScan: st_rn_asc projection=[id, pk, val]
