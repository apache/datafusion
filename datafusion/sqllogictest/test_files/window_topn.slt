01)ProjectionExec: expr=[id@0 as id, pk@1 as pk, val@2 as val, row_number() PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@3 as rn, sum(st_rn_asc.val) PARTITION BY [st_rn_asc.pk] ORDER BY [st_rn_asc.val ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@4 as s]
