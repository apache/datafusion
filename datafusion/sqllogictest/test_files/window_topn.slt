1 1 10
10 3 75
2 1 20
3 1 30
5 2 5
6 2 15
7 2 25
8 3 100
9 3 50

# --------------------------------------------------------------------------
# S27: batch_size = 1 — the cross-batch carry
# --------------------------------------------------------------------------
#
# Every block above runs at the default batch_size of 8192, and these fixtures
# are 10-16 rows, so each arrives as a single batch and the operator's
# cross-batch state (`prev_partition` / `prev_order` / `partition_satisfied`) is
# never carried anywhere. At batch_size = 1 every partition run straddles a
# boundary, so that carry has to be correct for these to come back unchanged.
#
# The expected rows are therefore identical to S1 / S8 / S13 — batch size selects
# how the work is chunked, never the answer.

statement ok
set datafusion.execution.batch_size = 1;

# ROW_NUMBER: exercises the partition-key carry and the running `count`
# (= S1).
query III rowsort
SELECT id, pk, val FROM (
  SELECT *, ROW_NUMBER() OVER (PARTITION BY pk ORDER BY val) as rn FROM st_rn_asc
) WHERE rn <= 3;
