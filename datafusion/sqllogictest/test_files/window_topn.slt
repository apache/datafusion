09)│  [window_topn_t.pk] ORDER │
10)│    BY [window_topn_t.val  │
11)│    ASC NULLS LAST] RANGE  │
12)│      BETWEEN UNBOUNDED    │
13)│        PRECEDING AND      │
14)│         CURRENT ROW       │
15)│                           │
16)│          val: val         │
17)└─────────────┬─────────────┘
