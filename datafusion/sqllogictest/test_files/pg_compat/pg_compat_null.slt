skipif postgres
statement ok
CREATE EXTERNAL TABLE aggregate_test_100_by_sql (
  c1  VARCHAR NOT NULL,
  c2  TINYINT NOT NULL,
  c3  SMALLINT NOT NULL,
  c4  SMALLINT,
  c5  INT,
  c6  BIGINT NOT NULL,
  c7  SMALLINT NOT NULL,
  c8  INT NOT NULL,
  c9  BIGINT UNSIGNED NOT NULL,
  c10 VARCHAR NOT NULL,
  c11 FLOAT NOT NULL,
  c12 DOUBLE NOT NULL,
  c13 VARCHAR NOT NULL
)
STORED AS CSV
LOCATION '../../testing/data/csv/aggregate_test_100.csv'
OPTIONS ('format.has_header' 'true');


statement ok
CREATE TABLE aggregate_test_100_nullable_by_sql AS
SELECT
    *,
    CASE
        WHEN c4 % 3 = 0 THEN NULL
        ELSE c5
    END AS n5,
    CASE
        WHEN c3 % 3 != 0 THEN c9
        ELSE NULL
    END AS n9
FROM aggregate_test_100_by_sql


query III
SELECT
    COUNT(*), COUNT(n5), COUNT(n9)
FROM aggregate_test_100_nullable_by_sql
----
100 66 72


