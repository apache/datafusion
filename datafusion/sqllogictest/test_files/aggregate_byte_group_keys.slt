<slt:ignore>AggregateExec: mode=Partial, gby=[p@0 as p, s@1 as s, b@2 as b], aggr=[count(Int64(1)), sum(byte_keys.v)], metrics=[<slt:ignore>spill_count=0,<slt:ignore>skipped_aggregation_rows=<slt:ignore> K,<slt:ignore>
<slt:ignore>

