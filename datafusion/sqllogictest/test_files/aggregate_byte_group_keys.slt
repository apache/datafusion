statement ok
RESET datafusion.runtime.memory_limit

# Grouping sets use NULL for keys outside the selected set.
query IIIIIII
SELECT count(*), count(p), count(s), sum(length(s)), sum(g), sum(c), sum(total)
FROM (
  SELECT p, s, grouping(p, s) AS g, count(*) AS c, sum(v) AS total
  FROM byte_keys GROUP BY ROLLUP(p, s)
)
----
13507 13506 13500 64503 6 60000 600030000

query IIIIIII
SELECT count(*), count(p), count(s), sum(length(s)), sum(g), sum(c), sum(total)
FROM (
  SELECT p, s, grouping(p, s) AS g, count(*) AS c, sum(v) AS total
  FROM (SELECT arrow_cast(p, 'Utf8View') AS p, arrow_cast(s, 'Utf8View') AS s, v FROM byte_keys)
  GROUP BY ROLLUP(p, s)
)
----
13507 13506 13500 64503 6 60000 600030000

