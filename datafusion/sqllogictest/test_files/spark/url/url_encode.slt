query T
SELECT url_encode('https://spark.apache.org');
----
https%3A%2F%2Fspark.apache.org

# Test with LargeUtf8
query T
SELECT url_encode(arrow_cast('https://spark.apache.org', 'LargeUtf8'));
----
https%3A%2F%2Fspark.apache.org

# Test with Utf8View
query T
SELECT url_encode(arrow_cast('https://spark.apache.org', 'Utf8View'));
----
https%3A%2F%2Fspark.apache.org
