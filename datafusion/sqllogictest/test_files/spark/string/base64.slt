query T
SELECT base64('Spark SQL'::string);
----
U3BhcmsgU1FM

query T
SELECT base64('Spark SQ'::string);
----
U3BhcmsgU1E=

query T
SELECT base64('Spark S'::string);
----
U3BhcmsgUw==

query T
SELECT base64('Spark SQL'::bytea);
----
U3BhcmsgU1FM

query T
SELECT base64(NULL::string);
----
NULL

query T
SELECT base64(NULL::bytea);
----
NULL

query T
SELECT base64(column1)
FROM VALUES
('Spark SQL'::bytea),
('Spark SQ'::bytea),
('Spark S'::bytea),
(NULL::bytea);
----
U3BhcmsgU1FM
U3BhcmsgU1E=
U3BhcmsgUw==
NULL

query error Error during planning: Function 'base64' requires Binary, but received Int32 \(DataType: Int32\)
SELECT base64(12::integer);


query T
SELECT arrow_cast(unbase64('U3BhcmsgU1FM'::string), 'Utf8');
----
Spark SQL

query T
SELECT arrow_cast(unbase64('U3BhcmsgU1E='::string), 'Utf8');
----
Spark SQ

query T
SELECT arrow_cast(unbase64('U3BhcmsgUw=='::string), 'Utf8');
----
Spark S

query T
SELECT arrow_cast(unbase64('U3BhcmsgU1FM'::bytea), 'Utf8');
----
Spark SQL

query ?
SELECT unbase64(NULL::string);
----
NULL

query ?
SELECT unbase64(NULL::bytea);
----
NULL

query T
SELECT arrow_cast(unbase64(column1), 'Utf8')
FROM VALUES
('U3BhcmsgU1FM'::string),
('U3BhcmsgU1E='::string),
('U3BhcmsgUw=='::string),
(NULL::string);
----
Spark SQL
Spark SQ
Spark S
NULL

# Spark decodes with java.util.Base64.getMimeDecoder: padding is optional
# and bytes outside the base64 alphabet are skipped
query T
SELECT hex(unbase64('123'::string));
----
D76D

query T
SELECT hex(unbase64('123'::bytea));
----
D76D

query T
SELECT hex(unbase64(column1))
FROM VALUES
('12'::string),
('YQ'::string),
('YW Jj'::string),
('YWJj!!'::string),
('YWJj ZGVm'::string),
('!!!!'::string),
(''::string),
(NULL::string);
----
D7
61
616263
616263
616263646566
(empty)
(empty)
NULL

query T?
SELECT arrow_typeof(unbase64(column1)), unbase64(column1)
FROM VALUES
(arrow_cast(X'59513D3D', 'FixedSizeBinary(4)')),
(arrow_cast(NULL, 'FixedSizeBinary(4)'));
----
Binary 61
Binary NULL

# a single dangling character does not carry a full byte
query error Failed to decode value using base64: Last unit does not have enough valid bits
SELECT unbase64('Y'::string);

query error Failed to decode value using base64: Last unit does not have enough valid bits
SELECT unbase64('YWJjZ'::bytea);

# padding must still be well formed
query error Failed to decode value using base64: Input byte array has wrong 4-byte ending unit
SELECT unbase64('YQ='::string);

query error Failed to decode value using base64: Input byte array has incorrect ending byte
SELECT unbase64('YQ==YQ=='::string);

query error Error during planning: Function 'unbase64' requires Binary, but received Int32 \(DataType: Int32\)
SELECT unbase64(12::integer);
