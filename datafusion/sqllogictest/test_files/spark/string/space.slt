query T
SELECT concat(space(1::INT), 'Spark');
----
 Spark

query T
SELECT concat(space(5::INT), 'Spark');
----
     Spark

query T
SELECT space(0::INT);
----
(empty)

query T
SELECT space(-1::INT);
----
(empty)

query T
SELECT space(NULL);
----
NULL
