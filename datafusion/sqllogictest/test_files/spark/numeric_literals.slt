# Spark numeric literals must retain the same types as Spark SQL.
query TTTTTT
SELECT arrow_typeof(1), arrow_typeof(-2147483648), arrow_typeof(2147483648), arrow_typeof(-2147483649), arrow_typeof(1.5), arrow_typeof(1e2);
----
Int32 Int32 Int64 Int64 Decimal128(2, 1) Float64

query I
SELECT xxhash64(1);
----
-6698625589789238999

query R
SELECT try_sum(x) FROM VALUES (1.5), (2.5), (3.0) AS tab(x);
----
7.0

query R
SELECT if(true, 10, 20.5);
----
10.0

# Explicit BIGINT suffixes must not be narrowed.
query TTT
SELECT arrow_typeof(1L), arrow_typeof(-1L), arrow_typeof(-(2147483648));
----
Int64 Int64 Int64

query TTTT
SELECT arrow_typeof(9223372036854775807), arrow_typeof(-9223372036854775808), arrow_typeof(9223372036854775808), arrow_typeof(-9223372036854775809);
----
Int64 Int64 Decimal128(19, 0) Decimal128(19, 0)

query TTTT
SELECT arrow_typeof(0.00), arrow_typeof(.5), arrow_typeof(1.5e2), arrow_typeof(-1e2);
----
Decimal128(2, 2) Decimal128(1, 1) Float64 Float64

statement error BIGINT literal .* is out of range
SELECT 9223372036854775808L;

statement error BIGINT literal .* is out of range
SELECT -9223372036854775809L;

statement error DOUBLE literal .* is out of range
SELECT 1e999;

statement error Spark decimal literal exceeds the maximum precision of 38
SELECT 999999999999999999999999999999999999999;

# Decimal literals remain valid inputs to numeric functions, including arrays.
query R
SELECT rint(x) FROM VALUES (2.5), (3.5), (-2.5), (-3.5), (NULL) AS t(x);
----
2
4
-2
-4
NULL

query RT
SELECT floor(1.1), arrow_typeof(floor(1.1));
----
1 Decimal128(2, 0)

# Table functions accept both default INT and explicit BIGINT literal bounds.
query I
SELECT value FROM generate_series(1, 3L, 1);
----
1
2
3

query I
SELECT value FROM generate_series(3L, 1, -1);
----
3
2
1

# Switching away from Spark preserves the ordinary DataFusion defaults.
statement ok
SET datafusion.sql_parser.dialect = 'generic';

query TTT
SELECT arrow_typeof(1), arrow_typeof(1.5), arrow_typeof(1e2);
----
Int64 Float64 Float64

statement ok
SET datafusion.sql_parser.dialect = 'spark';
