query D
SELECT next_day('2015-01-14'::DATE, 'TU'::string);
----
2015-01-20

query D
SELECT next_day('2015-07-27'::DATE, 'Sun'::string);
----
2015-08-02

query D
SELECT next_day('2015-07-27'::DATE, 'Sat'::string);
----
2015-08-01

# Whitespace-padded day names should be rejected (return NULL) per Spark behavior
query D
SELECT next_day('2015-01-14'::DATE, ' MO '::string);
----
NULL

query error Function 'next_day' expects 2 arguments but received 1
SELECT next_day('2015-07-27'::DATE);

query error Function 'next_day' expects 2 arguments but received 1
SELECT next_day('Sun'::string);

query error 'next_day' does not support zero arguments
SELECT next_day();

query error Function 'next_day' requires Date, but received Int32
SELECT next_day(1::int, 'Sun'::string);

query error Function 'next_day' expects 2 arguments but received 3
SELECT next_day('2015-07-27'::DATE, 'Sat'::string, 'Sun'::string);

query error Cannot cast string 'invalid_date' to value of Date32 type
SELECT next_day('invalid_date'::string, 'Mon'::string);

query D
SELECT next_day('2000-01-01'::DATE, 2.0::float);
----
NULL

# Preserve implicit weekday-to-string conversions.
query D
SELECT next_day(DATE '2015-07-23', arrow_cast('Mon', 'Binary'));
----
2015-07-27

query D
SELECT next_day(DATE '2015-07-23', true);
----
NULL

query D
SELECT next_day('2020-01-01'::DATE, 'invalid_day'::string);
----
NULL

query error Cast error: Cannot cast string '2015-13-32' to value of Date32 type
SELECT next_day('2015-13-32'::DATE, 'Sun'::string);

query D
SELECT next_day(a, b)
FROM VALUES
    ('2000-01-01'::DATE, 'Mon'::string),
    (NULL::DATE, NULL::string),
    (NULL::DATE, 'Mon'::string),
    ('2015-01-14'::DATE, NULL::string) as t(a, b);
----
2000-01-03
NULL
NULL
NULL

# https://github.com/apache/datafusion/issues/23891
# Far-future start dates whose next occurrence lands past chrono::NaiveDate::MAX
# (epoch day 95026236) must still return a value, matching Spark's integer
# arithmetic, rather than panicking. Cast the Date32 result to Int32 to assert
# the epoch day directly (these dates are past the printable range).
query I
SELECT arrow_cast(next_day(arrow_cast(95026236, 'Date32'), 'Mon'::string), 'Int32');
----
95026243

query I
SELECT arrow_cast(next_day(arrow_cast(95026230, 'Date32'), 'Tue'::string), 'Int32');
----
95026237

# https://github.com/apache/datafusion/issues/23889
# Spark casts the start date to DATE, so STRING and TIMESTAMP are accepted
query D
SELECT next_day('2015-07-23'::string, 'Mon'::string);
----
2015-07-27

query D
SELECT next_day('2015-07-23 12:12:12'::string, 'Mon'::string);
----
2015-07-27

query D
SELECT next_day('2015-07-23 12:12:12'::timestamp, 'Mon'::string);
----
2015-07-27

# Timestamp-to-date conversion must round down before the Unix epoch.
query D
SELECT next_day(TIMESTAMP '1969-12-31 23:59:59', 'Thu');
----
1970-01-01

query D
SELECT next_day(a, 'Mon'::string)
FROM VALUES
    ('2015-07-23'::string),
    (NULL::string) as t(a);
----
2015-07-27
NULL

# Timestamp column with a day-of-week column
query D
SELECT next_day(a, b)
FROM VALUES
    ('2015-07-23 12:12:12'::timestamp, 'Mon'::string),
    ('2015-07-23 23:59:59'::timestamp, 'Fri'::string),
    (NULL::timestamp, 'Mon'::string) as t(a, b);
----
2015-07-27
2015-07-24
NULL

# LargeUtf8 / Utf8View start dates
query D
SELECT next_day(arrow_cast('2015-07-23', 'LargeUtf8'), 'Mon');
----
2015-07-27

query D
SELECT next_day(arrow_cast('2015-07-23', 'Utf8View'), 'Mon');
----
2015-07-27

# String start date and LargeUtf8 / Utf8View day-of-week
query D
SELECT next_day('2015-07-23', arrow_cast('Mon', 'LargeUtf8'));
----
2015-07-27

query D
SELECT next_day('2015-07-23', arrow_cast('Mon', 'Utf8View'));
----
2015-07-27
