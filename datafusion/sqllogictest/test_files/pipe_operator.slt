statement ok
CREATE TABLE test(
    a INT,
    b FLOAT,
    c VARCHAR,
    n VARCHAR
) AS VALUES
  (1, 1.1, 'a', NULL),
  (2, 2.2, 'b', NULL),
  (3, 3.3, 'c', NULL)
;

# WHERE pipe
query IRTT
SELECT *
FROM test
|> WHERE a > 1
----
2 2.2 b NULL
3 3.3 c NULL

# ORDER BY pipe
query IRTT
SELECT *
FROM test
|> ORDER BY a DESC
----
3 3.3 c NULL
2 2.2 b NULL
1 1.1 a NULL

# ORDER BY pipe, limit
query IRTT
SELECT *
FROM test
|> ORDER BY a DESC
|> LIMIT 1
----
3 3.3 c NULL

# SELECT pipe
query I
SELECT *
FROM test
|> SELECT a
----
1
2
3

# EXTEND pipe
query IRR
SELECT *
FROM test
|> SELECT a, b
|> EXTEND a + b AS a_plus_b
----
1 1.1 2.1
2 2.2 4.2
3 3.3 6.3

query IRR
SELECT *
FROM test
|> SELECT a, b
|> where a = 1
|> EXTEND a + b AS a_plus_b
----
1 1.1 2.1

# Window functions in SELECT and EXTEND pipes
query III rowsort
SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) AS t(k, v)
|> EXTEND ROW_NUMBER() OVER (PARTITION BY k ORDER BY v DESC) AS rn
|> WHERE rn = 1
----
1 20 1
2 30 1

query II rowsort
SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) AS t(k, v)
|> SELECT k, ROW_NUMBER() OVER (PARTITION BY k ORDER BY v) AS rn
----
1 1
1 2
2 1

query IIII rowsort
SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) AS t(k, v)
|> EXTEND LAG(v) OVER (PARTITION BY k ORDER BY v) AS prev_v,
          LEAD(v) OVER (PARTITION BY k ORDER BY v) AS next_v
----
1 10 NULL 20
1 20 10 NULL
2 30 NULL NULL

query III rowsort
SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) AS t(k, v)
|> SELECT k, v - LAG(v) OVER (PARTITION BY k ORDER BY v) AS dv, LEAD(v, 1, 0) OVER (ORDER BY v) AS next_v
----
1 10 30
1 NULL 20
2 NULL 0

# unnest in SELECT and EXTEND pipes
query I
SELECT [1, 2, 3] AS xs
|> SELECT unnest(xs) AS x
----
1
2
3

query ?I
SELECT [1, 2, 3] AS xs
|> EXTEND unnest(xs) AS x
----
[1, 2, 3] 1
[1, 2, 3] 2
[1, 2, 3] 3

# Window functions in ORDER BY pipe
query II
SELECT * FROM (VALUES (1, 10), (1, 20), (2, 30)) AS t(k, v)
|> ORDER BY row_number() OVER (ORDER BY v DESC)
----
2 30
1 20
1 10

# AS pipe
query I
SELECT *
FROM test
|> as test_pipe
|> select test_pipe.a
----
1
2
3

# UNION pipe
query I
SELECT *
FROM test
|> select a
|> UNION ALL (
  SELECT a FROM test
);
----
1
2
3
1
2
3

# INTERSECT pipe
query I rowsort
SELECT * FROM range(0,3)
|> INTERSECT DISTINCT
    (SELECT * FROM range(1,3));
----
1
2

# EXCEPT pipe
query I rowsort
select * from range(0,10)
|> EXCEPT DISTINCT (select * from range(5,10));
----
0
1
2
3
4

# AGGREGATE pipe
query II
(
  SELECT 'apples' AS item, 2 AS sales
  UNION ALL
  SELECT 'bananas' AS item, 5 AS sales
  UNION ALL
  SELECT 'apples' AS item, 7 AS sales
)
|> AGGREGATE COUNT(*) AS num_items, SUM(sales) AS total_sales;
----
3 14

query TII rowsort
(
  SELECT 'apples' AS item, 2 AS sales
  UNION ALL
  SELECT 'bananas' AS item, 5 AS sales
  UNION ALL
  SELECT 'apples' AS item, 7 AS sales
)
|> AGGREGATE COUNT(*) AS num_items, SUM(sales) AS total_sales
   GROUP BY item;
----
apples 2 9
bananas 1 5

query TII rowsort
(
  SELECT 'apples' AS item, 2 AS sales
  UNION ALL
  SELECT 'bananas' AS item, 5 AS sales
  UNION ALL
  SELECT 'apples' AS item, 7 AS sales
)
|> AGGREGATE COUNT(*) AS num_items, SUM(sales) AS total_sales
   GROUP BY item
|> WHERE num_items > 1;
----
apples 2 9

# Ordering suffixes in AGGREGATE pipe
query II
SELECT * FROM (VALUES (3, 1), (1, 2), (2, 3), (NULL, 4)) AS t(k, v)
|> AGGREGATE sum(v) AS s GROUP BY k DESC
----
NULL 4
3 1
2 3
1 2

query II
SELECT * FROM (VALUES (3, 1), (1, 2), (2, 3), (NULL, 4)) AS t(k, v)
|> AGGREGATE sum(v) AS s DESC GROUP BY k
----
NULL 4
2 3
1 2
3 1

query III
SELECT * FROM (VALUES (1, 1, 10), (1, 2, 30), (2, 1, 5), (2, 2, 7)) AS t(a, b, v)
|> AGGREGATE sum(v) AS s DESC GROUP BY a ASC, b
----
1 2 30
1 1 10
2 2 7
2 1 5

# unnest in AGGREGATE pipe GROUP BY
query II
SELECT * FROM (VALUES (1, [1, 2]), (2, [3]), (3, [1])) AS t(k, xs)
|> AGGREGATE count(*) AS c GROUP BY unnest(xs) AS x ASC
----
1 2
2 1
3 1

# JOIN pipe
query TII
(
  SELECT 'apples' AS item, 2 AS sales
  UNION ALL
  SELECT 'bananas' AS item, 5 AS sales
)
|> AS produce_sales
|> LEFT JOIN
     (
       SELECT 'apples' AS item, 123 AS id
     ) AS produce_data
   ON produce_sales.item = produce_data.item
|> SELECT produce_sales.item, sales, id;
----
apples 2 123
bananas 5 NULL
