# Reject 65 grouping columns: all bits.

statement error Grouping sets support at most 64 grouping columns, got 65
SELECT GROUPING(
    c0, c1, c2, c3, c4, c5, c6, c7,
    c8, c9, c10, c11, c12, c13, c14, c15,
    c16, c17, c18, c19, c20, c21, c22, c23,
    c24, c25, c26, c27, c28, c29, c30, c31,
    c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47,
    c48, c49, c50, c51, c52, c53, c54, c55,
    c56, c57, c58, c59, c60, c61, c62, c63,
    c64
)
FROM grouping_width_input
GROUP BY GROUPING SETS ((
    c0, c1, c2, c3, c4, c5, c6, c7,
    c8, c9, c10, c11, c12, c13, c14, c15,
    c16, c17, c18, c19, c20, c21, c22, c23,
    c24, c25, c26, c27, c28, c29, c30, c31,
    c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47,
    c48, c49, c50, c51, c52, c53, c54, c55,
    c56, c57, c58, c59, c60, c61, c62, c63,
    c64
), ());

# Reject 65 grouping columns: without GROUPING.

statement error Grouping sets support at most 64 grouping columns, got 65
SELECT COUNT(*)
FROM grouping_width_input
GROUP BY GROUPING SETS ((
    c0, c1, c2, c3, c4, c5, c6, c7,
    c8, c9, c10, c11, c12, c13, c14, c15,
    c16, c17, c18, c19, c20, c21, c22, c23,
    c24, c25, c26, c27, c28, c29, c30, c31,
    c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47,
    c48, c49, c50, c51, c52, c53, c54, c55,
    c56, c57, c58, c59, c60, c61, c62, c63,
    c64
), ());

# 63 columns still execute, including extraction of the first and last bits.

query III rowsort
SELECT GROUPING(c0), GROUPING(c62), GROUPING(c0, c62)
FROM grouping_width_input
GROUP BY GROUPING SETS ((
    c0, c1, c2, c3, c4, c5, c6, c7,
    c8, c9, c10, c11, c12, c13, c14, c15,
    c16, c17, c18, c19, c20, c21, c22, c23,
    c24, c25, c26, c27, c28, c29, c30, c31,
    c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47,
    c48, c49, c50, c51, c52, c53, c54, c55,
    c56, c57, c58, c59, c60, c61, c62
), ());
----
0 0 0
1 1 3

# 64 columns can be planned. Execution at this boundary has separate kernel coverage.

statement ok
CREATE VIEW grouping_width_64 AS
SELECT GROUPING(c0) AS g_first, GROUPING(c63) AS g_last, GROUPING(c0, c63) AS g_pair
FROM grouping_width_input
GROUP BY GROUPING SETS ((
    c0, c1, c2, c3, c4, c5, c6, c7,
    c8, c9, c10, c11, c12, c13, c14, c15,
    c16, c17, c18, c19, c20, c21, c22, c23,
    c24, c25, c26, c27, c28, c29, c30, c31,
    c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47,
    c48, c49, c50, c51, c52, c53, c54, c55,
    c56, c57, c58, c59, c60, c61, c62, c63
), ());

query TTT
DESCRIBE grouping_width_64;
----
g_first Int32 YES
g_last Int32 YES
g_pair Int32 YES

# The capacity limit does not apply to an ordinary 65-column GROUP BY.

query I
SELECT GROUPING(c0)
FROM grouping_width_input
GROUP BY
    c0, c1, c2, c3, c4, c5, c6, c7,
    c8, c9, c10, c11, c12, c13, c14, c15,
    c16, c17, c18, c19, c20, c21, c22, c23,
    c24, c25, c26, c27, c28, c29, c30, c31,
    c32, c33, c34, c35, c36, c37, c38, c39,
    c40, c41, c42, c43, c44, c45, c46, c47,
    c48, c49, c50, c51, c52, c53, c54, c55,
    c56, c57, c58, c59, c60, c61, c62, c63,
    c64;
----
0
