query I rowsort
WITH m AS (
  SELECT k FROM t
  WHERE EXISTS (SELECT 1 FROM t t2 WHERE t2.k > 3)
    AND k IN (SELECT k FROM t WHERE v > 10)
    AND v < (SELECT max(v) FROM t))
