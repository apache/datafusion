1

statement ok
DROP TABLE unbounded_t;

# Behaviour matrix. Each case runs with MATERIALIZED, NOT MATERIALIZED and no
# keyword, and pins the current result. For a volatile body, count(DISTINCT x)
# over two references is 1 when the references share one evaluation and 2 when
# each reference evaluates the body.
#
# The PostgreSQL and DuckDB results are from PostgreSQL 17.11 and DuckDB 1.5.2,
# with the same table t. Results are listed as sorted rows.
# "(differs)" marks a result that is not the same as DataFusion. The
# differences have two causes:
# - PostgreSQL does not inline a CTE with a volatile body, also with NOT
#   MATERIALIZED, and it does not evaluate an uncorrelated subquery in a
#   recursive term again in each iteration.
# - DuckDB materializes a CTE with no keyword when it is referenced more than
#   one time.
# DataFusion inlines every CTE that does not have MATERIALIZED.
#
# Two references in the same query.
# MATERIALIZED
# PostgreSQL: 1. DuckDB: 1.
query I rowsort
WITH m AS MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM m UNION ALL SELECT x FROM m)
----
1

# NOT MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 2.
query I rowsort
WITH m AS NOT MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM m UNION ALL SELECT x FROM m)
----
2

# no keyword
# PostgreSQL: 1 (differs). DuckDB: 1 (differs).
query I rowsort
WITH m AS (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM m UNION ALL SELECT x FROM m)
----
2

# One reference in a scalar subquery, one in the main query.
# MATERIALIZED
# PostgreSQL: 1. DuckDB: 1.
query I rowsort
WITH m AS MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT (SELECT x FROM m) AS x UNION ALL SELECT x FROM m)
----
1

# NOT MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 2.
query I rowsort
WITH m AS NOT MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT (SELECT x FROM m) AS x UNION ALL SELECT x FROM m)
----
2

# no keyword
# PostgreSQL: 1 (differs). DuckDB: 1 (differs).
query I rowsort
WITH m AS (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT (SELECT x FROM m) AS x UNION ALL SELECT x FROM m)
----
2

