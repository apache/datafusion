# Tests for `WITH x AS MATERIALIZED (...)`: the CTE body runs once and every
# reference reads its buffered output.

# sqlparser only parses `[NOT] MATERIALIZED` for the PostgreSQL dialect.
statement ok
set datafusion.sql_parser.dialect = 'PostgreSQL';

statement ok
set datafusion.explain.logical_plan_only = false;

statement ok
CREATE TABLE t(k INT, v INT) AS VALUES (1, 10), (2, 20), (3, 30), (4, 40);

# A volatile body is evaluated once, so both references see the same value.
query I
WITH r AS MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM r UNION ALL SELECT x FROM r)
----
1

# Without MATERIALIZED the body is inlined and evaluated once per reference.
query I
WITH r AS NOT MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM r UNION ALL SELECT x FROM r)
----
2

query I
WITH r AS (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM r UNION ALL SELECT x FROM r)
----
2

# The table is scanned once, below MaterializedCteExec, and each reference is
# a MaterializedCteScanExec. The filter of each reference stays above its scan.
# Each reference has a filter, so the body is also filtered with the
# disjunction of the two filters.
query TT
EXPLAIN WITH c AS MATERIALIZED (SELECT k, v * 2 AS v2 FROM t)
SELECT k FROM c WHERE v2 > 30
UNION ALL
SELECT k FROM c WHERE v2 < 30
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----Projection: t.k, CAST(t.v AS Int64) * Int64(2) AS v2
04)------Filter: __common_expr_2 > Int64(30) OR __common_expr_2 < Int64(30)
05)--------Projection: CAST(t.v AS Int64) * Int64(2) AS __common_expr_2, t.k, t.v
06)----------TableScan: t projection=[k, v]
07)--Union
08)----Projection: c.k
09)------Filter: c.v2 > Int64(30)
10)--------MaterializedCteScan: name=c
11)----Projection: c.k
12)------Filter: c.v2 < Int64(30)
13)--------MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--ProjectionExec: expr=[k@1 as k, CAST(v@2 AS Int64) * 2 as v2]
03)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
04)------FilterExec: __common_expr_2@0 > 30 OR __common_expr_2@0 < 30
05)--------ProjectionExec: expr=[CAST(v@1 AS Int64) * 2 as __common_expr_2, k@0 as k, v@1 as v]
06)----------DataSourceExec: partitions=1, partition_sizes=[1]
07)--UnionExec
08)----FilterExec: v2@1 > 30, projection=[k@0]
09)------MaterializedCteScanExec: name=c
10)----FilterExec: v2@1 < 30, projection=[k@0]
11)------MaterializedCteScanExec: name=c

query I rowsort
WITH c AS MATERIALIZED (SELECT k, v * 2 AS v2 FROM t)
SELECT k FROM c WHERE v2 > 30
UNION ALL
SELECT k FROM c WHERE v2 < 30
----
1
2
3
4

# EXPLAIN ANALYZE: the source is read once (4 rows) although the CTE is
# referenced three times, and each scan replays all 4 rows.
query TT
EXPLAIN ANALYZE WITH c AS MATERIALIZED (SELECT k, v FROM t)
SELECT count(*) FROM (
  SELECT k FROM c UNION ALL SELECT k FROM c UNION ALL SELECT k FROM c
)
----
Plan with Metrics
01)MaterializedCteExec: name=c, metrics=[spill_count=0, <slt:ignore>buffered_rows=4]
02)--DataSourceExec: partitions=1, partition_sizes=[1], metrics=[<slt:ignore>]
03)--ProjectionExec: expr=[count(Int64(1))@0 as count(*)], metrics=[<slt:ignore>]
04)----AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1))], metrics=[<slt:ignore>]
05)------CoalescePartitionsExec, metrics=[<slt:ignore>]
06)--------AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1))], metrics=[<slt:ignore>]
07)----------UnionExec, metrics=[<slt:ignore>]
08)------------ProjectionExec: expr=[], metrics=[<slt:ignore>]
09)--------------MaterializedCteScanExec: name=c, metrics=[output_rows=4, <slt:ignore>]
10)------------ProjectionExec: expr=[], metrics=[<slt:ignore>]
11)--------------MaterializedCteScanExec: name=c, metrics=[output_rows=4, <slt:ignore>]
12)------------ProjectionExec: expr=[], metrics=[<slt:ignore>]
13)--------------MaterializedCteScanExec: name=c, metrics=[output_rows=4, <slt:ignore>]

# For comparison, the inlined CTE scans the source once per reference.
query TT
EXPLAIN WITH c AS (SELECT k, v FROM t)
SELECT sum(k) FROM (
  SELECT k FROM c UNION ALL SELECT k FROM c UNION ALL SELECT k FROM c
)
----
logical_plan
01)Aggregate: groupBy=[[]], aggr=[[sum(CAST(k AS Int64))]]
02)--Union
03)----SubqueryAlias: c
04)------TableScan: t projection=[k]
05)----SubqueryAlias: c
06)------TableScan: t projection=[k]
07)----SubqueryAlias: c
08)------TableScan: t projection=[k]
physical_plan
01)AggregateExec: mode=Final, gby=[], aggr=[sum(k)]
02)--CoalescePartitionsExec
03)----AggregateExec: mode=Partial, gby=[], aggr=[sum(k)]
04)------UnionExec
05)--------DataSourceExec: partitions=1, partition_sizes=[1]
06)--------DataSourceExec: partitions=1, partition_sizes=[1]
07)--------DataSourceExec: partitions=1, partition_sizes=[1]

# Both sides of one hash join read the same CTE. The build side must be read
# completely before the probe side starts, which full materialization allows.
query III rowsort
WITH c AS MATERIALIZED (SELECT k, v FROM t)
SELECT a.k, a.v, b.v FROM c a JOIN c b ON a.k = b.k
----
1 10 10
2 20 20
3 30 30
4 40 40

# A reference inside a scalar subquery. The scalar subquery runs before the
# main plan, so the scan must be able to start the body itself.
query II
WITH c AS MATERIALIZED (SELECT k, v FROM t)
SELECT k, v FROM c WHERE v = (SELECT max(v) FROM c)
----
4 40

# A later CTE reads an earlier one.
query II rowsort
WITH a AS MATERIALIZED (SELECT k, v FROM t WHERE k > 1),
     b AS MATERIALIZED (SELECT k, v + 1 AS v FROM a)
SELECT a.k, b.v FROM a JOIN b ON a.k = b.k
----
2 21
3 31
4 41

# Sibling subqueries declare CTEs with the same name.
query II
SELECT x.cnt, y.cnt FROM
  (WITH s AS MATERIALIZED (SELECT k FROM t WHERE k <= 2)
   SELECT count(*) AS cnt FROM s p JOIN s q ON p.k = q.k) x,
  (WITH s AS MATERIALIZED (SELECT k FROM t WHERE k >= 2)
   SELECT count(*) AS cnt FROM s p JOIN s q ON p.k = q.k) y
----
2 3

# A column alias list on a materialized CTE.
query I rowsort
WITH c(a, b) AS MATERIALIZED (SELECT k, v FROM t)
SELECT a FROM c WHERE b > 20
----
3
4

# IN and NOT IN subqueries that declare a materialized CTE.
query I rowsort
SELECT k FROM t WHERE k IN (
  WITH r AS MATERIALIZED (SELECT k FROM t WHERE k > 2) SELECT k FROM r)
----
3
4

query I rowsort
SELECT k FROM t WHERE k NOT IN (
  WITH r AS MATERIALIZED (SELECT k FROM t WHERE k > 2) SELECT k FROM r)
----
1
2

# Correlated subqueries whose continuation refers to the outer query.
query I rowsort
SELECT k FROM t WHERE EXISTS (
  WITH r AS MATERIALIZED (SELECT k AS rk FROM t)
  SELECT 1 FROM r WHERE r.rk = t.k + 1)
----
1
2
3

query I
SELECT k FROM t WHERE NOT EXISTS (
  WITH r AS MATERIALIZED (SELECT k AS rk FROM t)
  SELECT 1 FROM r WHERE r.rk = t.k + 1)
----
4

query I rowsort
SELECT k FROM t WHERE v IN (
  WITH r AS MATERIALIZED (SELECT k AS rk, v AS rv FROM t)
  SELECT rv FROM r WHERE r.rk = t.k AND r.rk > 2)
----
3
4

# A body that refers to the outer query would have to run once per outer row.
# Such a CTE is inlined, as if MATERIALIZED was not given.
query I rowsort
SELECT k FROM t WHERE EXISTS (
  WITH r AS MATERIALIZED (SELECT k AS rk FROM t t2 WHERE t2.k = t.k + 1)
  SELECT 1 FROM r)
----
1
2
3

query I
SELECT k FROM t WHERE NOT EXISTS (
  WITH r AS MATERIALIZED (SELECT k AS rk FROM t t2 WHERE t2.k = t.k + 1)
  SELECT 1 FROM r)
----
4

query II rowsort
SELECT k, (
  WITH r AS MATERIALIZED (SELECT v FROM t t2 WHERE t2.k = t.k)
  SELECT sum(v) * 2 FROM r)
FROM t
----
1 20
2 40
3 60
4 80

# The correlated CTE is inlined, so the plan has no MaterializedCteExec.
query TT
EXPLAIN SELECT k FROM t WHERE EXISTS (
  WITH r AS MATERIALIZED (SELECT k AS rk FROM t t2 WHERE t2.k = t.k + 1)
  SELECT 1 FROM r)
----
logical_plan
01)LeftSemi Join: CAST(t.k AS Int64) + Int64(1) = CAST(__correlated_sq_1.k AS Int64)
02)--TableScan: t projection=[k]
03)--SubqueryAlias: __correlated_sq_1
04)----SubqueryAlias: r
05)------SubqueryAlias: t2
06)--------TableScan: t projection=[k]
physical_plan
01)HashJoinExec: mode=CollectLeft, join_type=LeftSemi, on=[(t.k + Int64(1)@1, CAST(__correlated_sq_1.k AS Int64)@1)], projection=[k@0]
02)--ProjectionExec: expr=[k@0 as k, CAST(k@0 AS Int64) + 1 as t.k + Int64(1)]
03)----DataSourceExec: partitions=1, partition_sizes=[1]
04)--ProjectionExec: expr=[k@0 as k, CAST(k@0 AS Int64) as CAST(__correlated_sq_1.k AS Int64)]
05)----DataSourceExec: partitions=1, partition_sizes=[1]

# In a WITH RECURSIVE block, MATERIALIZED applies to a CTE that does not refer
# to itself.
query I
WITH RECURSIVE r AS MATERIALIZED (SELECT random() AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM r UNION ALL SELECT x FROM r)
----
1

# A recursive CTE is also materialized: RecursiveQueryExec runs once, and its
# reference to itself is still a work table.
query TT
EXPLAIN WITH RECURSIVE r AS MATERIALIZED (
  SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 3
)
SELECT count(*) FROM r a, r b
----
logical_plan
01)MaterializedCte: name=r
02)--SubqueryAlias: r
03)----RecursiveQuery: is_distinct=false
04)------Projection: Int64(1) AS n
05)--------EmptyRelation: rows=1
06)------Projection: r.n + Int64(1)
07)--------Filter: r.n < Int64(3)
08)----------TableScan: r projection=[n]
09)--Projection: count(Int64(1)) AS count(*)
10)----Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
11)------Cross Join:
12)--------SubqueryAlias: a
13)----------Projection:
14)------------MaterializedCteScan: name=r
15)--------SubqueryAlias: b
16)----------Projection:
17)------------MaterializedCteScan: name=r
physical_plan
01)MaterializedCteExec: name=r
02)--RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
03)----RecursiveQueryExec: name=r, is_distinct=false
04)------ProjectionExec: expr=[CAST(1 AS Int64) as n]
05)--------PlaceholderRowExec
06)------CoalescePartitionsExec
07)--------ProjectionExec: expr=[n@0 + 1 as n]
08)----------FilterExec: n@0 < 3
09)------------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
10)--------------WorkTableExec: name=r
11)--ProjectionExec: expr=[count(Int64(1))@0 as count(*)]
12)----AggregateExec: mode=Final, gby=[], aggr=[count(Int64(1))]
13)------CoalescePartitionsExec
14)--------AggregateExec: mode=Partial, gby=[], aggr=[count(Int64(1))]
15)----------CrossJoinExec
16)------------CoalescePartitionsExec
17)--------------ProjectionExec: expr=[]
18)----------------MaterializedCteScanExec: name=r
19)------------ProjectionExec: expr=[]
20)--------------MaterializedCteScanExec: name=r

query I
WITH RECURSIVE r AS MATERIALIZED (
  SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 3
)
SELECT count(*) FROM r a, r b
----
9

# A recursive CTE reads a materialized CTE of the same block.
query I rowsort
WITH RECURSIVE m AS MATERIALIZED (SELECT 3 AS lim),
  r AS (SELECT 1 AS n UNION ALL SELECT n + 1 FROM r, m WHERE n < m.lim)
SELECT n FROM r
----
1
2
3

# Each reference to a view is a separate query, so each has its own
# materialized CTE, as in PostgreSQL.
statement ok
CREATE VIEW vv AS WITH r AS MATERIALIZED (SELECT random() AS x) SELECT x FROM r;

query B
SELECT a.x = b.x FROM vv a, vv b
----
false

query I
SELECT count(DISTINCT x) FROM (
  SELECT x FROM vv UNION ALL SELECT x FROM vv UNION ALL SELECT (SELECT max(x) FROM vv)
)
----
3

# Inside one reference to a view, the CTE is still shared.
statement ok
CREATE VIEW vv2 AS WITH r AS MATERIALIZED (SELECT random() AS x)
SELECT a.x = b.x AS same FROM r a, r b;

query B
SELECT * FROM vv2 UNION ALL SELECT * FROM vv2
----
true
true

statement ok
DROP VIEW vv;

statement ok
DROP VIEW vv2;

# A filter above the query that declares the CTE goes into the continuation,
# not into the shared body.
query TT
EXPLAIN SELECT * FROM (
  WITH r AS MATERIALIZED (SELECT k FROM t)
  SELECT t.k, t.v FROM t JOIN r ON t.k = r.k
) s WHERE s.v = 10
----
logical_plan
01)SubqueryAlias: s
02)--MaterializedCte: name=r
03)----SubqueryAlias: r
04)------TableScan: t projection=[k]
05)----Projection: t.k, t.v
06)------Inner Join: t.k = r.k
07)--------Filter: t.v = Int32(10)
08)----------TableScan: t projection=[k, v]
09)--------MaterializedCteScan: name=r
physical_plan
01)MaterializedCteExec: name=r
02)--DataSourceExec: partitions=1, partition_sizes=[1]
03)--HashJoinExec: mode=CollectLeft, join_type=Inner, on=[(k@0, k@0)], projection=[k@0, v@1]
04)----FilterExec: v@1 = 10
05)------DataSourceExec: partitions=1, partition_sizes=[1]
06)----MaterializedCteScanExec: name=r

query II
SELECT * FROM (
  WITH r AS MATERIALIZED (SELECT k FROM t)
  SELECT t.k, t.v FROM t JOIN r ON t.k = r.k
) s WHERE s.v = 10
----
1 10

# Filters that all the references have are pushed into the body as one
# disjunction. The Parquet table shows that the filter goes down to the scan.
statement ok
COPY (
  SELECT * FROM (VALUES
    ('2026-01-01', 1), ('2026-01-01', 2), ('2026-01-02', 3),
    ('2026-01-03', 4), ('2026-01-04', 5)
  ) AS v(day, n)
) TO 'test_files/scratch/cte_materialized/events.parquet' STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE events STORED AS PARQUET
LOCATION 'test_files/scratch/cte_materialized/events.parquet';

# The body reads only the two days that the references read. Each reference
# keeps its filter, because the body has the rows of the two references.
query TT
EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-01'
UNION ALL
SELECT * FROM c WHERE day = '2026-01-02'
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----Filter: events.day = Utf8View("2026-01-01") OR events.day = Utf8View("2026-01-02")
04)------TableScan: events projection=[day, n], partial_filters=[events.day = Utf8View("2026-01-01") OR events.day = Utf8View("2026-01-02")]
05)--Union
06)----Filter: c.day = Utf8View("2026-01-01")
07)------MaterializedCteScan: name=c
08)----Filter: c.day = Utf8View("2026-01-02")
09)------MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--FilterExec: day@0 = 2026-01-01 OR day@0 = 2026-01-02
03)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/cte_materialized/events.parquet]]}, projection=[day, n], file_type=parquet, predicate=day@0 = 2026-01-01 OR day@0 = 2026-01-02, pruning_predicate=day_null_count@2 != row_count@3 AND day_min@0 <= 2026-01-01 AND 2026-01-01 <= day_max@1 OR day_null_count@2 != row_count@3 AND day_min@0 <= 2026-01-02 AND 2026-01-02 <= day_max@1, required_guarantees=[day in (2026-01-01, 2026-01-02)]
05)--UnionExec
06)----FilterExec: day@0 = 2026-01-01
07)------MaterializedCteScanExec: name=c
08)----FilterExec: day@0 = 2026-01-02
09)------MaterializedCteScanExec: name=c

query TI rowsort
WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-01'
UNION ALL
SELECT * FROM c WHERE day = '2026-01-02'
----
2026-01-01 1
2026-01-01 2
2026-01-02 3

# One reference has no filter, so it reads all the rows of the body. The body
# is not filtered.
query TT
EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-01'
UNION ALL
SELECT * FROM c
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----TableScan: events projection=[day, n]
04)--Union
05)----Filter: c.day = Utf8View("2026-01-01")
06)------MaterializedCteScan: name=c
07)----MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/cte_materialized/events.parquet]]}, projection=[day, n], file_type=parquet
03)--UnionExec
04)----FilterExec: day@0 = 2026-01-01
05)------MaterializedCteScanExec: name=c
06)----MaterializedCteScanExec: name=c

query TI rowsort
WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-04'
UNION ALL
SELECT * FROM c
----
2026-01-01 1
2026-01-01 2
2026-01-02 3
2026-01-03 4
2026-01-04 5
2026-01-04 5

# A reference with only a volatile filter counts as a reference without a
# filter.
query TT
EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-01'
UNION ALL
SELECT * FROM c WHERE random() < 2
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----TableScan: events projection=[day, n]
04)--Union
05)----Filter: c.day = Utf8View("2026-01-01")
06)------MaterializedCteScan: name=c
07)----Filter: random() < Float64(2)
08)------MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/cte_materialized/events.parquet]]}, projection=[day, n], file_type=parquet
03)--UnionExec
04)----FilterExec: day@0 = 2026-01-01
05)------MaterializedCteScanExec: name=c
06)----FilterExec: random() < 2
07)------MaterializedCteScanExec: name=c

# Only the deterministic part of a filter goes into the body.
query TT
EXPLAIN WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-01'
UNION ALL
SELECT * FROM c WHERE n > 3 AND random() < 2
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----Filter: events.day = Utf8View("2026-01-01") OR events.n > Int64(3)
04)------TableScan: events projection=[day, n], partial_filters=[events.day = Utf8View("2026-01-01") OR events.n > Int64(3)]
05)--Union
06)----Filter: c.day = Utf8View("2026-01-01")
07)------MaterializedCteScan: name=c
08)----Filter: c.n > Int64(3) AND random() < Float64(2)
09)------MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--FilterExec: day@0 = 2026-01-01 OR n@1 > 3
03)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
04)------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/cte_materialized/events.parquet]]}, projection=[day, n], file_type=parquet, predicate=day@0 = 2026-01-01 OR n@1 > 3, pruning_predicate=day_null_count@2 != row_count@3 AND day_min@0 <= 2026-01-01 AND 2026-01-01 <= day_max@1 OR n_null_count@5 != row_count@3 AND n_max@4 > 3, required_guarantees=[]
05)--UnionExec
06)----FilterExec: day@0 = 2026-01-01
07)------MaterializedCteScanExec: name=c
08)----FilterExec: n@1 > 3 AND random() < 2
09)------MaterializedCteScanExec: name=c

query TI rowsort
WITH c AS MATERIALIZED (SELECT * FROM events)
SELECT * FROM c WHERE day = '2026-01-01'
UNION ALL
SELECT * FROM c WHERE n > 3 AND random() < 2
----
2026-01-01 1
2026-01-01 2
2026-01-03 4
2026-01-04 5

# The references have aliases, and the body has other column names than the
# references. The filters of the two sides of the join go into the body.
query TT
EXPLAIN WITH c(d, m) AS MATERIALIZED (SELECT day, n * 10 FROM events)
SELECT a.d, a.m, b.m FROM c a JOIN c b ON a.d = b.d
WHERE a.m < 20 AND b.m >= 20
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----Projection: events.day AS d, events.n * Int64(10) AS m
04)------Filter: __common_expr_2 < Int64(20) OR __common_expr_2 >= Int64(20)
05)--------Projection: events.n * Int64(10) AS __common_expr_2, events.day, events.n
06)----------TableScan: events projection=[day, n], partial_filters=[events.n * Int64(10) < Int64(20) OR events.n * Int64(10) >= Int64(20)]
07)--Projection: a.d, a.m, b.m
08)----Inner Join: a.d = b.d
09)------SubqueryAlias: a
10)--------Filter: c.m < Int64(20)
11)----------MaterializedCteScan: name=c
12)------SubqueryAlias: b
13)--------Filter: c.m >= Int64(20)
14)----------MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--ProjectionExec: expr=[day@0 as d, n@1 * 10 as m]
03)----FilterExec: __common_expr_2@0 < 20 OR __common_expr_2@0 >= 20, projection=[day@1, n@2]
04)------ProjectionExec: expr=[n@1 * 10 as __common_expr_2, day@0 as day, n@1 as n]
05)--------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
06)----------DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/cte_materialized/events.parquet]]}, projection=[day, n], file_type=parquet, predicate=n@1 * 10 < 20 OR n@1 * 10 >= 20
07)--HashJoinExec: mode=Partitioned, join_type=Inner, on=[(d@0, d@0)], projection=[d@0, m@1, m@3]
08)----RepartitionExec: partitioning=Hash([d@0], 4), input_partitions=4
09)------FilterExec: m@1 < 20
10)--------MaterializedCteScanExec: name=c
11)----RepartitionExec: partitioning=Hash([d@0], 4), input_partitions=4
12)------FilterExec: m@1 >= 20
13)--------MaterializedCteScanExec: name=c

query TII
WITH c(d, m) AS MATERIALIZED (SELECT day, n * 10 FROM events)
SELECT a.d, a.m, b.m FROM c a JOIN c b ON a.d = b.d
WHERE a.m < 20 AND b.m >= 20
----
2026-01-01 10 20

# One reference is in a scalar subquery and one is in the main query.
query TT
