# An unbounded body is rejected: it is fully buffered before any row is
# returned, so the query would never produce output.
statement ok
CREATE UNBOUNDED EXTERNAL TABLE unbounded_t(c1 integer NOT NULL)
STORED AS CSV
LOCATION '../core/tests/data/empty.csv'
OPTIONS ('format.has_header' 'true');

