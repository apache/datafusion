# Uncorrelated EXISTS, IN and scalar subqueries inside the body.
# MATERIALIZED
# PostgreSQL: 2 3. DuckDB: 2 3.
query I rowsort
WITH m AS MATERIALIZED (
  SELECT k FROM t
  WHERE EXISTS (SELECT 1 FROM t t2 WHERE t2.k > 3)
    AND k IN (SELECT k FROM t WHERE v > 10)
    AND v < (SELECT max(v) FROM t))
SELECT k FROM m
