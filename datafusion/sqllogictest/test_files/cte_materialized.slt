# Recursive queries.
#
# A volatile CTE declared outside a recursive CTE and read by its recursive
# term. Materialized, it is evaluated once for the whole query.
# MATERIALIZED
# PostgreSQL: 1. DuckDB: 1.
query I rowsort
WITH RECURSIVE
  m AS MATERIALIZED (SELECT random() AS x),
  r AS (
    SELECT 1 AS n, x FROM m
    UNION ALL
    SELECT n + 1, m.x FROM r, m WHERE n < 4)
SELECT count(DISTINCT x) FROM r
----
1

# NOT MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 4.
query I rowsort
WITH RECURSIVE
  m AS NOT MATERIALIZED (SELECT random() AS x),
  r AS (
    SELECT 1 AS n, x FROM m
    UNION ALL
    SELECT n + 1, m.x FROM r, m WHERE n < 4)
SELECT count(DISTINCT x) FROM r
----
4

# no keyword
# PostgreSQL: 1 (differs). DuckDB: 1 (differs).
query I rowsort
WITH RECURSIVE
  m AS (SELECT random() AS x),
  r AS (
    SELECT 1 AS n, x FROM m
    UNION ALL
    SELECT n + 1, m.x FROM r, m WHERE n < 4)
SELECT count(DISTINCT x) FROM r
----
4

# A volatile CTE declared inside the recursive term. The recursive term is a
# new query in each iteration, so the CTE is evaluated again in each iteration.
# MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 3.
query I rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, CAST(0 AS DOUBLE PRECISION) AS x
  UNION ALL
  SELECT n + 1, s.x FROM r, (WITH m AS MATERIALIZED (SELECT random() AS x) SELECT x FROM m) s
  WHERE n < 4)
SELECT count(DISTINCT x) FROM r WHERE n > 1
----
3

# NOT MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 3.
query I rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, CAST(0 AS DOUBLE PRECISION) AS x
  UNION ALL
  SELECT n + 1, s.x FROM r, (WITH m AS NOT MATERIALIZED (SELECT random() AS x) SELECT x FROM m) s
  WHERE n < 4)
SELECT count(DISTINCT x) FROM r WHERE n > 1
----
3

# no keyword
# PostgreSQL: 1 (differs). DuckDB: 3.
query I rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, CAST(0 AS DOUBLE PRECISION) AS x
  UNION ALL
  SELECT n + 1, s.x FROM r, (WITH m AS (SELECT random() AS x) SELECT x FROM m) s
  WHERE n < 4)
SELECT count(DISTINCT x) FROM r WHERE n > 1
----
3

# Inside one iteration, two references to a CTE declared in the recursive term.
# MATERIALIZED
# PostgreSQL: 1 true 2 true 3 true 4 true. DuckDB: 1 true 2 true 3 true 4 true.
query IB rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, true AS same
  UNION ALL
  SELECT n + 1, s.same FROM r,
    (WITH m AS MATERIALIZED (SELECT random() AS x) SELECT a.x = b.x AS same FROM m a, m b) s
  WHERE n < 4)
SELECT n, same FROM r
----
1 true
2 true
3 true
4 true

# NOT MATERIALIZED
# PostgreSQL: 1 true 2 true 3 true 4 true (differs). DuckDB: 1 true 2 false 3 false 4 false.
query IB rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, true AS same
  UNION ALL
  SELECT n + 1, s.same FROM r,
    (WITH m AS NOT MATERIALIZED (SELECT random() AS x) SELECT a.x = b.x AS same FROM m a, m b) s
  WHERE n < 4)
SELECT n, same FROM r
----
1 true
2 false
3 false
4 false

# no keyword
# PostgreSQL: 1 true 2 true 3 true 4 true (differs). DuckDB: 1 true 2 true 3 true 4 true (differs).
query IB rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, true AS same
  UNION ALL
  SELECT n + 1, s.same FROM r,
    (WITH m AS (SELECT random() AS x) SELECT a.x = b.x AS same FROM m a, m b) s
  WHERE n < 4)
SELECT n, same FROM r
----
1 true
2 false
3 false
4 false

