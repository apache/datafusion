# Recursive queries.
#
# A volatile CTE declared outside a recursive CTE and read by its recursive
# term. Materialized, it is evaluated once for the whole query.
# MATERIALIZED
# PostgreSQL: 1. DuckDB: 1.
query I rowsort
WITH RECURSIVE
  m AS MATERIALIZED (SELECT random() AS x),
  r AS (
    SELECT 1 AS n, x FROM m
    UNION ALL
    SELECT n + 1, m.x FROM r, m WHERE n < 4)
SELECT count(DISTINCT x) FROM r
----
1

