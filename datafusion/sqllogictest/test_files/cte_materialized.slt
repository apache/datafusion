query I rowsort
WITH m AS MATERIALIZED (SELECT random() AS x)
SELECT count(*) FROM m WHERE x IN (SELECT x FROM m)
----
1

# NOT MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 0.
query I rowsort
WITH m AS NOT MATERIALIZED (SELECT random() AS x)
SELECT count(*) FROM m WHERE x IN (SELECT x FROM m)
