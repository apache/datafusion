# Inside one iteration, two references to a CTE declared in the recursive term.
# MATERIALIZED
# PostgreSQL: 1 true 2 true 3 true 4 true. DuckDB: 1 true 2 true 3 true 4 true.
query IB rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, true AS same
  UNION ALL
  SELECT n + 1, s.same FROM r,
    (WITH m AS MATERIALIZED (SELECT random() AS x) SELECT a.x = b.x AS same FROM m a, m b) s
  WHERE n < 4)
SELECT n, same FROM r
