# A recursive body. The new filter stays above the RecursiveQuery, so the
# recursion is not changed: the rows with n > 2 need the rows with n <= 2.
query TT
EXPLAIN WITH RECURSIVE r AS MATERIALIZED (
  SELECT 1 AS n UNION ALL SELECT n + 1 FROM r WHERE n < 5
)
SELECT n FROM r WHERE n = 3 UNION ALL SELECT n FROM r WHERE n > 4
----
logical_plan
01)MaterializedCte: name=r
02)--SubqueryAlias: r
03)----Filter: n = Int64(3) OR n > Int64(4)
04)------RecursiveQuery: is_distinct=false
05)--------Projection: Int64(1) AS n
06)----------EmptyRelation: rows=1
07)--------Projection: r.n + Int64(1)
08)----------Filter: r.n < Int64(5)
09)------------TableScan: r projection=[n]
10)--Union
11)----Filter: r.n = Int64(3)
12)------MaterializedCteScan: name=r
13)----Filter: r.n > Int64(4)
14)------MaterializedCteScan: name=r
physical_plan
01)MaterializedCteExec: name=r
02)--FilterExec: n@0 = 3 OR n@0 > 4
03)----RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
04)------RecursiveQueryExec: name=r, is_distinct=false
05)--------ProjectionExec: expr=[CAST(1 AS Int64) as n]
06)----------PlaceholderRowExec
07)--------CoalescePartitionsExec
08)----------ProjectionExec: expr=[n@0 + 1 as n]
09)------------FilterExec: n@0 < 5
10)--------------RepartitionExec: partitioning=RoundRobinBatch(4), input_partitions=1
11)----------------WorkTableExec: name=r
12)--UnionExec
13)----FilterExec: n@0 = 3
14)------MaterializedCteScanExec: name=r
15)----FilterExec: n@0 > 4
16)------MaterializedCteScanExec: name=r

