query I rowsort
WITH a AS (
  WITH b AS (SELECT random() AS x) SELECT x FROM b UNION ALL SELECT x FROM b)
SELECT count(DISTINCT x) FROM (SELECT x FROM a UNION ALL SELECT x FROM a)
