# PostgreSQL: 1. DuckDB: 1.
query I rowsort
WITH m AS MATERIALIZED (SELECT (SELECT random()) AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM m UNION ALL SELECT x FROM m)
