1

# NOT MATERIALIZED
# PostgreSQL: 1. DuckDB: 2 (differs).
query I rowsort
WITH m AS NOT MATERIALIZED (SELECT (SELECT random()) AS x)
SELECT count(DISTINCT x) FROM (SELECT x FROM m UNION ALL SELECT x FROM m)
