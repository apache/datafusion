# A volatile CTE declared inside the recursive term. The recursive term is a
# new query in each iteration, so the CTE is evaluated again in each iteration.
# MATERIALIZED
# PostgreSQL: 1 (differs). DuckDB: 3.
query I rowsort
WITH RECURSIVE r AS (
  SELECT 1 AS n, CAST(0 AS DOUBLE PRECISION) AS x
  UNION ALL
  SELECT n + 1, s.x FROM r, (WITH m AS MATERIALIZED (SELECT random() AS x) SELECT x FROM m) s
  WHERE n < 4)
SELECT count(DISTINCT x) FROM r WHERE n > 1
----
3

