# A volatile body is not filtered. A filter above the volatile projection
# would be correct, but the physical filter pushdown gives a copy of it, with
# random() in the place of x, to the Parquet scan. With pushdown_filters, the
# scan would then remove rows with a second value of random().
# Each row has one value of x, thus it is in one of the two references and the
# total is always 5.
statement ok
set datafusion.execution.parquet.pushdown_filters = true;

query TT
EXPLAIN WITH c AS MATERIALIZED (SELECT n, random() AS x FROM events)
SELECT n FROM c WHERE x < 0.5
UNION ALL
SELECT n FROM c WHERE x >= 0.5
----
logical_plan
01)MaterializedCte: name=c
02)--SubqueryAlias: c
03)----Projection: events.n, random() AS x
04)------TableScan: events projection=[n]
05)--Union
06)----Projection: c.n
07)------Filter: c.x < Float64(0.5)
08)--------MaterializedCteScan: name=c
09)----Projection: c.n
10)------Filter: c.x >= Float64(0.5)
11)--------MaterializedCteScan: name=c
physical_plan
01)MaterializedCteExec: name=c
02)--DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/cte_materialized/events.parquet]]}, projection=[n, random() as x], file_type=parquet
03)--UnionExec
04)----FilterExec: x@1 < 0.5, projection=[n@0]
05)------MaterializedCteScanExec: name=c
06)----FilterExec: x@1 >= 0.5, projection=[n@0]
07)------MaterializedCteScanExec: name=c

