# correlated_scalar_subquery_returning_two_rows_per_outer_row
query error A GROUP BY clause in a scalar correlated subquery cannot contain non-correlated columns
SELECT k, (SELECT max(v) FROM d d2 WHERE d2.k = d.k GROUP BY d2.k, d2.v) FROM d ORDER BY 1,2;

statement ok
DROP TABLE d;

