# https://github.com/apache/datafusion/issues/5492#issuecomment-5934476405
statement ok
CREATE TABLE t1(t1_id INT, t1_name TEXT, t1_int INT) AS VALUES
(11, 'a', 1),
(22, 'b', 2),
(33, 'c', 3),
(44, 'd', 4);

statement ok
CREATE TABLE t2(t2_id INT, t2_name TEXT, t2_int INT) AS VALUES
(11, 'z', 3),
(22, 'y', 1),
(44, 'x', 3),
(55, 'w', 3);

statement ok
CREATE TABLE t3(t3_id INT PRIMARY KEY, t3_name TEXT, t3_int INT) AS VALUES
(11, 'e', 3),
(22, 'f', 1),
(44, 'g', 3),
(55, 'h', 3);

# exists_depth_2_correlation_skipping_a_level
query error Schema error: No field named t1\.t1_id
SELECT t1.t1_id FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.t2_id = t1.t1_id AND EXISTS (SELECT 1 FROM t3 WHERE t3.t3_id > t1.t1_id));

# exists_depth_2_correlation_one_level_each
query I rowsort
SELECT t1.t1_id FROM t1 WHERE EXISTS (SELECT 1 FROM t2 WHERE t2.t2_id = t1.t1_id AND EXISTS (SELECT 1 FROM t3 WHERE t3.t3_id = t2.t2_id));
----
11
22
44

# exists_in_inner_join_on_reading_both_inputs
query error Schema error: No field named t2\.t2_id
SELECT t1.t1_id FROM t1 JOIN t2 ON EXISTS (SELECT 1 FROM t3 WHERE t3.t3_id = t1.t1_id AND t3.t3_id = t2.t2_id);

# exists_in_scalar_subquery_correlated_to_both_levels
query error Schema error: No field named t1\.t1_id
SELECT t1.t1_id, (SELECT COUNT(*) FROM t2 WHERE EXISTS (SELECT 1 FROM t3 WHERE t3.t3_id = t2.t2_id AND t3.t3_id = t1.t1_id)) AS c FROM t1;

# outer_column_in_aggregate_argument
query error Physical plan does not support logical expression ScalarSubquery
SELECT t1.t1_int, (SELECT SUM(t2.t2_int + t1.t1_int) FROM t2) FROM t1;

# outer_column_added_to_aggregate_result
query error Physical plan does not support logical expression ScalarSubquery
SELECT t1.t1_int, (SELECT MIN(t2.t2_int) + t1.t1_int FROM t2) AS c FROM t1;

# outer_column_projected_under_limit
query error Physical plan does not support logical expression ScalarSubquery
SELECT t1.t1_int, (SELECT t1.t1_int FROM t2 LIMIT 1) AS c FROM t1;

# greater_than_all_over_expression_with_outer_column
query error Physical plan does not support logical expression Exists
SELECT t1.t1_id FROM t1 WHERE t1.t1_id > ALL(SELECT (t2.t2_id + t1.t1_id - 1) / 2 FROM t2 WHERE t2.t2_id IS NOT NULL);

# correlated_inequality_below_count
query error Physical plan does not support logical expression ScalarSubquery
SELECT t1.t1_int, (SELECT COUNT(*) FROM t2 WHERE t2.t2_int > t1.t1_int) AS c FROM t1;

# outer_column_as_grouping_sets_key
query error Physical plan does not support logical expression ScalarSubquery
SELECT t1.t1_int, (SELECT SUM(t2.t2_int) FROM t2 GROUP BY GROUPING SETS((t1.t1_int))) AS c FROM t1;

# invalid_aggregate_over_outer_column_without_from
query error Physical plan does not support logical expression ScalarSubquery
SELECT t1.t1_int, (SELECT SUM(t1.t1_int)) AS c FROM t1;

# invalid_aggregate_over_outer_column_in_having
query error Physical plan does not support logical expression Exists
SELECT t1.t1_id FROM t1 WHERE EXISTS (SELECT t2.t2_id FROM t2 GROUP BY t2.t2_id HAVING t2.t2_id > MIN(t1.t1_int));

statement ok
DROP TABLE t1;

statement ok
DROP TABLE t2;

statement ok
DROP TABLE t3;

