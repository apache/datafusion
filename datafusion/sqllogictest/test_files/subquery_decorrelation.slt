# exists_with_outer_column_in_inner_join_on
query I
SELECT a FROM t1 WHERE EXISTS (SELECT 1 FROM t2 JOIN t3 ON t2.a = t3.a AND t3.a = t1.a) ORDER BY a;
----
1

statement ok
DROP TABLE t1;

statement ok
DROP TABLE t2;

statement ok
DROP TABLE t3;

# https://github.com/apache/datafusion/issues/16137
statement ok
CREATE TABLE t1(a INT) AS VALUES (1), (2);

statement ok
CREATE TABLE t2(a INT, y INT) AS VALUES (1, 5), (2, 7);

# non_aggregated_correlated_scalar_subquery_over_another_table
query error Correlated scalar subquery must be aggregated to return at most one row
SELECT a, (SELECT y FROM t2 WHERE t2.a = t1.a) AS y FROM t1 ORDER BY a;

statement ok
DROP TABLE t1;

statement ok
DROP TABLE t2;

# https://github.com/apache/datafusion/issues/26572
statement ok
set datafusion.execution.batch_size = 1;

statement ok
CREATE TABLE t (a INT) AS VALUES (1), (2);

# order_by_uncorrelated_scalar_subquery_over_right_join_with_limit
query error does not satisfy order requirements
SELECT t.a, (SELECT max(a) FROM t) AS m FROM t AS u RIGHT JOIN t ON u.a = t.a ORDER BY t.a, m LIMIT 5;

statement ok
DROP TABLE t;

statement ok
RESET datafusion.execution.batch_size;
