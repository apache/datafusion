logical_plan EmptyRelation: rows=0

# Pruning the entire chain must not depend on repeated optimizer passes.
statement ok
SET datafusion.optimizer.max_passes = 1;

query TT
EXPLAIN SELECT x FROM many_disjoint_ranges WHERE x >= 5000;
----
logical_plan
01)SubqueryAlias: many_disjoint_ranges
02)--Projection: disjoint_ranges.x
03)----EmptyRelation: rows=0

# A surviving range still returns its matching rows and excludes NULL.
query I
SELECT x FROM many_disjoint_ranges WHERE x >= 10 ORDER BY x;
----
10
11

statement ok
SET datafusion.optimizer.max_passes = 3;

# The request lies in the gap between intervals.
query TT
EXPLAIN SELECT x FROM disjoint_ranges
WHERE x >= 3 AND x < 5 AND ((x >= 1 AND x < 3) OR (x >= 5 AND x < 7));
----
logical_plan EmptyRelation: rows=0

# Removing one impossible disjunct must retain the outer lower bound (x=5 fails).
query I
SELECT x FROM disjoint_ranges
WHERE x >= 6 AND ((x >= 1 AND x < 3) OR (x >= 5 AND x < 11)) ORDER BY x;
----
6
7
10

query TT
EXPLAIN SELECT x FROM disjoint_ranges
WHERE x >= 6 AND ((x >= 1 AND x < 3) OR (x >= 5 AND x < 11));
----
logical_plan
01)Filter: disjoint_ranges.x >= Int64(6) AND disjoint_ranges.x < Int64(11)
02)--TableScan: disjoint_ranges projection=[x]

# The upper endpoint remains possible when both bounds include it.
query I
SELECT x FROM disjoint_ranges
WHERE 7 <= x AND ((x >= 1 AND x < 3) OR (x >= 5 AND x <= 7)) ORDER BY x;
----
7

# All branches can contradict the context, including equalities and inequalities.
query TT
EXPLAIN SELECT x FROM disjoint_ranges WHERE x = 6 AND (x < 3 OR x != 6);
----
logical_plan EmptyRelation: rows=0

# Inner conjunctions contribute assumptions only to their descendants.
query I
SELECT x FROM disjoint_ranges
WHERE x >= 3 AND ((x < 7 AND (x < 3 OR x >= 6)) OR x >= 10) ORDER BY x;
----
6
10
11

# An unrelated column can satisfy the disjunction.
query I
SELECT x FROM disjoint_ranges WHERE x >= 10 AND (x < 3 OR y = 10) ORDER BY x;
----
10

# Do not infer bounds through unsupported arithmetic/casts or leak them across OR.
query I
SELECT x FROM disjoint_ranges
WHERE x >= 10 AND (x < 3 OR x - 10 = 1) ORDER BY x;
----
11

query I
SELECT x FROM disjoint_ranges WHERE (x >= 10 AND x < 3) OR x = 2 ORDER BY x;
----
2

# NULL results under NOT must remain NULL; only positive AND/OR contexts are visited.
query I
SELECT x FROM disjoint_ranges
WHERE NOT (x >= 10 AND (x < 3 OR x < 7)) ORDER BY x;
----
1
2
3
4
5
6
7
10
11

# A nullable Boolean projection must not be rewritten using filter-only semantics.
query B
SELECT x >= 10 AND (x < 3 OR x < 7) FROM disjoint_ranges WHERE x IS NULL;
----
NULL

# Precise timestamp bounds: two disjoint months and a request in a later year.
statement ok
CREATE TABLE disjoint_times (ts TIMESTAMP);

query TT
EXPLAIN SELECT ts FROM disjoint_times
WHERE ts >= TIMESTAMP '2026-01-01'
AND ((ts >= TIMESTAMP '2022-05-01' AND ts < TIMESTAMP '2022-06-01')
  OR (ts >= TIMESTAMP '2022-08-01' AND ts < TIMESTAMP '2022-09-01'));
----
logical_plan EmptyRelation: rows=0

# Nanosecond precision at the boundary must distinguish < from <=.
query TT
EXPLAIN SELECT ts FROM disjoint_times
WHERE ts >= TIMESTAMP '2022-09-01 00:00:00.000000001'
AND (ts < TIMESTAMP '2022-09-01 00:00:00.000000001'
  OR ts <= TIMESTAMP '2022-09-01 00:00:00.000000000');
----
logical_plan EmptyRelation: rows=0

# Time zone offsets denote instants; equal instants at an exclusive bound conflict.
statement ok
CREATE TABLE zoned_times AS
SELECT arrow_cast('2022-09-01T00:00:00-04:00',
                  'Timestamp(Nanosecond, Some("America/New_York"))') AS ts;

query TT
EXPLAIN SELECT ts FROM zoned_times
WHERE ts >= arrow_cast('2022-09-01T04:00:00Z',
                        'Timestamp(Nanosecond, Some("America/New_York"))')
AND (ts < arrow_cast('2022-09-01T00:00:00-04:00',
                      'Timestamp(Nanosecond, Some("America/New_York"))')
  OR ts < arrow_cast('2022-06-01T00:00:00-04:00',
                      'Timestamp(Nanosecond, Some("America/New_York"))'));
----
logical_plan EmptyRelation: rows=0

# A type conversion can change values, so its result must not be treated as x itself.
query I
SELECT x FROM disjoint_ranges
WHERE x >= 10 AND (x < 3 OR CAST(x AS VARCHAR) < '2') ORDER BY x;
----
10
11

# Outer aliases, ordering and limit must not prevent removal of the empty union arm.
query TT
EXPLAIN SELECT * FROM (
    SELECT CAST(20 AS BIGINT) AS value
    UNION ALL
    SELECT x AS value FROM disjoint_ranges
    WHERE (x >= 1 AND x < 3) OR (x >= 5 AND x < 7)
) u WHERE value >= 10 ORDER BY value LIMIT 1;
----
logical_plan
01)Sort: u.value ASC NULLS LAST, fetch=1
02)--SubqueryAlias: u
03)----Projection: Int64(20) AS value
04)------EmptyRelation: rows=1

query I
SELECT * FROM (
    SELECT CAST(20 AS BIGINT) AS value
    UNION ALL
    SELECT x AS value FROM disjoint_ranges
    WHERE (x >= 1 AND x < 3) OR (x >= 5 AND x < 7)
) u WHERE value >= 10 ORDER BY value LIMIT 1;
----
20

statement ok
SET datafusion.explain.logical_plan_only = false;
