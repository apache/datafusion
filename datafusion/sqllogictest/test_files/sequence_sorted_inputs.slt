# Touching boundary: two files share the boundary value 5.
# ProgressiveEvalExec can still be used.

query I
COPY (SELECT * FROM src_nine WHERE int_col <= 5 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/touching/0.parquet'
STORED AS PARQUET;
----
5

query I
COPY (SELECT * FROM src_nine WHERE int_col >= 5 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/touching/1.parquet'
STORED AS PARQUET;
----
5

