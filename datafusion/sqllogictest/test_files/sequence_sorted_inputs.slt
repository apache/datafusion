# Test orders covering multiple columns.
# When files share a boundary value on the first sort column, the min/max of
# the second column must be used to determine whether overlap is possible.

statement ok
CREATE TABLE src_multi_a (int_col INT, sec_col INT) AS VALUES
(1, 1), (2, 1), (5, 1), (5, 2);

statement ok
CREATE TABLE src_multi_b (int_col INT, sec_col INT) AS VALUES
(5, 3), (5, 4), (8, 3), (9, 4);

query I
COPY (SELECT * FROM src_multi_a ORDER BY int_col, sec_col)
TO 'test_files/scratch/sequence_sorted_inputs/multi_col/0.parquet'
STORED AS PARQUET;
----
4

query I
COPY (SELECT * FROM src_multi_b ORDER BY int_col, sec_col)
TO 'test_files/scratch/sequence_sorted_inputs/multi_col/1.parquet'
STORED AS PARQUET;
----
4

statement ok
CREATE EXTERNAL TABLE multi_col_table (
  int_col INT NOT NULL,
  sec_col INT NOT NULL
)
STORED AS PARQUET
WITH ORDER (int_col ASC NULLS LAST, sec_col ASC NULLS LAST)
LOCATION 'test_files/scratch/sequence_sorted_inputs/multi_col/';

query TT
EXPLAIN SELECT int_col, sec_col FROM multi_col_table ORDER BY int_col, sec_col;
----
logical_plan
01)Sort: multi_col_table.int_col ASC NULLS LAST, multi_col_table.sec_col ASC NULLS LAST
02)--TableScan: multi_col_table projection=[int_col, sec_col]
physical_plan
01)ProgressiveEvalExec: 
02)--DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/multi_col/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/multi_col/1.parquet]]}, projection=[int_col, sec_col], output_ordering=[int_col@0 ASC NULLS LAST, sec_col@1 ASC NULLS LAST], file_type=parquet

query II
SELECT int_col, sec_col FROM multi_col_table ORDER BY int_col, sec_col;
