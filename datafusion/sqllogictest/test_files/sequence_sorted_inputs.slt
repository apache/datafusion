# Test handling of nulls in the sort column

statement ok
CREATE TABLE src_nulls (n_col INT) AS VALUES
(1), (2), (NULL),
(3), (4), (5);

# A null in the first partition when nulls are sorted last invalidates the rule,
# the SortPreservingMerge must be kept.
query I
COPY (SELECT n_col FROM src_nulls WHERE n_col <= 2 OR n_col IS NULL ORDER BY n_col ASC NULLS LAST)
TO 'test_files/scratch/sequence_sorted_inputs/nulls_mid/0.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT n_col FROM src_nulls WHERE n_col > 2 ORDER BY n_col ASC NULLS LAST)
TO 'test_files/scratch/sequence_sorted_inputs/nulls_mid/1.parquet'
STORED AS PARQUET;
----
3

statement ok
CREATE EXTERNAL TABLE nulls_mid_table (n_col INT)
STORED AS PARQUET
WITH ORDER (n_col ASC NULLS LAST)
LOCATION 'test_files/scratch/sequence_sorted_inputs/nulls_mid/';

query TT
EXPLAIN SELECT n_col FROM nulls_mid_table ORDER BY n_col ASC NULLS LAST;
----
logical_plan
01)Sort: nulls_mid_table.n_col ASC NULLS LAST
02)--TableScan: nulls_mid_table projection=[n_col]
physical_plan
01)SortPreservingMergeExec: [n_col@0 ASC NULLS LAST]
02)--DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/nulls_mid/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/nulls_mid/1.parquet]]}, projection=[n_col], output_ordering=[n_col@0 ASC NULLS LAST], file_type=parquet

query I
SELECT n_col FROM nulls_mid_table ORDER BY n_col ASC NULLS LAST;
----
1
2
3
4
5
NULL

# A null in the last partition when nulls are sorted last is OK, ProgressiveEvalExec can be used.
query I
COPY (SELECT n_col FROM src_nulls WHERE n_col <= 3 ORDER BY n_col ASC NULLS LAST)
TO 'test_files/scratch/sequence_sorted_inputs/nulls_last/0.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT n_col FROM src_nulls WHERE n_col > 3 OR n_col IS NULL ORDER BY n_col ASC NULLS LAST)
TO 'test_files/scratch/sequence_sorted_inputs/nulls_last/1.parquet'
STORED AS PARQUET;
----
3

