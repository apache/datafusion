2 1
5 1
5 2
5 3
5 4
8 3
9 4

# Known limitation: with more target partitions than files (and enough rows
# for repartitioning to look beneficial), the scan is byte-range split for
# parallelism; the slices only carry whole-file statistics, so the partitions
# are no longer provably non-overlapping and the merge is kept

query I
COPY (SELECT value AS int_col FROM generate_series(1, 10000) AS t(value) ORDER BY value)
TO 'test_files/scratch/sequence_sorted_inputs/big/0.parquet'
STORED AS PARQUET;
----
10000

query I
COPY (SELECT value AS int_col FROM generate_series(10001, 20000) AS t(value) ORDER BY value)
TO 'test_files/scratch/sequence_sorted_inputs/big/1.parquet'
STORED AS PARQUET;
----
10000

query I
COPY (SELECT value AS int_col FROM generate_series(20001, 30000) AS t(value) ORDER BY value)
TO 'test_files/scratch/sequence_sorted_inputs/big/2.parquet'
STORED AS PARQUET;
----
10000

statement ok
CREATE EXTERNAL TABLE big_table (int_col BIGINT NOT NULL)
STORED AS PARQUET
WITH ORDER (int_col ASC NULLS LAST)
LOCATION 'test_files/scratch/sequence_sorted_inputs/big/';

# At the file-count partition target the rule applies.
query TT
EXPLAIN SELECT int_col FROM big_table ORDER BY int_col;
----
logical_plan
01)Sort: big_table.int_col ASC NULLS LAST
02)--TableScan: big_table projection=[int_col]
physical_plan
01)ProgressiveEvalExec: 
02)--DataSourceExec: file_groups={3 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/2.parquet]]}, projection=[int_col], output_ordering=[int_col@0 ASC NULLS LAST], file_type=parquet

statement ok
set datafusion.execution.target_partitions = 8;

statement ok
set datafusion.optimizer.repartition_file_min_size = 1;

# With 8 target partitions the three files are split into byte ranges and
# the merge must be kept.
query TT
EXPLAIN SELECT int_col FROM big_table ORDER BY int_col;
----
logical_plan
01)Sort: big_table.int_col ASC NULLS LAST
02)--TableScan: big_table projection=[int_col]
physical_plan
01)SortPreservingMergeExec: [int_col@0 ASC NULLS LAST]
02)--DataSourceExec: file_groups={8 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/0.parquet:0..12185], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/1.parquet:0..9242], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/2.parquet:0..13863], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/0.parquet:12185..24370], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/big/1.parquet:9242..18484], ...]}, projection=[int_col], output_ordering=[int_col@0 ASC NULLS LAST], file_type=parquet

# Results are still correct through the merge.
query I
SELECT int_col FROM big_table ORDER BY int_col LIMIT 3;
----
1
2
3

query I
SELECT count(*) FROM big_table;
----
30000

# Test PushdownSort interaction. Create four files named so
# alphabetical order does not match id order, but the groups are still
# non-overlapping:
#   group 0: aa (id 4-6), ab (id 1-3)   -> covers ids [1, 6]
#   group 1: ac (id 10-12), ad (id 7-9) -> covers ids [7, 12]

statement ok
set datafusion.execution.target_partitions = 2;

statement ok
CREATE TABLE src_pushdown_then_sequence (id INT, val INT) AS VALUES
(1, 10), (2, 20), (3, 30),
(4, 40), (5, 50), (6, 60),
(7, 70), (8, 80), (9, 90),
(10, 100), (11, 110), (12, 120);

query I
COPY (SELECT * FROM src_pushdown_then_sequence WHERE id BETWEEN 4 AND 6 ORDER BY id)
TO 'test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/aa.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_pushdown_then_sequence WHERE id BETWEEN 1 AND 3 ORDER BY id)
TO 'test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ab.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_pushdown_then_sequence WHERE id BETWEEN 10 AND 12 ORDER BY id)
TO 'test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ac.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_pushdown_then_sequence WHERE id BETWEEN 7 AND 9 ORDER BY id)
TO 'test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ad.parquet'
STORED AS PARQUET;
----
3

statement ok
CREATE EXTERNAL TABLE pushdown_then_sequence_table (
  id INT NOT NULL,
  val INT NOT NULL
)
STORED AS PARQUET
WITH ORDER (id ASC NULLS LAST)
LOCATION 'test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/';

# Scenario 1: with PushdownSort disabled, each group's files are read in the wrong
# order, so a SortExec is required. SequenceSortedInputs is still and applied to the
# sort output, used due to the groups being non-overlapping.
statement ok
set datafusion.optimizer.enable_sort_pushdown = false;

query TT
EXPLAIN SELECT id FROM pushdown_then_sequence_table ORDER BY id;
----
logical_plan
01)Sort: pushdown_then_sequence_table.id ASC NULLS LAST
02)--TableScan: pushdown_then_sequence_table projection=[id]
physical_plan
01)ProgressiveEvalExec: 
02)--SortExec: expr=[id@0 ASC NULLS LAST], preserve_partitioning=[true]
03)----DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/aa.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ab.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ac.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ad.parquet]]}, projection=[id], file_type=parquet

# Scenario 2: with PushdownSort re-enabled, it updates the file order within
# each group, eliminating the SortExec.
statement ok
set datafusion.optimizer.enable_sort_pushdown = true;

query TT
EXPLAIN SELECT id FROM pushdown_then_sequence_table ORDER BY id;
----
logical_plan
01)Sort: pushdown_then_sequence_table.id ASC NULLS LAST
02)--TableScan: pushdown_then_sequence_table projection=[id]
physical_plan
01)ProgressiveEvalExec: 
02)--BufferExec: capacity=1073741824
03)----DataSourceExec: file_groups={2 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ab.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/aa.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ad.parquet, WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/pushdown_then_sequence/ac.parquet]]}, projection=[id], output_ordering=[id@0 ASC NULLS LAST], file_type=parquet

query I
SELECT id FROM pushdown_then_sequence_table ORDER BY id;
----
