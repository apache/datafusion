statement ok
DROP TABLE src_pushdown_then_sequence;

statement ok
DROP TABLE pushdown_then_sequence_table;

# Restore settings

statement ok
set datafusion.optimizer.repartition_file_min_size = 1048576;

statement ok
set datafusion.execution.target_partitions = 4;

statement ok
set datafusion.optimizer.sequence_sorted_inputs = false;
