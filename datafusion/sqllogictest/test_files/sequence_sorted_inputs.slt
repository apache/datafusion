# Tests for the SequenceSortedInputs physical optimizer rule.
# When the partitions feeding a SortPreservingMergeExec are
# non-overlapping ranges of the merge ordering, the rule replaces
# the merge with a ProgressiveEvalExec that # concatenates the
# partitions, inserting a ReorderPartitionsExec first when
# the partitions are not already laid out in the required order.

# One partition per file for deterministic grouping
statement ok
set datafusion.execution.target_partitions = 3;

# Exact per-partition statistics are required
statement ok
set datafusion.execution.collect_statistics = true;

statement ok
set datafusion.optimizer.sequence_sorted_inputs = true;

statement ok
CREATE TABLE src_nine (int_col INT, sec_col INT) AS VALUES
(1, 10), (2, 20), (3, 30),
(4, 40), (5, 50), (6, 60),
(7, 70), (8, 80), (9, 90);

# Split the test data into 3 files, kept in sort order

query I
COPY (SELECT * FROM src_nine WHERE int_col <= 3 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/ordered/0.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_nine WHERE int_col > 3 AND int_col <= 6 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/ordered/1.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_nine WHERE int_col > 6 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/ordered/2.parquet'
STORED AS PARQUET;
----
3

statement ok
CREATE EXTERNAL TABLE ordered_table (
  int_col INT NOT NULL,
  sec_col INT NOT NULL
)
STORED AS PARQUET
WITH ORDER (int_col ASC NULLS LAST)
LOCATION 'test_files/scratch/sequence_sorted_inputs/ordered/';

# Non-overlapping partitions already in the required order:
# the merge is replaced by a ProgressiveEvalExec with no reordering.
query TT
EXPLAIN SELECT int_col, sec_col FROM ordered_table ORDER BY int_col;
----
logical_plan
01)Sort: ordered_table.int_col ASC NULLS LAST
02)--TableScan: ordered_table projection=[int_col, sec_col]
physical_plan
01)ProgressiveEvalExec: 
02)--DataSourceExec: file_groups={3 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/2.parquet]]}, projection=[int_col, sec_col], output_ordering=[int_col@0 ASC NULLS LAST], file_type=parquet

query II
SELECT int_col, sec_col FROM ordered_table ORDER BY int_col;
----
1 10
2 20
3 30
4 40
5 50
6 60
7 70
8 80
9 90

# A LIMIT is pushed into the ProgressiveEvalExec as a fetch.
query TT
EXPLAIN SELECT int_col FROM ordered_table ORDER BY int_col LIMIT 4;
----
logical_plan
01)Sort: ordered_table.int_col ASC NULLS LAST, fetch=4
02)--TableScan: ordered_table projection=[int_col]
physical_plan
01)ProgressiveEvalExec: fetch=4, 
02)--DataSourceExec: file_groups={3 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/2.parquet]]}, projection=[int_col], limit=4, output_ordering=[int_col@0 ASC NULLS LAST], file_type=parquet

query I
SELECT int_col FROM ordered_table ORDER BY int_col LIMIT 4;
----
1
2
3
4

# A descending query with ascending data requires a sort and cannot
# use ProgressiveEvalExec.
query TT
EXPLAIN SELECT int_col FROM ordered_table ORDER BY int_col DESC;
----
logical_plan
01)Sort: ordered_table.int_col DESC NULLS FIRST
02)--TableScan: ordered_table projection=[int_col]
physical_plan
01)SortPreservingMergeExec: [int_col@0 DESC]
02)--SortExec: expr=[int_col@0 DESC], preserve_partitioning=[true]
03)----DataSourceExec: file_groups={3 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/2.parquet]]}, projection=[int_col], file_type=parquet, sort_order_for_reorder=[int_col@0 DESC], reverse_row_groups=true

query I
SELECT int_col FROM ordered_table ORDER BY int_col DESC;
----
9
8
7
6
5
4
3
2
1

# Test that disabling the rule keeps a SortPreservingMergeExec.
statement ok
set datafusion.optimizer.sequence_sorted_inputs = false;

query TT
EXPLAIN SELECT int_col, sec_col FROM ordered_table ORDER BY int_col;
----
logical_plan
01)Sort: ordered_table.int_col ASC NULLS LAST
02)--TableScan: ordered_table projection=[int_col, sec_col]
physical_plan
01)SortPreservingMergeExec: [int_col@0 ASC NULLS LAST]
02)--DataSourceExec: file_groups={3 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/ordered/2.parquet]]}, projection=[int_col, sec_col], output_ordering=[int_col@0 ASC NULLS LAST], file_type=parquet

# Re-enable the optimization
statement ok
set datafusion.optimizer.sequence_sorted_inputs = true;

# Create a new table where the file order is the reverse of the sort order,
# so partitions must be reordered when querying.

query I
COPY (SELECT * FROM src_nine WHERE int_col > 6 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/reversed/0.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_nine WHERE int_col > 3 AND int_col <= 6 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/reversed/1.parquet'
STORED AS PARQUET;
----
3

query I
COPY (SELECT * FROM src_nine WHERE int_col <= 3 ORDER BY int_col)
TO 'test_files/scratch/sequence_sorted_inputs/reversed/2.parquet'
STORED AS PARQUET;
----
3

statement ok
CREATE EXTERNAL TABLE reversed_table (
  int_col INT NOT NULL,
  sec_col INT NOT NULL
)
STORED AS PARQUET
WITH ORDER (int_col ASC NULLS LAST)
LOCATION 'test_files/scratch/sequence_sorted_inputs/reversed/';

# Expect a ReorderPartitionsExec to be used to rearrange the files.
query TT
EXPLAIN SELECT int_col FROM reversed_table ORDER BY int_col;
----
logical_plan
01)Sort: reversed_table.int_col ASC NULLS LAST
02)--TableScan: reversed_table projection=[int_col]
physical_plan
01)ProgressiveEvalExec: 
02)--ReorderPartitionsExec: order=[2, 1, 0]
03)----DataSourceExec: file_groups={3 groups: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/reversed/0.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/reversed/1.parquet], [WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/sequence_sorted_inputs/reversed/2.parquet]]}, projection=[int_col], output_ordering=[int_col@0 ASC NULLS LAST], file_type=parquet

query I
SELECT int_col FROM reversed_table ORDER BY int_col;
