# BUG-SUM-DESC: Unsigned SUM rises while the sliding frame fills and then falls
query I
SELECT SUM(x) OVER (ORDER BY x DESC ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS s FROM unsigned_v ORDER BY s ASC NULLS LAST;
----
3
5
5
7
9

