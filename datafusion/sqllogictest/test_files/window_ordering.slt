# BUG-27267-PARTITION: Shrinking-frame NULL placement is also wrong within partitions
query II
SELECT g, MAX(x) OVER (PARTITION BY g ORDER BY ts ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS m FROM shrinking_part ORDER BY g ASC NULLS LAST, m DESC NULLS FIRST;
----
1 NULL
1 3
2 NULL
2 7

query TT
EXPLAIN SELECT g, MAX(x) OVER (PARTITION BY g ORDER BY ts ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS m FROM shrinking_part ORDER BY g ASC NULLS LAST, m DESC NULLS FIRST;
----
physical_plan
01)SortExec: expr=[g@0 ASC NULLS LAST, m@1 DESC], preserve_partitioning=[false]
02)--ProjectionExec: expr=[g@0 as g, max(shrinking_part.x) PARTITION BY [shrinking_part.g] ORDER BY [shrinking_part.ts ASC NULLS LAST] ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING@3 as m]
03)----WindowAggExec: wdw=[max(shrinking_part.x) PARTITION BY [shrinking_part.g] ORDER BY [shrinking_part.ts ASC NULLS LAST] ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING: Ok(Field { name: "max(shrinking_part.x) PARTITION BY [shrinking_part.g] ORDER BY [shrinking_part.ts ASC NULLS LAST] ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING", data_type: Int32, nullable: true }), frame: WindowFrame { units: Rows, start_bound: CurrentRow, end_bound: Following(UInt64(NULL)), is_causal: false }]
04)------SortExec: expr=[g@0 ASC NULLS LAST, ts@1 ASC NULLS LAST], preserve_partitioning=[false]
05)--------DataSourceExec: partitions=1, partition_sizes=[1]

