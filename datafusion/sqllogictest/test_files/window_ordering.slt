# Window result ordering and physical sort elimination.
# Query records preserve returned row order. EXPLAIN records capture missing and redundant sorts.
# https://github.com/apache/datafusion/issues/27422
# https://github.com/apache/datafusion/issues/27267

statement ok
SET datafusion.execution.target_partitions = 1;

statement ok
SET datafusion.explain.format = 'indent';

statement ok
SET datafusion.explain.physical_plan_only = true;

statement ok
CREATE TABLE u(x INT NOT NULL) AS VALUES (3), (1), (5);

statement ok
CREATE TABLE v(x INT NOT NULL) AS VALUES (1), (2), (3), (4), (5);

statement ok
CREATE TABLE nullable(x INT) AS VALUES (3), (NULL), (1), (5);

statement ok
CREATE TABLE trailing(x INT) AS VALUES (1), (3), (NULL), (NULL), (NULL);

statement ok
CREATE TABLE n(x INT) AS VALUES (1), (2), (3), (NULL), (NULL);

statement ok
CREATE TABLE unsigned_v AS SELECT arrow_cast(x, 'UInt32') AS x FROM v;

statement ok
CREATE TABLE running(ts INT NOT NULL, x INT) AS VALUES (1, NULL), (2, 3), (3, 1), (4, 5);

statement ok
CREATE TABLE filtered(ts INT NOT NULL, x INT NOT NULL) AS VALUES (1, 1), (2, 3), (3, 2), (4, 5);

statement ok
CREATE TABLE shrinking(ts INT NOT NULL, x INT) AS VALUES (1, 3), (2, NULL), (3, NULL);

statement ok
CREATE TABLE shrinking_part(g INT NOT NULL, ts INT NOT NULL, x INT) AS VALUES (1, 1, 3), (1, 2, NULL), (2, 3, 7), (2, 4, NULL);

statement ok
CREATE TABLE part(g INT NOT NULL, x INT NOT NULL) AS VALUES (1, 1), (1, 2), (1, 3), (2, 4), (2, 5), (2, 6);

statement ok
CREATE TABLE same_key(x INT) AS VALUES (1), (1), (1), (2), (2), (2);

statement ok
CREATE TABLE count_part(g INT NOT NULL, ts INT NOT NULL) AS VALUES (1, 1), (1, 2), (2, 3), (2, 4);

# BUG-27422-A: Sliding MAX declares ASC for descending input
query I
SELECT MAX(x) OVER (ORDER BY x DESC ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS m FROM u ORDER BY m ASC NULLS LAST;
----
3
5
5

query TT
EXPLAIN SELECT MAX(x) OVER (ORDER BY x DESC ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS m FROM u ORDER BY m ASC NULLS LAST;
----
physical_plan
01)SortExec: expr=[m@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--ProjectionExec: expr=[max(u.x) ORDER BY [u.x DESC NULLS FIRST] ROWS BETWEEN 1 PRECEDING AND CURRENT ROW@1 as m]
03)----BoundedWindowAggExec: wdw=[max(u.x) ORDER BY [u.x DESC NULLS FIRST] ROWS BETWEEN 1 PRECEDING AND CURRENT ROW: Field { "max(u.x) ORDER BY [u.x DESC NULLS FIRST] ROWS BETWEEN 1 PRECEDING AND CURRENT ROW": nullable Int32 }, frame: ROWS BETWEEN 1 PRECEDING AND CURRENT ROW], mode=[Sorted]
04)------SortExec: expr=[x@0 DESC], preserve_partitioning=[false]
05)--------DataSourceExec: partitions=1, partition_sizes=[1]

# BUG-27422-B: Sliding MIN declares DESC for ascending input
query I
SELECT MIN(x) OVER (ORDER BY x ASC ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS m FROM u ORDER BY m DESC NULLS LAST;
----
3
1
1

query TT
