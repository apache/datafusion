03)----BoundedWindowAggExec: wdw=[count(same_key.x) PARTITION BY [same_key.x] ORDER BY [same_key.x ASC NULLS LAST] ROWS BETWEEN 2 PRECEDING AND CURRENT ROW: Field { "count(same_key.x) PARTITION BY [same_key.x] ORDER BY [same_key.x ASC NULLS LAST] ROWS BETWEEN 2 PRECEDING AND CURRENT ROW": Int64 }, frame: ROWS BETWEEN 2 PRECEDING AND CURRENT ROW], mode=[Sorted]
04)------SortExec: expr=[x@0 ASC NULLS LAST], preserve_partitioning=[false]
05)--------DataSourceExec: partitions=1, partition_sizes=[1]

# BUG-PARTITION-COUNT-STAR: COUNT(1) passes the argument-ordering check for unrelated partition and order keys
query I
