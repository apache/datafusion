# OPT-PARTITION-NF-ROW-NUMBER: ROW_NUMBER preserves ASC NULLS FIRST partition ordering
query III
SELECT g, x, ROW_NUMBER() OVER (PARTITION BY g ORDER BY x) AS r FROM nf ORDER BY g ASC NULLS FIRST, r ASC NULLS LAST;
----
NULL 1 1
NULL 2 2
1 3 1
1 4 2
2 5 1
2 6 2

query TT
EXPLAIN SELECT g, x, ROW_NUMBER() OVER (PARTITION BY g ORDER BY x) AS r FROM nf ORDER BY g ASC NULLS FIRST, r ASC NULLS LAST;
----
physical_plan
01)ProjectionExec: expr=[g@0 as g, x@1 as x, row_number() PARTITION BY [nf.g] ORDER BY [nf.x ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@2 as r]
02)--BoundedWindowAggExec: wdw=[row_number() PARTITION BY [nf.g] ORDER BY [nf.x ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "row_number() PARTITION BY [nf.g] ORDER BY [nf.x ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": UInt64 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
03)----DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/sqllogictest/test_files/scratch/window_ordering/nf.csv]]}, projection=[g, x], output_ordering=[g@0 ASC, x@1 ASC NULLS LAST], file_type=csv, has_header=false

# OPT-PARTITION-DL-SUM: Partition-constant SUM preserves DESC NULLS LAST ordering
query II
SELECT g, SUM(x) OVER (PARTITION BY g) AS s FROM dl ORDER BY g DESC NULLS LAST, s ASC NULLS LAST;
----
2 11
2 11
1 7
1 7
NULL 3
NULL 3

query TT
EXPLAIN SELECT g, SUM(x) OVER (PARTITION BY g) AS s FROM dl ORDER BY g DESC NULLS LAST, s ASC NULLS LAST;
----
physical_plan
01)ProjectionExec: expr=[g@0 as g, sum(dl.x) PARTITION BY [dl.g] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING@2 as s]
