# BUG-27267-MAX: Growing MAX declares the wrong NULL placement
query I
SELECT m FROM (SELECT ts, MAX(x) OVER (ORDER BY ts) AS m FROM (SELECT * FROM running ORDER BY ts)) ORDER BY m ASC NULLS LAST;
----
3
3
5
NULL

query TT
EXPLAIN SELECT m FROM (SELECT ts, MAX(x) OVER (ORDER BY ts) AS m FROM (SELECT * FROM running ORDER BY ts)) ORDER BY m ASC NULLS LAST;
----
physical_plan
01)SortExec: expr=[m@0 ASC NULLS LAST], preserve_partitioning=[false]
02)--ProjectionExec: expr=[max(running.x) ORDER BY [running.ts ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW@2 as m]
03)----BoundedWindowAggExec: wdw=[max(running.x) ORDER BY [running.ts ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW: Field { "max(running.x) ORDER BY [running.ts ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW": nullable Int32 }, frame: RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW], mode=[Sorted]
04)------SortExec: expr=[ts@0 ASC NULLS LAST], preserve_partitioning=[false]
05)--------DataSourceExec: partitions=1, partition_sizes=[1]

# BUG-27267-SHRINK: A shrinking frame eventually contains only NULL inputs
query I
SELECT MAX(x) OVER (ORDER BY ts ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS m FROM shrinking ORDER BY m DESC NULLS FIRST;
----
NULL
NULL
3

query TT
EXPLAIN SELECT MAX(x) OVER (ORDER BY ts ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS m FROM shrinking ORDER BY m DESC NULLS FIRST;
----
physical_plan
01)SortExec: expr=[m@0 DESC], preserve_partitioning=[false]
02)--ProjectionExec: expr=[max(shrinking.x) ORDER BY [shrinking.ts ASC NULLS LAST] ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING@2 as m]
03)----WindowAggExec: wdw=[max(shrinking.x) ORDER BY [shrinking.ts ASC NULLS LAST] ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING: Ok(Field { name: "max(shrinking.x) ORDER BY [shrinking.ts ASC NULLS LAST] ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING", data_type: Int32, nullable: true }), frame: WindowFrame { units: Rows, start_bound: CurrentRow, end_bound: Following(UInt64(NULL)), is_causal: false }]
04)------SortExec: expr=[ts@0 ASC NULLS LAST], preserve_partitioning=[false]
05)--------DataSourceExec: partitions=1, partition_sizes=[1]

# BUG-27267-FILTER: FILTER produces an empty growing aggregate over NOT NULL input
query I
SELECT MAX(x) FILTER (WHERE x > 2) OVER (ORDER BY ts) AS m FROM filtered ORDER BY m ASC NULLS LAST;
