03)----BoundedWindowAggExec: wdw=[count(Int64(1)) PARTITION BY [count_part.g] ORDER BY [count_part.ts ASC NULLS LAST] ROWS BETWEEN 1 PRECEDING AND CURRENT ROW: Field { "count(Int64(1)) PARTITION BY [count_part.g] ORDER BY [count_part.ts ASC NULLS LAST] ROWS BETWEEN 1 PRECEDING AND CURRENT ROW": Int64 }, frame: ROWS BETWEEN 1 PRECEDING AND CURRENT ROW], mode=[Sorted]
04)------SortExec: expr=[g@0 ASC NULLS LAST, ts@1 ASC NULLS LAST], preserve_partitioning=[false]
05)--------DataSourceExec: partitions=1, partition_sizes=[1]

statement ok
CREATE TABLE nullable_part(g INT, x INT NOT NULL) AS VALUES (NULL, 1), (NULL, 2), (1, 3), (1, 4), (2, 5), (2, 6);

query I
COPY (SELECT g, x FROM nullable_part ORDER BY g ASC NULLS FIRST, x ASC) TO 'test_files/scratch/window_ordering/nf.csv' STORED AS CSV OPTIONS ('format.has_header' 'false');
----
6

statement ok
CREATE EXTERNAL TABLE nf(g INT, x INT NOT NULL) STORED AS CSV WITH ORDER (g ASC NULLS FIRST, x ASC) LOCATION 'test_files/scratch/window_ordering/nf.csv' OPTIONS ('format.has_header' 'false');

query I
COPY (SELECT g, x FROM nullable_part ORDER BY g DESC NULLS LAST, x ASC) TO 'test_files/scratch/window_ordering/dl.csv' STORED AS CSV OPTIONS ('format.has_header' 'false');
----
6

statement ok
