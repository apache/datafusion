# Regression tests for logical CAST targets that carry explicit field metadata.

query ?T
SELECT
    CAST(
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
        AS UUID
    ),
    arrow_metadata(
        CAST(
            arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
            AS UUID
        ),
        'ARROW:extension:name'
    );
----
00010203040506070809000102030506 arrow.uuid

query ?T
SELECT
    CAST(raw AS UUID),
    arrow_metadata(CAST(raw AS UUID), 'ARROW:extension:name')
FROM (
    VALUES (
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
    )
) AS uuids(raw);
----
00010203040506070809000102030506 arrow.uuid

# TRY_CAST to extension type should also preserve extension metadata
query ?T
SELECT
    TRY_CAST(
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
        AS UUID
    ),
    arrow_metadata(
        TRY_CAST(
            arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
            AS UUID
        ),
        'ARROW:extension:name'
    );
----
00010203040506070809000102030506 arrow.uuid

# TRY_CAST to UUID from a subquery
query ?T
SELECT
    TRY_CAST(raw AS UUID),
    arrow_metadata(TRY_CAST(raw AS UUID), 'ARROW:extension:name')
FROM (
    VALUES (
        arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)')
    )
) AS uuids(raw);
----
00010203040506070809000102030506 arrow.uuid

# arrow_cast from UUID to same underlying type (FixedSizeBinary(16)) strips
# extension metadata (type-only cast semantics)
query ?T
SELECT
    arrow_cast(uuid_val, 'FixedSizeBinary(16)'),
    arrow_metadata(arrow_cast(uuid_val, 'FixedSizeBinary(16)'), 'ARROW:extension:name')
FROM (
    SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID) AS uuid_val
);
----
00010203040506070809000102030506 NULL

# arrow_cast to a different type strips extension metadata (type-only cast semantics)
query ?T
SELECT
    arrow_cast(uuid_val, 'Binary'),
    arrow_metadata(arrow_cast(uuid_val, 'Binary'), 'ARROW:extension:name')
FROM (
    SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID) AS uuid_val
);
----
00010203040506070809000102030506 NULL

# Extension types of Parquet columns are visible to expressions evaluated in the scan,
# also when the scan replaces a constant column with a literal from the statistics.
# skip_metadata = true clears field metadata but keeps extension types.
statement ok
COPY (
    SELECT CAST(arrow_cast(X'00010203040506070809000102030506', 'FixedSizeBinary(16)') AS UUID) AS uuid_val
)
TO 'test_files/scratch/cast_extension_type_metadata/uuid.parquet'
STORED AS PARQUET;

statement ok
SET datafusion.execution.parquet.skip_metadata = true;

statement ok
CREATE EXTERNAL TABLE uuid_parquet
STORED AS PARQUET
LOCATION 'test_files/scratch/cast_extension_type_metadata/uuid.parquet';

query ?T
SELECT uuid_val, arrow_metadata(uuid_val, 'ARROW:extension:name') FROM uuid_parquet;
----
00010203040506070809000102030506 arrow.uuid

statement ok
DROP TABLE uuid_parquet;

statement ok
RESET datafusion.execution.parquet.skip_metadata;

# Schema inference over several files with skip_metadata = true (the default) keeps the
# extension type and clears the other field metadata, even if it conflicts between files.
# A file without the extension type does not remove it.
statement ok
COPY (
    SELECT with_metadata(
        with_metadata(with_metadata(1, 'ARROW:extension:name', 'example.ext'), 'ARROW:extension:metadata', '{"width":5}'),
        'other', 'bar'
    ) AS id
)
TO 'test_files/scratch/cast_extension_type_metadata/merge/1.parquet'
STORED AS PARQUET;

statement ok
COPY (
    SELECT with_metadata(
        with_metadata(with_metadata(2, 'ARROW:extension:name', 'example.ext'), 'ARROW:extension:metadata', '{"width":5}'),
        'other', 'baz'
    ) AS id
)
TO 'test_files/scratch/cast_extension_type_metadata/merge/2.parquet'
STORED AS PARQUET;

statement ok
COPY (SELECT 3 AS id)
TO 'test_files/scratch/cast_extension_type_metadata/merge/3.parquet'
STORED AS PARQUET;

statement ok
CREATE EXTERNAL TABLE merged
STORED AS PARQUET
LOCATION 'test_files/scratch/cast_extension_type_metadata/merge/';

query I?
SELECT id, arrow_metadata(id) FROM merged ORDER BY id;
----
1 {ARROW:extension:metadata: {"width":5}, ARROW:extension:name: example.ext}
2 {ARROW:extension:metadata: {"width":5}, ARROW:extension:name: example.ext}
3 {ARROW:extension:metadata: {"width":5}, ARROW:extension:name: example.ext}

statement ok
DROP TABLE merged;
