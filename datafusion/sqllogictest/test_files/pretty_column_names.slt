# Tests for `datafusion.sql_parser.pretty_column_names`.
#
# sqllogictest doesn't print column headers, so these tests use EXPLAIN:
# a readable label shows up as an alias (`AS <label>`) in the top projection
# of the logical plan.

statement ok
set datafusion.explain.logical_plan_only = true;

statement ok
CREATE TABLE t (a BIGINT, b BIGINT, c BIGINT) AS VALUES (1, 2, 3), (4, 5, 6);

statement ok
CREATE TABLE t2 (a BIGINT, d BIGINT) AS VALUES (1, 10), (4, 40);

# The option is off by default: no labels
query TT
EXPLAIN SELECT a + 1 FROM t;
----
logical_plan
01)Projection: t.a + Int64(1)
02)--TableScan: t projection=[a]

statement ok
set datafusion.sql_parser.pretty_column_names = true;

####################
# Expressions
####################

query TT
EXPLAIN SELECT 1, 'foo';
----
logical_plan
01)Projection: Int64(1) AS 1, Utf8("foo") AS foo
02)--EmptyRelation: rows=1

query TT
EXPLAIN SELECT 1 + 2;
----
logical_plan
01)Projection: Int64(3) AS 1 + 2
02)--EmptyRelation: rows=1

query TT
EXPLAIN SELECT (a + b) * c FROM t;
----
logical_plan
01)Projection: (t.a + t.b) * t.c AS (a + b) * c
02)--TableScan: t projection=[a, b, c]

query TT
EXPLAIN SELECT t.a + 1 FROM t;
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1
02)--TableScan: t projection=[a]

query TT
EXPLAIN SELECT coalesce(NULL, 1);
----
logical_plan
01)Projection: Int64(1) AS coalesce(NULL, 1)
02)--EmptyRelation: rows=1

query TT
EXPLAIN SELECT CASE WHEN a > 0 THEN 'pos' ELSE 'neg' END FROM t;
----
logical_plan
01)Projection: CASE WHEN t.a > Int64(0) THEN Utf8("pos") ELSE Utf8("neg") END AS CASE WHEN a > 0 THEN pos ELSE neg END
02)--TableScan: t projection=[a]

# CAST is left out of labels, as it is of names
query TT
EXPLAIN SELECT CAST(a AS DOUBLE) + 1 FROM t;
----
logical_plan
01)Projection: CAST(t.a AS Float64) + Float64(1) AS a + 1
02)--TableScan: t projection=[a]

# A plain column needs no label, so the plan doesn't change
query TT
EXPLAIN SELECT * FROM t;
----
logical_plan TableScan: t projection=[a, b, c]

# Explicit aliases keep their names
query TT
EXPLAIN SELECT a + 1 AS x FROM t;
----
logical_plan
01)Projection: t.a + Int64(1) AS x
02)--TableScan: t projection=[a]

####################
# Aggregate functions
####################

query TT
EXPLAIN SELECT sum(a), count(DISTINCT b) FROM t;
----
logical_plan
01)Projection: sum(alias2) AS sum(a), count(alias1) AS count(DISTINCT b)
02)--Aggregate: groupBy=[[]], aggr=[[sum(alias2), count(alias1)]]
03)----Aggregate: groupBy=[[t.b AS alias1]], aggr=[[sum(t.a) AS alias2]]
04)------TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT avg(c) FILTER (WHERE c > 5) FROM t;
----
logical_plan
01)Projection: avg(t.c) FILTER (WHERE t.c > Int64(5)) AS avg(c) FILTER (WHERE c > 5)
02)--Aggregate: groupBy=[[]], aggr=[[avg(CAST(t.c AS Float64)) FILTER (WHERE t.c > Int64(5))]]
03)----TableScan: t projection=[c]

query TT
EXPLAIN SELECT count(*), count(1) FROM t;
----
logical_plan
01)Projection: count(Int64(1)) AS count(*), count(Int64(1)) AS count(1)
02)--Aggregate: groupBy=[[]], aggr=[[count(Int64(1))]]
03)----TableScan: t projection=[]

query TT
EXPLAIN SELECT array_agg(a ORDER BY b DESC) FROM t;
----
logical_plan
01)Projection: array_agg(t.a) ORDER BY [t.b DESC NULLS FIRST] AS array_agg(a) ORDER BY b DESC
02)--Aggregate: groupBy=[[]], aggr=[[array_agg(t.a) ORDER BY [t.b DESC NULLS FIRST]]]
03)----TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT b, sum(a) + 1 FROM t GROUP BY b;
----
logical_plan
01)Projection: t.b, sum(t.a) + Int64(1) AS sum(a) + 1
02)--Aggregate: groupBy=[[t.b]], aggr=[[sum(t.a)]]
03)----TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT a + 1, sum(b) FROM t GROUP BY a + 1;
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1, sum(t.b) AS sum(b)
02)--Aggregate: groupBy=[[t.a + Int64(1)]], aggr=[[sum(t.b)]]
03)----TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT a + 1, b, sum(c) FROM t GROUP BY CUBE (a + 1, b);
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1, t.b, sum(t.c) AS sum(c)
02)--Aggregate: groupBy=[[CUBE (t.a + Int64(1), t.b)]], aggr=[[sum(t.c)]]
03)----TableScan: t projection=[a, b, c]

####################
# Window functions
####################

query TT
EXPLAIN SELECT row_number() OVER (ORDER BY a) FROM t;
----
logical_plan
01)Projection: row_number() ORDER BY [t.a ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS row_number() OVER (ORDER BY a)
02)--WindowAggr: windowExpr=[[row_number() ORDER BY [t.a ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t projection=[a]

query TT
EXPLAIN SELECT sum(a) OVER (PARTITION BY b) FROM t;
----
logical_plan
01)Projection: sum(t.a) PARTITION BY [t.b] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING AS sum(a) OVER (PARTITION BY b)
02)--WindowAggr: windowExpr=[[sum(t.a) PARTITION BY [t.b] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING]]
03)----TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT sum(a) OVER (ORDER BY a DESC NULLS FIRST) FROM t;
----
logical_plan
01)Projection: sum(t.a) ORDER BY [t.a DESC NULLS FIRST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(a) OVER (ORDER BY a DESC)
02)--WindowAggr: windowExpr=[[sum(t.a) ORDER BY [t.a DESC NULLS FIRST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t projection=[a]

query TT
EXPLAIN SELECT sum(a) OVER (ORDER BY a ASC NULLS FIRST) FROM t;
----
logical_plan
01)Projection: sum(t.a) ORDER BY [t.a ASC NULLS FIRST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(a) OVER (ORDER BY a NULLS FIRST)
02)--WindowAggr: windowExpr=[[sum(t.a) ORDER BY [t.a ASC NULLS FIRST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t projection=[a]

query TT
EXPLAIN SELECT sum(a) OVER (ORDER BY a ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t;
----
logical_plan
01)Projection: sum(t.a) ORDER BY [t.a ASC NULLS LAST] ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(a) OVER (ORDER BY a ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
02)--WindowAggr: windowExpr=[[sum(t.a) ORDER BY [t.a ASC NULLS LAST] ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t projection=[a]

query TT
EXPLAIN SELECT sum(b) OVER (RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t;
----
logical_plan
01)Projection: sum(t.b) ORDER BY [UInt64(1) ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(b) OVER ()
02)--WindowAggr: windowExpr=[[sum(t.b) ORDER BY [UInt64(1) ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t projection=[b]

query TT
EXPLAIN SELECT count(*) OVER () FROM t;
----
logical_plan
01)Projection: count(Int64(1)) ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING AS count(*) OVER ()
02)--WindowAggr: windowExpr=[[count(Int64(1)) ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING]]
03)----TableScan: t projection=[]

query TT
EXPLAIN SELECT count(*) OVER (PARTITION BY b) AS x, count(*) OVER (PARTITION BY c) FROM t;
----
logical_plan
01)Projection: count(Int64(1)) PARTITION BY [t.b] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING AS count(*) PARTITION BY [t.b] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING AS x, count(Int64(1)) PARTITION BY [t.c] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING AS count(*) OVER (PARTITION BY c)
02)--WindowAggr: windowExpr=[[count(Int64(1)) PARTITION BY [t.c] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING]]
03)----Projection: t.c, count(Int64(1)) PARTITION BY [t.b] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
04)------WindowAggr: windowExpr=[[count(Int64(1)) PARTITION BY [t.b] ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING]]
05)--------TableScan: t projection=[b, c]

# The planner picks the default frame before aggregation, where `a` can have
# ties, so the default frame is RANGE
query TT
EXPLAIN SELECT row_number() OVER (ORDER BY a) FROM t GROUP BY a;
----
logical_plan
01)Projection: row_number() ORDER BY [t.a ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS row_number() OVER (ORDER BY a)
02)--WindowAggr: windowExpr=[[row_number() ORDER BY [t.a ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----Aggregate: groupBy=[[t.a]], aggr=[[]]
04)------TableScan: t projection=[a]

query TT
EXPLAIN SELECT sum(a) OVER w FROM t WINDOW w AS (PARTITION BY b ORDER BY c);
----
logical_plan
01)Projection: sum(t.a) PARTITION BY [t.b] ORDER BY [t.c ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(a) OVER (PARTITION BY b ORDER BY c)
02)--WindowAggr: windowExpr=[[sum(t.a) PARTITION BY [t.b] ORDER BY [t.c ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t projection=[a, b, c]

# A window function ordered by a unique key: the default frame is ROWS
statement ok
CREATE TABLE t_pk (id BIGINT PRIMARY KEY, v BIGINT) AS VALUES (1, 10), (2, 20);

query TT
EXPLAIN SELECT sum(v) OVER (ORDER BY id) FROM t_pk;
----
logical_plan
01)Projection: sum(t_pk.v) ORDER BY [t_pk.id ASC NULLS LAST] ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(v) OVER (ORDER BY id)
02)--WindowAggr: windowExpr=[[sum(t_pk.v) ORDER BY [t_pk.id ASC NULLS LAST] ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t_pk projection=[id, v]

query TT
EXPLAIN SELECT sum(v) OVER (ORDER BY id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t_pk;
----
logical_plan
01)Projection: sum(t_pk.v) ORDER BY [t_pk.id ASC NULLS LAST] ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(v) OVER (ORDER BY id)
02)--WindowAggr: windowExpr=[[sum(t_pk.v) ORDER BY [t_pk.id ASC NULLS LAST] ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t_pk projection=[id, v]

query TT
EXPLAIN SELECT sum(v) OVER (ORDER BY id RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM t_pk;
----
logical_plan
01)Projection: sum(t_pk.v) ORDER BY [t_pk.id ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW AS sum(v) OVER (ORDER BY id RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
02)--WindowAggr: windowExpr=[[sum(t_pk.v) ORDER BY [t_pk.id ASC NULLS LAST] RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW]]
03)----TableScan: t_pk projection=[id, v]

statement ok
DROP TABLE t_pk;

####################
# Columns from CTEs, derived tables, and views
####################

query TT
EXPLAIN WITH x AS (SELECT sum(a) FROM t GROUP BY b) SELECT * FROM x;
----
logical_plan
01)Projection: x.sum(t.a) AS sum(a)
02)--SubqueryAlias: x
03)----Projection: sum(t.a)
04)------Aggregate: groupBy=[[t.b]], aggr=[[sum(t.a)]]
05)--------TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT * FROM (SELECT a + 1 FROM t);
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1
02)--TableScan: t projection=[a]

statement ok
CREATE VIEW v AS SELECT a + 1 FROM t;

query TT
EXPLAIN SELECT * FROM v;
----
logical_plan
01)Projection: v.t.a + Int64(1) AS a + 1
02)--SubqueryAlias: v
03)----Projection: t.a + Int64(1)
04)------TableScan: t projection=[a]

# The view stores today's name
query TTT
DESCRIBE v;
----
t.a + Int64(1) Int64 YES

statement ok
DROP VIEW v;

query TT
EXPLAIN SELECT x FROM (SELECT a + 1 AS x FROM t);
----
logical_plan
01)Projection: t.a + Int64(1) AS x
02)--TableScan: t projection=[a]

# A column reference typed in the outermost SELECT keeps the typed name
query TT
EXPLAIN SELECT "t.a + Int64(1)" FROM (SELECT a + 1 FROM t);
----
logical_plan
01)Projection: t.a + Int64(1)
02)--TableScan: t projection=[a]

####################
# References by the current name keep working
####################

query TT
EXPLAIN SELECT a + 1 FROM t ORDER BY "t.a + Int64(1)";
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1
02)--Sort: t.a + Int64(1) ASC NULLS LAST
03)----Projection: t.a + Int64(1)
04)------TableScan: t projection=[a]

query I
SELECT a + 1 FROM t ORDER BY "t.a + Int64(1)" DESC;
----
5
2

query TT
EXPLAIN SELECT a + 1, b FROM t ORDER BY 1 DESC LIMIT 1;
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1, t.b
02)--Sort: t.a + Int64(1) DESC NULLS FIRST, fetch=1
03)----Projection: t.a + Int64(1), t.b
04)------TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT b, sum(a) FROM t GROUP BY b HAVING sum(a) > 1;
----
logical_plan
01)Projection: t.b, sum(t.a) AS sum(a)
02)--Filter: sum(t.a) > Int64(1)
03)----Aggregate: groupBy=[[t.b]], aggr=[[sum(t.a)]]
04)------TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT DISTINCT a + 1 FROM t;
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1
02)--Aggregate: groupBy=[[t.a + Int64(1)]], aggr=[[]]
03)----Projection: t.a + Int64(1)
04)------TableScan: t projection=[a]

query TT
EXPLAIN SELECT DISTINCT ON (b) a + 1 FROM t ORDER BY b;
----
logical_plan
01)Projection: first_value(t.a + Int64(1)) ORDER BY [t.b ASC NULLS LAST] AS t.a + Int64(1)
02)--Sort: t.b ASC NULLS LAST
03)----Aggregate: groupBy=[[t.b]], aggr=[[first_value(t.a + Int64(1)) ORDER BY [t.b ASC NULLS LAST]]]
04)------TableScan: t projection=[a, b]

query TT
EXPLAIN SELECT unnest([1, 2]);
----
logical_plan
01)Projection: __unnest_placeholder(make_array(Int64(1),Int64(2)),depth=1) AS UNNEST(make_array(Int64(1),Int64(2)))
02)--Unnest: lists[__unnest_placeholder(make_array(Int64(1),Int64(2)))|depth=1] structs[]
03)----Projection: List([1, 2]) AS __unnest_placeholder(make_array(Int64(1),Int64(2)))
04)------EmptyRelation: rows=1

query TT
EXPLAIN SELECT * FROM t JOIN t2 USING (a);
----
logical_plan
01)Projection: t.a, t.b, t.c, t2.d
02)--Inner Join: t.a = t2.a
03)----TableScan: t projection=[a, b, c]
04)----TableScan: t2 projection=[a, d]

query TT
EXPLAIN SELECT t.a + 1, t2.d * 2 FROM t JOIN t2 ON t.a = t2.a;
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1, t2.d * Int64(2) AS d * 2
02)--Inner Join: t.a = t2.a
03)----TableScan: t projection=[a]
04)----TableScan: t2 projection=[a, d]

query TT
EXPLAIN SELECT a + 1 FROM t UNION ALL SELECT a + 2 FROM t;
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1
02)--Union
03)----Projection: t.a + Int64(1) AS t.a + Int64(1)
04)------TableScan: t projection=[a]
05)----Projection: t.a + Int64(2) AS t.a + Int64(1)
06)------TableScan: t projection=[a]

query TT
EXPLAIN WITH RECURSIVE r(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM r WHERE n < 3) SELECT n * 2 FROM r;
----
logical_plan
01)Projection: r.n * Int64(2)
02)--SubqueryAlias: r
03)----RecursiveQuery: is_distinct=false
04)------Projection: Int64(1) AS n
05)--------EmptyRelation: rows=1
06)------Projection: r.n + Int64(1)
07)--------Filter: r.n < Int64(3)
08)----------TableScan: r projection=[n]

query TT
EXPLAIN SELECT a + 1 FROM t WHERE a IN (SELECT a FROM t2);
----
logical_plan
01)Projection: t.a + Int64(1) AS a + 1
02)--LeftSemi Join: t.a = __correlated_sq_1.a
03)----TableScan: t projection=[a]
04)----SubqueryAlias: __correlated_sq_1
05)------TableScan: t2 projection=[a]

query TT
EXPLAIN SELECT (SELECT max(d) FROM t2) + 1;
----
logical_plan
01)Projection: (<subquery>) + Int64(1)
02)--Subquery:
03)----Aggregate: groupBy=[[]], aggr=[[max(t2.d)]]
04)------TableScan: t2 projection=[d]
05)--EmptyRelation: rows=1

####################
# Collisions keep the current names
####################

query TT
EXPLAIN SELECT t.a + 1, t2.a + 1 FROM t JOIN t2 ON t.a = t2.a;
----
logical_plan
01)Projection: t.a + Int64(1), t2.a + Int64(1)
02)--Inner Join: t.a = t2.a
03)----TableScan: t projection=[a]
04)----TableScan: t2 projection=[a]

query TT
EXPLAIN SELECT 1, '1';
----
logical_plan
01)Projection: Int64(1), Utf8("1")
02)--EmptyRelation: rows=1

# The label `a + 1` collides with the explicit alias `a + 1`
query TT
EXPLAIN SELECT a + 1, b AS "a + 1" FROM t;
----
logical_plan
01)Projection: t.a + Int64(1), t.b AS a + 1
02)--TableScan: t projection=[a, b]

####################
# Statements that store column names are not affected
####################

statement ok
CREATE TABLE ctas AS SELECT a + 1 FROM t;

query TTT
DESCRIBE ctas;
----
t.a + Int64(1) Int64 YES

statement ok
DROP TABLE ctas;

query TTT
DESCRIBE SELECT a + 1 FROM t;
----
t.a + Int64(1) Int64 YES

####################
# Results are unchanged
####################

query IIII
SELECT a + 1, sum(b), row_number() OVER (ORDER BY a), count(*) FROM t GROUP BY a ORDER BY a;
----
2 2 1 1
5 5 2 1

statement ok
set datafusion.sql_parser.pretty_column_names = false;

statement ok
set datafusion.explain.logical_plan_only = false;

statement ok
DROP TABLE t;

statement ok
DROP TABLE t2;
