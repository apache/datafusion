# Regression test for #26497
# Ensure DISTINCT is rejected for functions marked DistinctHandling::Unsupported

statement ok
CREATE TABLE t_distinct_bug(x DOUBLE) AS VALUES (1.0), (1.0), (1.0), (2.0), (3.0);

query error DataFusion error: This feature is not implemented: nth_value does not support DISTINCT
SELECT nth_value(DISTINCT x, 2 ORDER BY x) FROM t_distinct_bug;

query error DataFusion error: This feature is not implemented: approx_percentile_cont does not support DISTINCT
SELECT approx_percentile_cont(DISTINCT x, 0.5) FROM t_distinct_bug;

query error DataFusion error: This feature is not implemented: approx_percentile_cont does not support DISTINCT
SELECT approx_percentile_cont(DISTINCT 0.5) WITHIN GROUP (ORDER BY x) FROM t_distinct_bug;

# Ensure that a supported DISTINCT still works perfectly (Sensitive handling)
query I
SELECT count(DISTINCT x) FROM t_distinct_bug;
----
3