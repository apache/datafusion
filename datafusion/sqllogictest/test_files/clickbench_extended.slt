query I
SELECT MAX(len) FROM (
    SELECT LENGTH(FIRST_VALUE("URL" ORDER BY "EventTime")) as len
    FROM hits
    GROUP BY "UserID"
);
----
72

query I
SELECT MAX(len) FROM (
    SELECT LENGTH(FIRST_VALUE("URL" ORDER BY "EventTime")) as len
    FROM hits
    GROUP BY "OS"
);
----
57

query I
SELECT MAX(fv) FROM (
    SELECT FIRST_VALUE("WatchID" ORDER BY "EventTime") as fv
    FROM hits
    GROUP BY "UserID"
);
----
9110818468285196899

query I
SELECT MAX(fv) FROM (
    SELECT FIRST_VALUE("WatchID" ORDER BY "EventTime") as fv
    FROM hits
    GROUP BY "OS"
);
----
9110818468285196899

query I
SELECT SUM("CounterID") AS counter_id_sum
FROM hits
WHERE "URL" < 'zzzz';
