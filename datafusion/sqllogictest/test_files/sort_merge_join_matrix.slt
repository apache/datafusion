right_anti 9
right_semi 2
right_semi 3

# Residual >=: compare all four preserved-side/polarity choices.
query TI rowsort
SELECT 'left_semi', l.id FROM smj_cmp_l l LEFT SEMI JOIN smj_cmp_r r
ON l.k = r.k AND l.v >= r.v
UNION ALL
SELECT 'left_anti', l.id FROM smj_cmp_l l LEFT ANTI JOIN smj_cmp_r r
ON l.k = r.k AND l.v >= r.v
UNION ALL
SELECT 'right_semi', r.id FROM smj_cmp_l l RIGHT SEMI JOIN smj_cmp_r r
ON l.k = r.k AND l.v >= r.v
UNION ALL
SELECT 'right_anti', r.id FROM smj_cmp_l l RIGHT ANTI JOIN smj_cmp_r r
ON l.k = r.k AND l.v >= r.v;
